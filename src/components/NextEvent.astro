---
// 下一場交流會（2026-10-25 網誌化改版）：首頁 hero 下方用 card、前輩文章頁底部用 mini。
// 沒有下一場時改成導向 Instagram（同首頁公告列的規則 10）。
import { Image } from 'astro:assets';
import characters from '../assets/tsunagu-characters.png';
import { nextEvent, fmtEventNo, fmtEventDateFull, CITY } from '../lib/site';
import { href, ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang; variant?: 'card' | 'mini'; }
const { lang, variant = 'card' } = Astro.props;
const e = nextEvent();
const t = ui[lang];
const ja = lang === 'ja';
const city = e ? (CITY[lang][e.city] ?? e.city) : '';
const [, mm, dd] = e ? e.date.split('-') : [];
const IG = 'https://www.instagram.com/tw.tsunagu.jp/';
---
{variant === 'card' ? (
  <section class="nx" aria-labelledby="nx-title">
    {e ? <>
      <p class="nx-k"><span>{ja ? '次回の交流会' : '下一場交流會'}</span><b class="nx-d">{mm}.{dd}</b></p>
      <div class="nx-body">
        <h2 class="nx-t" id="nx-title">{ja ? `第 ${fmtEventNo(e.no, lang)} 回 交流会・${city}` : `第 ${fmtEventNo(e.no, lang)} 回 交流會・${city}`}</h2>
        <p class="nx-s">
          <span class="nowrap">{fmtEventDateFull(e.date, lang)}</span>
          {e.sessions && <span class="nx-ss">{e.sessions.map((s, i) => <span class="nowrap">{['①', '②', '③'][i]} {s}</span>)}</span>}
          <span>{e.venue && <>{e.venue}・</>}<span class="nowrap">{ja ? '参加無料' : '免費參加'}</span></span>
        </p>
      </div>
      <div class="nx-act">
        {e.signupUrl
          ? <a class="btn btn-primary" href={e.signupUrl} target="_blank" rel="noopener">{ja ? '申し込む（Google フォーム）' : '報名（Google 表單）'} <span aria-hidden="true">↗</span><span class="sr-only">{t.newWindow}</span></a>
          : <a class="btn btn-primary" href={href(lang, '/events')}>{t.signup}</a>}
        <a class="nx-cal small" href={href(lang, '/events') + '#signup'}>{ja ? '会場・カレンダー登録' : '地點與加入行事曆'}</a>
      </div>
    </> : <>
      <p class="nx-k"><span>{ja ? '次回の交流会' : '下一場交流會'}</span></p>
      <div class="nx-body">
        <h2 class="nx-t" id="nx-title">{ja ? '日程は Instagram でお知らせします' : '下一場的日期會在 Instagram 公布'}</h2>
        <p class="nx-s">{ja ? '開催の 2〜4 週間前に告知しています。' : '通常在活動前 2〜4 週公布。'}</p>
      </div>
      <div class="nx-act"><a class="btn btn-secondary" href={IG} target="_blank" rel="noopener">{ja ? 'Instagram をフォロー' : '追蹤 Instagram'} <span aria-hidden="true">↗</span><span class="sr-only">{t.newWindow}</span></a></div>
    </>}
  </section>
) : (
  <aside class="nx-mini" aria-label={ja ? '交流会のご案内' : '交流會報名'}>
    <Image src={characters} alt="" aria-hidden="true" widths={[120, 240]} sizes="120px" loading="lazy" class="nx-chars" />
    <div>
      <p class="nx-mt">{ja ? '日本で働いてみたいと思ったら' : '也想在日本工作？'}</p>
      <!-- 一句一行（.sent）：原本兩句連成一段，手機會從「參加」中間斷開 -->
      <p class="nx-ms">{e
        ? (ja ? <><span class="sent">次回の交流会：{fmtEventDateFull(e.date, lang)}・{city}。</span><span class="sent">参加無料で、先輩も登壇します。</span></>
              : <><span class="sent">下一場交流會：{fmtEventDateFull(e.date, lang)}・{city}。</span><span class="sent">免費參加，前輩也會到場分享。</span></>)
        : <span class="sent">{ja ? '次回の日程は Instagram でお知らせします。' : '下一場的日期會在 Instagram 公布。'}</span>}</p>
      <a class="btn btn-primary" href={href(lang, '/events')}>{t.signup}</a>
    </div>
  </aside>
)}

<style>
  /* 報名資訊卡：白底＋細線（規則：大型 CTA 盒白底），不用實心粉藍 */
  .nx{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:6px 28px;align-items:center;
    border:1px solid var(--line);border-radius:var(--r-md);padding:22px 26px;background:var(--paper);box-shadow:var(--sh-1)}
  .nx-k{margin:0;grid-row:1 / 3;display:flex;flex-direction:column;font-size:var(--fs-xs);font-weight:700;color:var(--ink-600);line-height:1.4}
  .nx-d{font-family:var(--f-latin);font-size:var(--fs-stat);line-height:1;color:var(--ink-900);letter-spacing:.02em;margin-top:4px}
  .nx-body{min-width:0}
  .nx-t{font-family:var(--f-display);font-size:var(--fs-3xl);font-weight:700;letter-spacing:.05em;line-height:1.5;margin:0}
  .nx-s{margin:4px 0 0;font-size:var(--fs-sm);color:var(--ink-600);display:flex;flex-wrap:wrap;gap:2px 14px}
  .nx-act{grid-row:1 / 3;grid-column:3;display:flex;flex-direction:column;align-items:flex-end;gap:6px}
  .nx-ss{display:inline-flex;flex-wrap:wrap;gap:0 12px}
  .nx-cal{color:var(--ink-900);display:inline-flex;align-items:center;min-height:var(--control-min);margin:-10px 0}   /* 觸控高度 44px，負邊距讓版面不變 */
  @media (max-width:720px){
    .nx{display:flex;flex-direction:column;align-items:stretch;gap:6px;padding:16px}
    .nx-k{flex-direction:row;align-items:baseline;gap:10px}
    .nx-d{font-size:28px;margin:0}   /* 手機標題階（規則：clamp 與手機標題階不入字級階梯） */
    .nx-t{font-size:var(--fs-xl)}
    .nx-s{flex-direction:column;gap:0}   /* 手機固定三行：日期／場次／地點與免費（原本擠成一團） */
    .nx-act{order:9;align-items:stretch;margin-top:10px}
    .nx-act .btn{width:100%}
    .nx-cal{align-self:flex-start}
  }
  /* 文章頁底部的小報名區 */
  .nx-mini{display:flex;gap:22px;align-items:center;border:1px solid var(--line);border-radius:var(--r-md);padding:22px 24px;background:var(--paper)}
  .nx-chars{width:120px;height:auto;flex:0 0 auto}
  .nx-mt{font-family:var(--f-display);font-weight:700;font-size:var(--fs-2xl);letter-spacing:.05em;margin:0 0 4px}
  .nx-ms{margin:0 0 12px;font-size:var(--fs-md);color:var(--ink-600)}
  @media (max-width:720px){
    .nx-mini{flex-direction:column;text-align:center;padding:18px 16px}
    .nx-mini .btn{width:100%}
  }
</style>
