---
// 首頁統計磁磚的圖標：主色細線條（同品類圖標／logo 語言）
interface Props { k: string; size?: number }
const { k, size = 28 } = Astro.props;
const col = (k === 'job' || k === 'brand') ? 'var(--sky-300)' : 'var(--pink-300)';
---
<svg width={size} height={size} viewBox="0 0 28 28" fill="none" aria-hidden="true"
  stroke={col} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {k === 'people' && <>
    <circle cx="10" cy="10" r="4"/><path d="M3 23c0-4 3-7 7-7s7 3 7 7"/>
    <circle cx="19.5" cy="11" r="3"/><path d="M19 17c3.5 0 6 2.5 6 6"/>
  </>}
  {k === 'job' && <>
    <rect x="3" y="9" width="22" height="14" rx="2.5"/><path d="M10 9V6.5A1.5 1.5 0 0 1 11.5 5h5A1.5 1.5 0 0 1 18 6.5V9M3 15h22"/>
  </>}
  {k === 'event' && <>
    <rect x="3.5" y="5.5" width="21" height="18" rx="2.5"/><path d="M3.5 11h21M9 3.5v4M19 3.5v4"/>
    <path d="M9 16h3M16 16h3M9 20h3"/>
  </>}
  {k === 'brand' && <>
    <path d="M4 11l2-6h16l2 6"/><path d="M4 11c0 2 1.5 3 3 3s3-1 3-3c0 2 1.5 3 3 3s3-1 3-3c0 2 1.5 3 3 3s3-1 3-3"/>
    <path d="M6 14v9h16v-9M12 23v-6h4v6"/>
  </>}
</svg>
