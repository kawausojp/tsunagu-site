---
import { Image } from 'astro:assets';
import Heart from './Heart.astro';
// header 用深色版字標：原色版（粉 #F7C6DB／藍 #ADC3D7）在淺色 header 上只有 1.44／1.75:1
import wordmark from '../assets/tsunagu-wordmark-duo.png';
import { ui, href, switchHref, LANG_META, type Lang } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'zh' } = Astro.props;
const t = ui[lang];
const nav = t.nav.map(n => ({ href: href(lang, n.path), label: n.label, short: n.short }));
const path = Astro.url.pathname;
const eventsHref = href(lang, '/events');
const isCurrent = (h: string) => path === h || path.startsWith(`${h}/`);
const langs = (['zh', 'ja', 'en'] as Lang[]).map(l => ({
  code: l, label: LANG_META[l].label, current: l === lang,
  href: switchHref(lang, l, path),
}));
---
<header>
  <div class="wrap bar">
    <a class="logo" href={href(lang, '/')} aria-label={t.home}>
      <Heart size={22} />
      <Image src={wordmark} alt="TSUNAGU" widths={[110, 220, 330]} sizes="110px" class="wordmark"
        loading="eager" fetchpriority="high" decoding="sync" />
      <span class="zh" lang="ja">台湾人と日本企業をツナグ</span>
    </a>
    <nav class="desktop-nav" aria-label={t.mainMenu}>
      {nav.map(n => (
        <a href={n.href} class:list={['navlink', { on: isCurrent(n.href) }]}
          aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <details class="lang" data-lang-menu>
      <summary aria-label={t.langMenu}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/>
        </svg>
        <span class="lang-full">{LANG_META[lang].label}</span><span class="lang-short" aria-hidden="true">{LANG_META[lang].short}</span>
      </summary>
      <ul>
        {langs.map(l => (
          <li><a href={l.href} lang={LANG_META[l.code].htmlLang}
            aria-current={l.current ? 'true' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </details>
    <a class="btn btn-primary cta" href={eventsHref}
      aria-current={isCurrent(eventsHref) ? 'page' : undefined}>{t.signup}</a>
    <a class="btn btn-primary mobile-cta" href={eventsHref} aria-label={t.signup}
      aria-current={isCurrent(eventsHref) ? 'page' : undefined}>{t.signupShort}</a>
    <button class="burger" type="button" aria-label={t.openMenu} aria-expanded="false"
      aria-controls="mobile-menu" data-burger data-label-open={t.openMenu} data-label-close={t.closeMenu}>
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav class="mobile-tabs" aria-label={t.quickNav} data-tabs>
    {nav.map(n => (
      <a href={n.href} class:list={{ on: isCurrent(n.href) }}
        aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.short}</a>
    ))}
    <a class:list={['signup-tab', { on: isCurrent(eventsHref) }]} href={eventsHref} aria-label={t.signup}
      aria-current={isCurrent(eventsHref) ? 'page' : undefined}>{t.signupShort}</a>
  </nav>
  <div class="drawer" id="mobile-menu" role="navigation" aria-label={t.mobileMenu} data-drawer hidden>
    {nav.map(n => (
      <a href={n.href} class:list={{ on: isCurrent(n.href) }}
        aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
    ))}
  </div>
</header>

<style>
  header{position:sticky;top:0;z-index:50;background:rgba(255,250,248,.92);
    backdrop-filter:saturate(1.4) blur(10px);border-bottom:1px solid var(--line)}
  .bar{display:flex;align-items:center;gap:20px;height:68px}
  .logo :global(svg){flex:0 0 22px}
  .logo{display:flex;align-items:center;gap:10px;min-height:var(--control-min);text-decoration:none;
    color:var(--ink-900);flex:0 1 auto;min-width:0}
  .wordmark{width:clamp(88px,28vw,110px);height:auto;display:block}
  .zh{font-size:12px;color:var(--ink-600);border-left:1px solid var(--line);padding-left:10px}
  .desktop-nav{display:flex;gap:6px;margin-left:auto}
  .navlink{display:inline-flex;align-items:center;min-height:var(--control-min);font-size:14.5px;
    font-weight:500;color:var(--ink-600);text-decoration:none;padding:8px 12px;
    transition:.2s var(--ease);white-space:nowrap}
  .navlink:hover{color:var(--ink-900);box-shadow:inset 0 -2px 0 var(--pink-200)}
  .navlink.on{color:var(--pink-700);font-weight:700;box-shadow:inset 0 -2px 0 var(--pink-700)}
  .cta{min-height:var(--control-min);padding:10px 20px;font-size:14px;white-space:nowrap}
  .mobile-cta{display:none;min-height:var(--control-min);padding:9px 15px;font-size:13.5px;
    white-space:nowrap;margin-left:auto}
  .mobile-tabs{display:none}
  .burger{display:none;width:var(--control-min);height:var(--control-min);flex:0 0 var(--control-min);
    background:none;border:0;border-radius:var(--r-xs);padding:11px;cursor:pointer;transition:.2s var(--ease)}
  .burger:hover{background:var(--pink-50)}
  .burger span{display:block;width:22px;height:2px;background:var(--ink-900);border-radius:2px}
  .burger span+span{margin-top:5px}
  .drawer{display:none;flex-direction:column;gap:4px;max-height:calc(100dvh - 68px);overflow-y:auto;
    overscroll-behavior:contain;padding:12px var(--layout-gutter) 20px;border-top:1px solid var(--line);background:var(--cream)}
  .drawer a{display:flex;align-items:center;min-height:var(--control-min);padding:10px 0;
    text-decoration:none;color:var(--ink-900);font-weight:500;border-bottom:1px solid var(--line)}
  .drawer a.on{color:var(--pink-700);font-weight:700}
  :global(body.menu-open){overflow:hidden}
  @media (max-width:1080px){
    .bar{gap:8px}
    .zh{display:none} .desktop-nav{display:none} .cta{display:none}
    .mobile-cta{display:inline-flex}
    .burger{display:block}
    .drawer[data-open]{display:flex}
  }
  @media (max-width:720px){
    header{background:#fff;backdrop-filter:none;border-bottom-color:var(--mobile-line)}
    /* logo 置中、語言鈕絕對定位靠右：兩者脫開，窄機不再互擠 */
    .bar{display:flex;justify-content:center;height:56px;gap:0;padding:0 16px;position:relative}
    .logo{justify-content:center;gap:7px;max-width:calc(100% - 140px)}
    .wordmark{width:clamp(88px,26vw,112px)}
    .mobile-cta{display:none}
    .burger{display:none}
    /* 往下讀時分頁列滑走（頁首 100px→56px），往上捲立刻回來。一觸即達與閱讀空間兼顧 */
    .bar{z-index:2}
    .mobile-tabs{display:flex;align-items:center;justify-content:safe center;gap:2px;width:100%;
      min-height:44px;margin:0 auto;padding:0 8px;overflow-x:auto;scrollbar-width:none;
      background:var(--paper);
      transition:transform .24s var(--ease),opacity .18s linear,margin-bottom .24s var(--ease)}
    header[data-tabs-hidden] .mobile-tabs{transform:translateY(-100%);opacity:0;
      pointer-events:none;margin-bottom:-44px}
    /* 分頁列邊緣漸淡：暗示還能左右捲 */
    .mobile-tabs{mask-image:linear-gradient(90deg,transparent,#000 12px,#000 calc(100% - 12px),transparent)}
    .mobile-tabs::-webkit-scrollbar{display:none}
    .mobile-tabs a{display:inline-flex;align-items:center;justify-content:center;min-height:44px;
      padding:5px 4px;color:var(--ink-600);font-size:12px;font-weight:500;
      line-height:1.2;text-decoration:none;white-space:nowrap}
    /* 目前頁面＝粗體藍字（--sky-700，品牌藍的可讀版），不用底色框（2026-08-27 使用者定案） */
    .mobile-tabs a.on{color:var(--sky-700);font-weight:700}
    .mobile-tabs a.signup-tab{min-width:44px;color:var(--pink-700);font-weight:700}
    .mobile-tabs a.signup-tab.on{color:var(--sky-700)}
    .drawer,.drawer[data-open]{display:none!important}
  }
  .lang{position:relative}
  .lang summary{display:inline-flex;align-items:center;gap:6px;list-style:none;cursor:pointer;
    min-height:var(--control-min);font-size:13px;font-weight:500;color:var(--ink-600);
    padding:7px 10px;border-radius:var(--r-xs);
    border:1px solid var(--line);transition:.2s var(--ease)}
  .lang summary::-webkit-details-marker{display:none}
  .lang summary:hover{color:var(--ink-900);border-color:var(--ink-400)}
  .lang[open] summary{color:var(--ink-900);border-color:var(--ink-400)}
  .lang ul{position:absolute;right:0;top:calc(100% + 6px);margin:0;padding:6px;list-style:none;
    background:var(--paper);border:1px solid var(--line);border-radius:var(--r-sm);
    box-shadow:var(--sh-2);min-width:128px;z-index:60}
  .lang li a{display:flex;align-items:center;min-height:40px;padding:8px 12px;
    border-radius:var(--r-xs);text-decoration:none;font-size:13.5px;color:var(--ink-900)}
  .lang li a:hover{background:var(--greige-50)}
  .lang li a[aria-current="true"]{color:var(--pink-700);font-weight:700}
  .lang-short{display:none}
  @media (max-width:720px){
    .lang{position:absolute;right:16px;top:50%;transform:translateY(-50%)}
    .lang summary{padding:6px 8px;font-size:12px}
    .lang-full{display:none}
    .lang-short{display:inline}
  }
</style>

<script>
  const b = document.querySelector<HTMLButtonElement>('[data-burger]');
  const d = document.querySelector<HTMLElement>('[data-drawer]');
  const mobile = window.matchMedia('(max-width: 1080px)');
  const compact = window.matchMedia('(max-width: 720px)');

  // 手機版：往下讀時收起分頁列釋放畫面，往上捲或接近頁首時放回來
  const headerEl = document.querySelector('header');
  const tabsEl = document.querySelector('[data-tabs]');
  if (headerEl && tabsEl) {
    const SHOW_ABOVE = 140;   // 這個捲動位置以上一律顯示
    const STEP = 8;           // 忽略微小抖動
    let last = window.scrollY;
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = Math.max(0, window.scrollY);
      const delta = y - last;
      if (Math.abs(delta) < STEP) return;
      last = y;
      if (!compact.matches) { headerEl.removeAttribute('data-tabs-hidden'); return; }
      if (y < SHOW_ABOVE || delta < 0) headerEl.removeAttribute('data-tabs-hidden');
      else headerEl.setAttribute('data-tabs-hidden', '');
    };
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }, { passive: true });
    // 鍵盤使用者 tab 到分頁列時，確保它是可見的
    tabsEl.addEventListener('focusin', () => headerEl.removeAttribute('data-tabs-hidden'));
    compact.addEventListener('change', () => headerEl.removeAttribute('data-tabs-hidden'));
  }

  // 語言選單：點選單外或 Esc 收合（details 原生不會自己關）
  const lang = document.querySelector<HTMLDetailsElement>('[data-lang-menu]');
  if (lang) {
    document.addEventListener('click', event => {
      if (lang.open && event.target instanceof Node && !lang.contains(event.target)) lang.open = false;
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && lang.open) {
        lang.open = false;
        lang.querySelector('summary')?.focus();
      }
    });
  }

  if (b && d) {
    const setOpen = (open: boolean, restoreFocus = false) => {
      d.toggleAttribute('data-open', open);
      d.hidden = !open;
      b.setAttribute('aria-expanded', String(open));
      b.setAttribute('aria-label', (open ? b.dataset.labelClose : b.dataset.labelOpen) ?? '');
      document.body.classList.toggle('menu-open', open);
      if (!open && restoreFocus) b.focus();
    };

    b.addEventListener('click', () => setOpen(!d.hasAttribute('data-open')));
    d.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('click', event => {
      if (!d.hasAttribute('data-open')) return;
      if (event.target instanceof Node && !d.contains(event.target) && !b.contains(event.target)) setOpen(false);
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && d.hasAttribute('data-open')) setOpen(false, true);
    });
    mobile.addEventListener('change', event => {
      if (!event.matches) setOpen(false);
    });
    compact.addEventListener('change', event => {
      if (event.matches) setOpen(false);
    });
  }
</script>
