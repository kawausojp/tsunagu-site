---
import { Image } from 'astro:assets';
import Heart from './Heart.astro';
// 字標：主色版（TSU #F3A0AA／NAGU #7DD0F5），header 與 footer 共用
import wordmark from '../assets/tsunagu-wordmark.png';
import { ui, href, switchHref, LANG_META, type Lang } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'zh' } = Astro.props;
const t = ui[lang];
const nav = t.nav.map(n => ({ href: href(lang, n.path), label: n.label, short: n.short }));
const path = Astro.url.pathname;
const eventsHref = href(lang, '/events');
// 導覽 href 無結尾斜線、pathname 有，比較前先正規化
const norm = (u: string) => (u.length > 1 ? u.replace(/\/$/, '') : u);
const isCurrent = (h: string) => norm(path) === norm(h) || path.startsWith(`${h}/`);
// 在區段內但不是該頁本身時用 'true'（'page' 只給真正的當前頁）
const currentVal = (h: string) => (norm(path) === norm(h) ? 'page' : 'true');
const langs = (['zh', 'ja', 'en'] as Lang[]).map(l => ({
  code: l, label: LANG_META[l].label, current: l === lang,
  href: switchHref(lang, l, path),
}));
---
<header>
  <div class="wrap bar">
    <a class="logo" href={href(lang, '/')} aria-label={t.home}>
      <Heart size={22} />
      <Image src={wordmark} alt="TSUNAGU" widths={[110, 220, 330]} sizes="110px" class="wordmark"
        loading="eager" fetchpriority="high" decoding="sync" />
      {lang === 'zh' && <span class="zh" lang="ja">台湾人と日本企業をツナグ</span>}
    </a>
    <!-- 2026-09-13 使用者定案：頁首太滿，改漢堡選單（放在語言鈕右邊），桌機手機統一。
         推翻 8/28「不做漢堡」的決定；手機分頁列一併移除，報名鈕移進抽屜 -->
    <a class="btn btn-primary cta" href={eventsHref}
      aria-current={isCurrent(eventsHref) ? 'page' : undefined}>{t.signup}</a>
    <details class="lang" data-lang-menu>
      <summary aria-label={t.langMenu}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/>
        </svg>
        <span class="lang-full">{LANG_META[lang].label}</span><span class="lang-short" aria-hidden="true">{LANG_META[lang].short}</span>
      </summary>
      <ul>
        {langs.map(l => (
          <li><a href={l.href} lang={LANG_META[l.code].htmlLang}
            aria-current={l.current ? 'true' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </details>
    <button class="burger" type="button" aria-label={t.openMenu} aria-expanded="false"
      aria-controls="site-menu" data-burger data-label-open={t.openMenu} data-label-close={t.closeMenu}>
      <span></span><span></span>
    </button>
  </div>
  <nav class="drawer" id="site-menu" aria-label={t.mainMenu} data-drawer hidden>
    {nav.map(n => (
      <a href={n.href} class:list={{ on: isCurrent(n.href) }}
        aria-current={isCurrent(n.href) ? currentVal(n.href) : undefined}>{n.label}</a>
    ))}
    <a class="btn btn-primary drawer-cta" href={eventsHref}
      aria-current={isCurrent(eventsHref) ? 'page' : undefined}>{t.signup}</a>
  </nav>
</header>

<style>
  header{position:sticky;top:0;z-index:50;background:var(--header-bg);
    backdrop-filter:saturate(1.4) blur(10px);border-bottom:1px solid var(--line)}
  .bar{display:flex;align-items:center;gap:12px;height:68px}
  .logo :global(svg){flex:0 0 22px}
  .logo{display:flex;align-items:center;gap:10px;min-height:var(--control-min);text-decoration:none;
    color:var(--ink-900);flex:0 1 auto;min-width:0;margin-right:auto}
  .wordmark{width:clamp(88px,28vw,110px);height:auto;display:block}
  .zh{font-size:var(--fs-2xs);color:var(--ink-600);border-left:1px solid var(--line);padding-left:10px;
    white-space:nowrap;min-width:0;overflow:hidden;text-overflow:ellipsis}
  .cta{min-height:var(--control-min);padding:10px 20px;font-size:var(--fs-sm);white-space:nowrap}
  /* 900px 以下收掉標語：logo＋報名鈕＋語言＋選單鈕已無餘裕 */
  @media (max-width:900px){ .zh{display:none} }

  /* 選單鈕：粉藍兩條圓頭短線（logo 屋頂的左粉右藍），開啟時交叉成 X。不用三條灰線 */
  .burger{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:6px;
    width:var(--control-min);height:var(--control-min);flex:0 0 var(--control-min);
    background:none;border:1px solid var(--line);border-radius:var(--r-xs);padding:0;cursor:pointer;
    transition:border-color .2s var(--ease)}
  .burger:hover,.burger[aria-expanded="true"]{border-color:var(--ink-400)}
  .burger span{display:block;width:20px;height:3px;border-radius:3px;
    transition:transform .26s var(--ease)}
  .burger span:nth-child(1){background:var(--pink-300)}
  .burger span:nth-child(2){background:var(--sky-300);width:14px;align-self:flex-end;margin-right:12px}
  .burger[aria-expanded="true"] span{width:20px;margin:0;align-self:center}
  .burger[aria-expanded="true"] span:nth-child(1){transform:translateY(4.5px) rotate(45deg)}
  .burger[aria-expanded="true"] span:nth-child(2){transform:translateY(-4.5px) rotate(-45deg)}

  /* 抽屜：桌機是漢堡下方的右對齊面板；手機全寬 */
  .drawer{display:none;flex-direction:column;gap:2px;position:absolute;right:var(--layout-gutter);
    top:calc(100% + 8px);width:300px;padding:10px;background:var(--paper);
    border:1px solid var(--line);border-radius:var(--r-md);box-shadow:var(--sh-2);z-index:60}
  .drawer[data-open]{display:flex}
  .drawer a:not(.btn){display:flex;align-items:center;min-height:var(--control-min);padding:10px 12px;
    border-radius:var(--r-xs);text-decoration:none;color:var(--ink-900);font-weight:500;font-size:var(--fs-md)}
  .drawer a:not(.btn):hover{background:var(--greige-50)}
  .drawer a.on{font-weight:700;box-shadow:inset 3px 0 0 var(--pink-300)}
  .drawer-cta{display:none;margin:8px 0 2px;justify-content:center}

  @media (max-width:720px){
    header{background:var(--paper);backdrop-filter:none;border-bottom-color:var(--mobile-line)}
    .bar{height:56px;gap:8px;padding:0 16px}
    .wordmark{width:clamp(88px,26vw,112px)}
    .cta{display:none}                      /* 手機頁首只留 logo／語言／漢堡；報名鈕在抽屜與 hero */
    .drawer{position:static;width:auto;border:0;border-top:1px solid var(--mobile-line);border-radius:0;
      box-shadow:none;padding:8px var(--layout-gutter) 18px;max-height:calc(100dvh - 56px);overflow-y:auto;
      overscroll-behavior:contain}
    .drawer a:not(.btn){padding:10px 4px;border-radius:0;border-bottom:1px solid var(--line)}
    .drawer a.on{box-shadow:none;border-bottom:2px solid var(--pink-300)}
    .drawer-cta{display:inline-flex;margin:14px auto 0;min-width:240px}
    :global(body.menu-open){overflow:hidden}
  }

  .lang{position:relative}
  .lang summary{display:inline-flex;align-items:center;gap:6px;list-style:none;cursor:pointer;
    min-height:var(--control-min);font-size:var(--fs-xs);font-weight:500;color:var(--ink-600);
    padding:7px 10px;border-radius:var(--r-xs);white-space:nowrap;
    border:1px solid var(--line);transition:.2s var(--ease)}
  .lang summary::-webkit-details-marker{display:none}
  .lang summary:hover{color:var(--ink-900);border-color:var(--ink-400)}
  .lang[open] summary{color:var(--ink-900);border-color:var(--ink-400)}
  .lang ul{position:absolute;right:0;top:calc(100% + 6px);margin:0;padding:6px;list-style:none;
    background:var(--paper);border:1px solid var(--line);border-radius:var(--r-sm);
    box-shadow:var(--sh-2);min-width:128px;z-index:60}
  .lang li a{display:flex;align-items:center;min-height:var(--control-min);padding:8px 12px;
    border-radius:var(--r-xs);text-decoration:none;font-size:var(--fs-xs);color:var(--ink-900)}
  .lang li a:hover{background:var(--greige-50)}
  .lang li a[aria-current="true"]{color:var(--ink-900);font-weight:700;box-shadow:inset 3px 0 0 var(--pink-300)}
  .lang-short{display:none}
  @media (max-width:720px){
    .lang summary{padding:6px 8px;font-size:var(--fs-2xs)}
    .lang-full{display:none}
    .lang-short{display:inline}
  }
</style>

<script>
  const b = document.querySelector<HTMLButtonElement>('[data-burger]');
  const d = document.querySelector<HTMLElement>('[data-drawer]');
  const compact = window.matchMedia('(max-width: 720px)');

  // 語言選單：點選單外或 Esc 收合（details 原生不會自己關）
  const lang = document.querySelector<HTMLDetailsElement>('[data-lang-menu]');
  if (lang) {
    document.addEventListener('click', event => {
      if (lang.open && event.target instanceof Node && !lang.contains(event.target)) lang.open = false;
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && lang.open) {
        lang.open = false;
        lang.querySelector('summary')?.focus();
      }
    });
    // Tab 走出選單才收合。relatedTarget 為 null 時不可關：iOS Safari 點連結
    // 不給焦點，會發出 relatedTarget=null 的 focusout，關掉選單會讓點擊落空
    lang.addEventListener('focusout', event => {
      const next = event.relatedTarget;
      if (lang.open && next instanceof Node && !lang.contains(next)) lang.open = false;
    });
  }

  if (b && d) {
    const setOpen = (open: boolean, restoreFocus = false) => {
      d.toggleAttribute('data-open', open);
      d.hidden = !open;
      b.setAttribute('aria-expanded', String(open));
      b.setAttribute('aria-label', (open ? b.dataset.labelClose : b.dataset.labelOpen) ?? '');
      // 手機全寬抽屜：鎖住背景捲動並把其餘內容設為 inert（焦點不會跑到看不見的地方）
      const lock = open && compact.matches;
      document.body.classList.toggle('menu-open', lock);
      for (const el of document.querySelectorAll('main, footer')) el.toggleAttribute('inert', lock);
      if (open && lang) lang.open = false;
      if (!open && restoreFocus) b.focus();
    };
    b.addEventListener('click', () => setOpen(!d.hasAttribute('data-open')));
    d.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('click', event => {
      if (!d.hasAttribute('data-open')) return;
      if (event.target instanceof Node && !d.contains(event.target) && !b.contains(event.target)) setOpen(false);
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && d.hasAttribute('data-open')) setOpen(false, true);
    });
    // 抽屜開著時跨越斷點：桌機面板 ↔ 手機全寬的鎖定狀態不同，直接關掉最安全
    compact.addEventListener('change', () => setOpen(false));
  }
</script>
