---
import { Image } from 'astro:assets';
import Heart from './Heart.astro';
// 字標：主色版（TSU #F3A0AA／NAGU #7DD0F5），header 與 footer 共用
import wordmark from '../assets/tsunagu-wordmark.png';
import { ui, href, switchHref, LANG_META, BASE, type Lang } from '../i18n/ui';
interface Props { lang?: Lang; altPaths?: Partial<Record<Lang, string>> }
const { lang = 'zh', altPaths } = Astro.props;
const t = ui[lang];
const nav = t.nav.map(n => ({ href: href(lang, n.path), label: n.label }));
const path = Astro.url.pathname;
const eventsHref = href(lang, '/events');
// 導覽 href 無結尾斜線、pathname 有，比較前先正規化
const norm = (u: string) => (u.length > 1 ? u.replace(/\/$/, '') : u);
const isCurrent = (h: string) => norm(path) === norm(h) || path.startsWith(`${h}/`);
// 在區段內但不是該頁本身時用 'true'（'page' 只給真正的當前頁）
const currentVal = (h: string) => (norm(path) === norm(h) ? 'page' : 'true');
const langs = (['zh', 'ja', 'en'] as Lang[]).map(l => ({
  code: l, label: LANG_META[l].label, current: l === lang,
  // 頁面有給 altPaths（如 404 導回各語首頁）就用它，否則從 pathname 換前綴
  href: altPaths?.[l] ? `${BASE}${altPaths[l]}` : switchHref(l, path),
}));
---
<header>
  <div class="wrap bar">
    <a class="logo" href={href(lang, '/')} aria-label={t.home}>
      <Heart size={22} />
      <Image src={wordmark} alt="TSUNAGU" widths={[110, 220, 330]} sizes="110px" class="wordmark"
        loading="eager" fetchpriority="high" decoding="async" />
      {lang === 'zh' && <span class="zh" lang="ja">台湾人と日本企業をツナグ</span>}
    </a>
    <!-- 2026-09-13 使用者定案：頁首太滿，改漢堡選單（放在語言鈕右邊），桌機手機統一。
         推翻 8/28「不做漢堡」的決定；手機分頁列一併移除，報名鈕移進抽屜 -->
    <a class="btn btn-primary cta" href={eventsHref}
      aria-current={isCurrent(eventsHref) ? 'page' : undefined}>{t.signup}</a>
    <details class="lang" data-lang-menu>
      <summary><span class="sr-only">{t.langMenu}：</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/>
        </svg>
        <span class="lang-full">{LANG_META[lang].label}</span><span class="lang-short">{LANG_META[lang].short}</span>
      </summary>
      <ul>
        {langs.map(l => (
          <li><a href={l.href} lang={LANG_META[l.code].htmlLang}
            aria-current={l.current ? 'true' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </details>
    <!-- 名稱固定，開關狀態只由 aria-expanded 表達（原本兩者都切，會唸成「關閉主選單，已展開」） -->
    <button class="burger" type="button" aria-label={t.mainMenu} aria-expanded="false"
      aria-controls="site-menu" data-burger>
      <span></span><span></span>
    </button>
  </div>
  <!-- 手機抽屜開啟時的遮罩（使用者 2026-09-25）：下方頁面已 inert，沒有遮罩會看起來還能點；點遮罩即關閉 -->
  <div class="scrim" data-scrim hidden></div>
  <nav class="drawer" id="site-menu" aria-label={t.mainMenu} data-drawer hidden>
    {nav.map(n => (
      <a href={n.href} class:list={{ on: isCurrent(n.href) }}
        aria-current={isCurrent(n.href) ? currentVal(n.href) : undefined}>{n.label}</a>
    ))}
    <a class="drawer-cta" href={eventsHref} class:list={{ on: isCurrent(eventsHref) }}
      aria-current={isCurrent(eventsHref) ? 'page' : undefined}>{t.signup}</a>
  </nav>
</header>

<style>
  header{position:sticky;top:0;z-index:50;   /* 無底線（使用者 2026-09-14）；捲動後靠 data-stuck 的淡陰影分隔 */
    /* 不能用全站的 --ease（y2=1.4 會過衝）：header 滑回來會先跑過頭再彈回，頂端露出一條縫看到底下文字
       （使用者 2026-09-14 iPhone 實測）。貼著螢幕頂的東西一律用不過衝的 ease-out */
    transition:transform .28s cubic-bezier(.22,.61,.36,1),box-shadow .28s cubic-bezier(.22,.61,.36,1)}
  /* 收合：往下捲滑走、往上捲回來（同 kawausojapanese 的 Kadence reveal-on-scroll-up）；捲動後縮高＋淡陰影 */
  /* 毛玻璃底畫在 ::before：header 本身若帶 backdrop-filter 會成為「backdrop root」，
     裡面抽屜面板的模糊就只取樣得到 header 自己，頁面文字直接透上來（2026-09-24 稽核） */
  header::before{content:'';position:absolute;inset:0;z-index:-1;background:var(--header-bg);
    backdrop-filter:saturate(1.4) blur(10px)}
  header[data-hidden]{transform:translate3d(0,-100%,0);pointer-events:none}
  header[data-stuck]{box-shadow:0 4px 18px rgba(70,70,70,.06)}
  .bar{display:flex;align-items:center;gap:12px;height:68px;transition:height .28s cubic-bezier(.22,.61,.36,1)}   /* 同上，不過衝 */
  @media (min-width:721px){ header[data-stuck] .bar{height:60px} }   /* 手機本來就 56px，不再縮 */
  .logo :global(svg){flex:0 0 22px}
  .logo{display:flex;align-items:center;gap:10px;min-height:var(--control-min);text-decoration:none;
    color:var(--ink-900);flex:0 1 auto;min-width:0;margin-right:auto}
  .wordmark{width:clamp(88px,28vw,110px);height:auto;display:block}
  .zh{font-size:var(--fs-2xs);color:var(--ink-600);border-left:1px solid var(--line);padding-left:10px;
    white-space:nowrap;min-width:0;overflow:hidden;text-overflow:ellipsis}
  .cta{min-height:var(--control-min);padding:10px 20px;font-size:var(--fs-sm);white-space:nowrap}
  /* 已在報名頁（/events）：換成次按鈕，標示「你在這裡」，也不再催促點同一頁（使用者 2026-09-25） */
  .cta[aria-current="page"]{background:var(--paper);color:var(--ink-900);border-color:var(--sky-300)}
  .cta[aria-current="page"]:hover{border-color:var(--pink-300)}
  /* 900px 以下收掉標語：logo＋報名鈕＋語言＋選單鈕已無餘裕 */
  @media (max-width:900px){ .zh{display:none} }

  /* 選單鈕：粉藍兩條圓頭短線（logo 屋頂的左粉右藍），開啟時交叉成 X。不用三條灰線。
     外框（使用者 2026-09-25）：粉藍線對白只有 2.0／1.7:1，靠 3:1 的 --control-line 框讓按鈕本身辨識得出來
     （WCAG 1.4.11）；語言鈕同一套框，兩顆並排才一致 */
  .burger{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:6px;
    width:var(--control-min);height:var(--control-min);flex:0 0 var(--control-min);
    background:var(--paper);border:1px solid var(--control-line);border-radius:var(--r-xs);padding:0;cursor:pointer;
    transition:border-color .2s var(--ease)}
  .burger:hover{border-color:var(--ink-900)}
  .burger:hover span{opacity:.75}
  .burger span{display:block;width:20px;height:3px;border-radius:3px;
    transition:transform .26s var(--ease)}
  .burger span:nth-child(1){background:var(--pink-300)}
  .burger span:nth-child(2){background:var(--sky-300);width:14px;align-self:flex-end;margin-right:12px}
  .burger[aria-expanded="true"] span{width:20px;margin:0;align-self:center}
  .burger[aria-expanded="true"] span:nth-child(1){transform:translateY(4.5px) rotate(45deg)}
  .burger[aria-expanded="true"] span:nth-child(2){transform:translateY(-4.5px) rotate(-45deg)}

  /* 抽屜：桌機是漢堡下方的右對齊面板；手機全寬 */
  .drawer{display:none;flex-direction:column;gap:2px;position:absolute;right:var(--layout-gutter);
    top:calc(100% + 8px);width:300px;padding:10px;
    /* 只寫無前綴版，前綴交給 lightningcss 補；兩個都寫時 build 會把無前綴那條丟掉，Chrome 就沒有模糊 */
    background:rgba(255,255,255,.78);backdrop-filter:blur(16px) saturate(1.2);
    border:1px solid var(--line);border-radius:var(--r-md);box-shadow:var(--sh-2);z-index:60}
  /* 滑鼠移到選單鈕就開（桌機）：鈕與面板之間 8px 空隙用 ::before 補滿，游標移下去不會中途關掉 */
  .drawer::before{content:'';position:absolute;left:0;right:0;bottom:100%;height:10px}
  .drawer[data-open]{display:flex}
  .drawer a{display:flex;align-items:center;min-height:var(--control-min);padding:10px 12px;
    border-radius:var(--r-xs);text-decoration:none;color:var(--ink-900);font-weight:500;font-size:var(--fs-md)}
  .drawer a:hover{background:var(--greige-50)}
  /* 當前頁＝粉字（使用者 2026-09-14：不要左側色條），2.0:1 與 action-link 同為其決定 */
  .drawer a.on{font-weight:700;color:var(--pink-300)}
  /* 報名：與其他列同樣式，只用粗體區分（做成粉按鈕會突兀）；桌機面板已有頁首報名鈕故隱藏 */
  .drawer a.drawer-cta{display:none;font-weight:700}   /* 權重要壓過 .drawer a{display:flex} */

  @media (max-width:720px){
    header::before{background:var(--paper);backdrop-filter:none}
    .bar{height:56px;gap:8px;padding:0 16px}
    .wordmark{width:clamp(88px,26vw,112px)}
    .cta{display:none}                      /* 手機頁首只留 logo／語言／漢堡；報名鈕在抽屜與 hero */
    .drawer{position:static;width:auto;border:0;border-top:1px solid var(--mobile-line);border-radius:0;
      box-shadow:none;padding:8px var(--layout-gutter) 18px;max-height:calc(100dvh - 56px);overflow-y:auto;
      overscroll-behavior:contain}
    .drawer a{padding:10px 4px;border-radius:0;border-bottom:1px solid var(--line)}
    .drawer a.on{border-bottom-color:var(--line)}
    .drawer a.drawer-cta{display:flex}
    /* 遮罩：在 header 的堆疊層裡墊在底色（::before，z -1）之下、頁面之上 */
    .scrim{position:fixed;inset:0;z-index:-2;background:rgba(68,68,68,.32);animation:scrim-in .2s ease-out}
    @keyframes scrim-in{from{opacity:0}}
    :global(body.menu-open){overflow:hidden}
  }

  .lang{position:relative}
  .lang summary{display:inline-flex;align-items:center;gap:6px;list-style:none;cursor:pointer;
    min-height:var(--control-min);font-size:var(--fs-xs);font-weight:500;color:var(--ink-600);
    padding:7px 10px;border-radius:var(--r-xs);white-space:nowrap;
    border:1px solid var(--control-line);transition:.2s var(--ease)}
  .lang summary::-webkit-details-marker{display:none}
  .lang summary:hover{color:var(--ink-900);border-color:var(--ink-900)}
  .lang[open] summary{color:var(--ink-900);border-color:var(--ink-900)}
  .lang ul{position:absolute;right:0;top:calc(100% + 6px);margin:0;padding:6px;list-style:none;
    background:var(--paper);border:1px solid var(--line);border-radius:var(--r-sm);
    box-shadow:var(--sh-2);min-width:128px;z-index:60}
  .lang li a{display:flex;align-items:center;min-height:var(--control-min);padding:8px 12px;
    border-radius:var(--r-xs);text-decoration:none;font-size:var(--fs-xs);color:var(--ink-900)}
  .lang li a:hover{background:var(--greige-50)}
  .lang li a[aria-current="true"]{color:var(--pink-300);font-weight:700} /* 當前＝粉字，同抽屜（規則 11，不用左側色條） */
  .lang-short{display:none}
  @media (max-width:720px){
    .lang summary{padding:6px 8px;font-size:var(--fs-2xs)}
    .lang-full{display:none}
    .lang-short{display:inline}
  }
</style>

<script>
  const b = document.querySelector<HTMLButtonElement>('[data-burger]');
  const scrim = document.querySelector<HTMLElement>('[data-scrim]');
  const d = document.querySelector<HTMLElement>('[data-drawer]');
  const compact = window.matchMedia('(max-width: 720px)');
  const headerEl = document.querySelector<HTMLElement>('header');

  // 頁首收合：往下捲藏起、往上捲累積 REVEAL px 才叫回來（濾掉手指回彈與慣性抖動）。
  // 選單或語言選單開著時不藏；鍵盤焦點進入頁首時強制顯示。
  if (headerEl) {
    const HIDE_AFTER = 96;   // 這個位置以上一律顯示
    const REVEAL = 12;
    let last = Math.max(0, window.scrollY), up = 0, ticking = false;
    const menuOpen = () => !!document.querySelector('[data-drawer][data-open], [data-lang-menu][open]');
    const update = () => {
      ticking = false;
      const y = Math.max(0, window.scrollY);
      const delta = y - last; last = y;
      headerEl.toggleAttribute('data-stuck', y > 4);
      if (y <= HIDE_AFTER || menuOpen()) { headerEl.removeAttribute('data-hidden'); up = 0; return; }
      if (delta > 0) { up = 0; headerEl.setAttribute('data-hidden', ''); }
      else if (delta < 0) { up += -delta; if (up >= REVEAL) headerEl.removeAttribute('data-hidden'); }
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    headerEl.addEventListener('focusin', () => headerEl.removeAttribute('data-hidden'));
    update();
  }

  // 語言選單：點選單外或 Esc 收合（details 原生不會自己關）
  const lang = document.querySelector<HTMLDetailsElement>('[data-lang-menu]');
  if (lang) {
    document.addEventListener('click', event => {
      if (lang.open && event.target instanceof Node && !lang.contains(event.target)) lang.open = false;
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && lang.open) {
        lang.open = false;
        lang.querySelector('summary')?.focus();
      }
    });
    // Tab 走出選單才收合。relatedTarget 為 null 時不可關：iOS Safari 點連結
    // 不給焦點，會發出 relatedTarget=null 的 focusout，關掉選單會讓點擊落空
    lang.addEventListener('focusout', event => {
      const next = event.relatedTarget;
      if (lang.open && next instanceof Node && !lang.contains(next)) lang.open = false;
    });
  }

  if (b && d) {
    const setOpen = (open: boolean, restoreFocus = false, closeLangMenu = true) => {
      d.toggleAttribute('data-open', open);
      d.hidden = !open;
      if (!open) openedByHover = false;
      b.setAttribute('aria-expanded', String(open));
      // 手機全寬抽屜：鎖住背景捲動並把其餘內容設為 inert（焦點不會跑到看不見的地方）
      const lock = open && compact.matches;
      document.body.classList.toggle('menu-open', lock);
      if (scrim) scrim.hidden = !lock;
      // .skip 也要：不然從抽屜最後一項 Tab 出去會落到「跳到主要內容」，而它指向已 inert 的 main
      for (const el of document.querySelectorAll('main, footer, .skip')) el.toggleAttribute('inert', lock);
      // hover 開抽屜不該連帶關掉已開的語言選單（使用者可能只是滑鼠掃過鈕）
      if (open && lang && closeLangMenu) lang.open = false;
      if (!open && restoreFocus) b.focus();
    };
    // 桌機滑鼠：移到選單鈕即開，離開鈕＋面板 160ms 後關（斜向移入面板不會閃關）；觸控裝置維持點擊。
    // 滑入已經開了，接著的那一下點擊不能再把它切關（實測：hover 開 → click 關，像壞掉）
    const hoverable = window.matchMedia('(hover:hover) and (pointer:fine)');
    let openedByHover = false;
    b.addEventListener('click', event => {
      // detail===0＝鍵盤觸發（Enter／Space）：照常切換，不吃掉第一下
      if (openedByHover && d.hasAttribute('data-open') && event.detail !== 0) { openedByHover = false; return; }
      setOpen(!d.hasAttribute('data-open'));
    });
    let closeTimer = 0;
    const cancelClose = () => { window.clearTimeout(closeTimer); };
    const scheduleClose = () => {
      cancelClose();
      closeTimer = window.setTimeout(() => {
        // 焦點還在鈕或面板內（例如滑鼠移開但鍵盤正在操作）就不關，避免把使用者踢出面板
        if (!compact.matches && !b.contains(document.activeElement) && !d.contains(document.activeElement)) setOpen(false);
      }, 160);
    };
    for (const el of [b, d]) {
      el.addEventListener('pointerenter', event => {
        if (event.pointerType !== 'mouse' || !hoverable.matches || compact.matches) return;
        cancelClose();
        if (!d.hasAttribute('data-open')) { setOpen(true, false, false); openedByHover = true; }
      });
      el.addEventListener('pointerleave', event => {
        if (event.pointerType !== 'mouse' || !hoverable.matches || compact.matches) return;
        scheduleClose();
      });
    }
    d.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('click', event => {
      if (!d.hasAttribute('data-open')) return;
      if (event.target instanceof Node && !d.contains(event.target) && !b.contains(event.target)) setOpen(false);
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && d.hasAttribute('data-open')) setOpen(false, true);
    });
    // 桌機：Tab 走出「鈕＋面板」就收合（同語言選單）；relatedTarget 為 null 不關，理由同上。
    // 手機全寬抽屜有 inert 把焦點圈在裡面，不會走出去，這條只對桌機有意義
    for (const el of [b, d]) {
      el.addEventListener('focusout', event => {
        const next = event.relatedTarget;
        if (compact.matches || !d.hasAttribute('data-open')) return;
        if (next instanceof Node && !d.contains(next) && !b.contains(next)) setOpen(false);
      });
    }
    // 抽屜開著時跨越斷點：桌機面板 ↔ 手機全寬的鎖定狀態不同，直接關掉最安全
    compact.addEventListener('change', () => setOpen(false));
  }
</script>
