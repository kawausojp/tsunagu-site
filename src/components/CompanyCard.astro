---
import CategoryIcon from './CategoryIcon.astro';
import { ui, type Lang } from '../i18n/ui';
import { CAT_LABEL } from '../lib/site';
interface Props { c: any; href: string; lang?: Lang }
const { c, href, lang = 'zh' } = Astro.props;
const t = ui[lang];
const d = c.data;
const tagline = (lang === 'ja' && d.taglineJa) || (lang === 'en' && d.taglineEn) || d.tagline;
const catLabel = (lang === 'ja' && (d.categoryLabelJa ?? CAT_LABEL.ja[d.category])) || (lang === 'en' && (d.categoryLabelEn ?? CAT_LABEL.en[d.category])) || d.categoryLabel;
const searchText = [d.name, d.corporateName, d.tagline, d.categoryLabel]
  .filter(Boolean).join(' ').normalize('NFKC').toLocaleLowerCase();
---
<a class="card card-link co" href={href} data-search={searchText}
   data-areas={d.areas.join(' ')} data-cat={d.category} data-jlpt={d.jlpt ?? 'none'}>
  <div class="thumb">
    <CategoryIcon cat={d.category} size={38} />
    <span aria-hidden="true">{d.name}</span>
  </div>
  <div class="body">
    <h3 class="d3">{d.name}</h3>
    {d.corporateName && <div class="corp" lang="ja">{d.corporateName}</div>}
    <div class="tags">
      {d.areas.map((a:string) => <span class="tag area">{t.area[a]}</span>)}
      <span class="tag job">{catLabel}</span>
      {d.jlpt && <span class="tag jlpt">{t.card.jlpt(d.jlpt)}</span>}
    </div>
    <p class="tag-line">{tagline}</p>
    <p class="stats-line">
      {[
        d.placements > 0 && t.card.placements(d.placements),
        d.fullTimeConverted > 0 && t.card.fullTime(d.fullTimeConverted),
        d.onlineInterview && t.card.online,
      ].filter(Boolean).join('・')}
    </p>
  </div>
</a>

<style>
  .co{display:block;min-width:0;text-decoration:none;color:inherit}
  .thumb{height:96px;background:var(--cream);border-bottom:1px solid var(--line);
    display:flex;gap:12px;align-items:center;justify-content:flex-start;padding:0 18px}
  .thumb span{font-family:var(--f-latin);font-weight:600;font-size:17px;color:var(--ink-900);
    letter-spacing:.1em;text-align:center;line-height:1.4}
  .body{padding:16px 18px 20px}
  .corp{font-size:12px;color:var(--ink-600);margin:2px 0 10px}
  .tags{margin:10px 0 12px}
  .tag-line{font-size:13.5px;color:var(--ink-600);line-height:1.8;margin:0 0 12px}
  .stats-line{margin:0;font-size:12.5px;color:var(--pink-700);letter-spacing:.02em}
  .co h3,.thumb span{overflow-wrap:anywhere}
  @media (max-width:720px){
    /* 兩格一列的半寬卡：只留品牌名、地區/職種標籤、實績。公司登記名與 tagline 進詳情頁看 */
    .thumb{height:52px;padding:0 14px;gap:10px;justify-content:flex-start}
    .thumb span{display:none}
    .thumb :global(svg){width:30px;height:30px}
    .body{padding:12px 12px 14px}
    .co h3{font-size:15px}
    .corp{display:none}
    .tag-line{display:none}
    .tags{margin:8px 0 9px;gap:4px}
    .tags :global(.tag){font-size:10.5px;padding:3px 9px}
    .stats-line{font-size:11px}
  }
</style>
