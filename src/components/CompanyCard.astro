---
const AREA = { tokyo:'東京', osaka:'大阪', kyoto:'京都', fukuoka:'福岡', kobe:'神戶', hokkaido:'北海道' };
interface Props { c: any; href: string; }
const { c, href } = Astro.props;
const d = c.data;
const searchText = [d.name, d.corporateName, d.tagline, d.categoryLabel]
  .filter(Boolean).join(' ').normalize('NFKC').toLocaleLowerCase();
---
<a class="card card-link co" href={href} data-search={searchText}
   data-areas={d.areas.join(' ')} data-cat={d.category} data-jlpt={d.jlpt ?? 'none'}>
  <div class="thumb"><span aria-hidden="true">{d.name}</span></div>
  <div class="body">
    <h3 class="d3">{d.name}</h3>
    {d.corporateName && <div class="corp" lang="ja">{d.corporateName}</div>}
    <div class="tags">
      {d.areas.map((a:string) => <span class="tag area">{AREA[a as keyof typeof AREA]}</span>)}
      <span class="tag job">{d.categoryLabel}</span>
      {d.jlpt && <span class="tag jlpt">{d.jlpt} 以上</span>}
    </div>
    <p class="tag-line">{d.tagline}</p>
    <div class="stats">
      {d.placements > 0 && <span class="stat">累計 {d.placements} 人任職</span>}
      {d.fullTimeConverted > 0 && <span class="stat alt">{d.fullTimeConverted} 人轉正職</span>}
      {d.onlineInterview && <span class="stat alt">可線上面試</span>}
    </div>
  </div>
</a>

<style>
  .co{display:block;text-decoration:none;color:inherit}
  .thumb{height:104px;background:linear-gradient(135deg,var(--pink-100),var(--sky-100));
    display:flex;align-items:center;justify-content:center;padding:0 18px}
  .thumb span{font-family:var(--f-latin);font-weight:600;font-size:17px;color:var(--ink-900);
    letter-spacing:.1em;text-align:center;line-height:1.4}
  .body{padding:16px 18px 20px}
  .corp{font-size:12px;color:var(--ink-600);margin:2px 0 10px}
  .tags{margin:10px 0 12px}
  .tag-line{font-size:13.5px;color:var(--ink-600);line-height:1.8;margin:0 0 12px}
  .stats{display:flex;flex-wrap:wrap;gap:6px}
  .stat{font-size:11.5px;font-weight:500;color:var(--pink-700);background:var(--pink-50);
    padding:4px 11px;border-radius:var(--r-full);letter-spacing:.02em}
  .stat.alt{color:var(--sky-700);background:var(--sky-50)}
  .co h3,.thumb span{overflow-wrap:anywhere}
  @media (max-width:720px){
    .thumb{height:7px;padding:0;background:linear-gradient(90deg,var(--pink-200),var(--sky-200))}
    .thumb span{display:none}
    .body{padding:15px 16px 17px}
    .corp{margin-bottom:8px}
    .tags{margin:8px 0 10px;gap:6px}
    .tag-line{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  }
</style>
