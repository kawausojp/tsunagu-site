---
import CategoryIcon from './CategoryIcon.astro';
import { ui, type Lang } from '../i18n/ui';
import { CAT_LABEL, SKY_CATEGORIES, companyName, nameLang } from '../lib/site';
interface Props { c: any; href: string; lang?: Lang }
const { c, href, lang = 'zh' } = Astro.props;
const t = ui[lang];
const d = c.data;
const name = companyName(d, lang);
const tagline = (lang === 'ja' && d.taglineJa) || (lang === 'en' && d.taglineEn) || d.tagline;
const catLabel = (lang === 'ja' && (d.categoryLabelJa ?? CAT_LABEL.ja[d.category])) || (lang === 'en' && (d.categoryLabelEn ?? CAT_LABEL.en[d.category])) || d.categoryLabel;
// 搜尋文字含 zh 原值＋當前語言的 tagline／品類，日英頁才能用當地語言命中
const searchText = [d.name, name, d.corporateName, d.tagline, d.categoryLabel, tagline, catLabel]
  .filter(Boolean).join(' ').normalize('NFKC').toLocaleLowerCase();
---
<!-- 整張卡可點（品牌名的連結用 ::after 撐滿整張），右上角的愛心是獨立按鈕——<a> 裡不能放 <button>（2026-10-11 加收藏） -->
<article class="card card-link co" data-slug={c.id} data-search={searchText}
   data-areas={d.areas.join(' ')} data-cat={d.category} data-jlpt={d.jlpt ?? 'none'}
   data-online={d.onlineInterview ? '1' : '0'} data-fulltime={d.fullTimeConverted > 0 ? '1' : '0'}>
  <!-- 2026-09-13 使用者參考 Cake／Yourator 重排：圖標在名稱左側同一列、順序固定、標籤與實績貼底，
       同列各卡每一行對齊（有無登記名、tagline 長短都不影響） -->
  <div class="head">
    <!-- 圖標與品牌名：點進品牌頁時從卡片連續變形到頁首。名字由 src/scripts/vt.js 只在被點的那張卡上臨時加 -->
    <span class="ico" data-tone={SKY_CATEGORIES.has(d.category) ? 'sky' : 'pink'}><CategoryIcon cat={d.category} size={30} /></span>
    <div class="ttl">
      <h3 class="d3" lang={nameLang(name, lang)}><a class="co-link" href={href}>{name}</a></h3>
      {d.corporateName && <div class="corp" lang="ja">{d.corporateName}</div>}
    </div>
  </div>
  <p class="tag-line">{tagline}</p>
  <div class="tags">
      {d.areas.map((a:string) => <span class="tag area">{t.area[a]}</span>)}
      <span class="tag job">{catLabel}</span>
      {d.jlpt && <span class="tag jlpt">{t.card.jlpt(d.jlpt)}</span>}
  </div>
  <p class="stats-line">
      {(d.placements > 0 || d.fullTimeConverted > 0 || d.onlineInterview) ? [
        d.placements > 0 && t.card.placements(d.placements),
        d.fullTimeConverted > 0 && t.card.fullTime(d.fullTimeConverted),
        d.onlineInterview && t.card.online,
      ].filter(Boolean).map((seg, i, arr) => (
        <span class="seg">{seg}{i < arr.length - 1 ? (lang === 'en' ? ' · ' : '・') : ''}</span>
      )) : '\u00A0'}
  </p>
  <button type="button" class="save" data-save={c.id} aria-pressed="false" aria-label={t.save.save(name)}>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 20.3s-7.6-4.6-7.6-10.2A4.3 4.3 0 0 1 12 7.4a4.3 4.3 0 0 1 7.6 2.7c0 5.6-7.6 10.2-7.6 10.2z"/></svg>
  </button>
</article>

<style>
  /* 同列各卡逐行對齊（規則 9）：卡片吃父格線的 subgrid，名稱／tagline／標籤／實績四列的高度
     由同一列最高的那張卡決定。原本用固定高度（52px 名稱區、兩行 tagline），品牌名一折兩行
     就把整張卡往下推（2026-09-24 稽核：Metro、きものやまと 同列錯位 15–23px） */
  /* minmax(0,1fr)：單欄 auto 軌會被登記名（nowrap）的 min-content 撐寬，Lindt 卡在 1024 溢出 4px */
  .co{position:relative;display:grid;grid-row:span 4;grid-template-rows:subgrid;grid-template-columns:minmax(0,1fr);row-gap:12px;min-width:0;
    padding:18px 18px 16px;text-decoration:none;color:inherit}
  /* 品牌名的連結撐滿整張卡；焦點框畫在整張卡上，不畫在品牌名那一小塊 */
  .co-link{color:inherit;text-decoration:none}
  .co-link::after{content:'';position:absolute;inset:0;z-index:1;border-radius:inherit}
  .co-link:focus-visible{outline:none}
  .co:has(.co-link:focus-visible){outline:3px solid var(--focus-ring);outline-offset:3px}
  /* 收藏鈕：卡片右上角，疊在撐滿的連結之上。空心灰框心／收藏後粉色實心 */
  .save{position:absolute;top:10px;right:10px;z-index:2;width:36px;height:36px;display:flex;align-items:center;justify-content:center;
    border:0;border-radius:var(--r-full);background:transparent;color:var(--ink-600);cursor:pointer;padding:0;
    transition:background .2s ease,transform .24s var(--ease)}
  .save svg{fill:none;stroke:currentColor;stroke-width:1.8;stroke-linejoin:round}
  .save[aria-pressed="true"]{color:var(--pink-300)}
  .save[aria-pressed="true"] svg{fill:var(--pink-300);stroke:var(--pink-300)}
  .save:hover{background:var(--greige-50)}
  .save:active{transform:scale(.88)}
  .save.pop svg{animation:save-pop .42s var(--ease)}
  @keyframes save-pop{40%{transform:scale(1.3)}}
  .ttl{padding-right:26px}
  /* 第一列：品類圖標（小方塊）＋品牌名＋登記名。名稱區最少 52px（＝名稱＋登記名），
     內容垂直置中：無登記名的卡，品牌名就對齊圖標中線（使用者 2026-09-14） */
  .head{display:flex;gap:12px;align-items:center}
  /* 淺藍底上：不加框線，白卡靠淡藍陰影浮起（2026-09-26 使用者選 C；原為 9/14 的粉色光暈邊線），hover 陰影加深 */
  .co.card{border-color:transparent;box-shadow:var(--card-float)}
  .co.card:hover,.co.card:focus-visible{box-shadow:var(--card-float-hover)}
  /* 地區標籤在卡片裡改灰框（2026-09-26 使用者選 C）：一張卡原本有粉暈＋圖示框＋藍框地區＋粉框職種四種彩色線，
     太花。彩色只留圖示框與職種標籤這兩個有意義的點 */
  .co .tags :global(.tag.area){border-color:var(--line);color:var(--ink-600)}
  /* 圖標方塊框＝品類主色（與 CategoryIcon 共用 SKY_CATEGORIES），卡片之間才有色彩差異 */
  .ico{flex:0 0 44px;width:44px;height:44px;display:flex;align-items:center;justify-content:center;
    border:1.5px solid var(--pink-300);border-radius:var(--r-sm);background:var(--paper)}
  .ico[data-tone="sky"]{border-color:var(--sky-300)}
  /* hover 時品類圖標歪頭一下（同 hero 角色的 hover 傾斜）：卡片整張上浮之外，多一個「它聽到你了」的小回應 */
  .ico{transition:transform .32s var(--ease)}
  @media (hover:hover) and (pointer:fine){ .co:hover .ico{transform:rotate(-8deg) scale(1.06)} }
  .ttl{min-width:0;flex:1;min-height:52px;display:flex;flex-direction:column;justify-content:center;align-items:stretch}
  .co h3{overflow-wrap:anywhere;line-height:1.5}
  .corp{font-size:var(--fs-2xs);color:var(--ink-600);line-height:1.6;margin-top:2px;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  /* tagline 最多兩行（超出截斷）；列高由 subgrid 對齊，不必再撐 min-height */
  .tag-line{font-size:var(--fs-sm);color:var(--ink-600);line-height:1.7;margin:0;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .tags{margin:0;align-self:start}
  /* 實績列貼底 */
  .stats-line{margin:0;align-self:end;font-size:var(--fs-xs);color:var(--ink-600);letter-spacing:.02em;line-height:1.6}
  .stats-line .seg{white-space:nowrap}
  /* 英文段落有空格可自然折行；nowrap 會讓 "1 became full-time" 在半寬卡上被切掉（實測 320–1024 皆有）。
     數字與名詞之間用 nbsp（ui.ts），不會拆成「2 / became」 */
  :global(html[lang="en"]) .stats-line .seg{white-space:normal}
  @media (max-width:720px){
    /* 兩格一列的半寬卡：只留圖標＋品牌名、標籤、實績（三列）。登記名與 tagline 進詳情頁看 */
    .co{grid-row:span 3;row-gap:8px;padding:12px}
    .head{gap:8px}
    .ico{flex-basis:32px;width:32px;height:32px}
    .ico :global(svg){width:22px;height:22px}
    .co h3{font-size:var(--fs-md)}
    .corp,.tag-line{display:none}
    .ttl{min-height:0}
    .tags{gap:4px}
    .tags :global(.tag){font-size:var(--fs-3xs);padding:3px 8px}
    .stats-line{font-size:var(--fs-2xs)}
    .save{top:4px;right:4px;width:32px;height:32px}
    .save svg{width:16px;height:16px}
    .ttl{padding-right:18px}
  }
  /* 320–400px 拉丁品牌名："WILLOUGHBY" 差 3px 就被切成 "WILLOUGHB / Y"；keep-all 同時防「BLOOMING 中西」被拆。
     日文名（lang=ja）不能 keep-all：整串變成不可斷，「メトロプロパティーズ系列の飲食店」會衝出卡片蓋住圖標 */
  @media (max-width:400px){
    .co h3{font-size:var(--fs-sm)}
    .co h3:not(:lang(ja)){word-break:keep-all}
  }
  /* 320px 機種：圖標旁只剩約 75px，"WILLOUGHBY" 仍超出 6px → 再降一階並收字距 */
  @media (max-width:360px){
    .co h3{font-size:var(--fs-xs);letter-spacing:0}
  }
</style>
