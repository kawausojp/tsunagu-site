---
import { Image } from 'astro:assets';
import wordmark from '../assets/tsunagu-wordmark.png';
import { ui, href, type Lang } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'zh' } = Astro.props;
const t = ui[lang];
---
<footer>
  <div class="wrap grid">
    <div>
      <Image src={wordmark} alt="TSUNAGU" widths={[180, 360]} sizes="180px" class="wm" />
      <p class="small"><span lang="ja">台湾人と日本企業をツナグ</span><br/>{t.footerTagline}</p>
      <p class="small">{t.footerFree}</p>
    </div>
    <div>
      <h2>{t.footerSite}</h2>
      {t.footerLinks.map(l => <a href={href(lang, l.path)}>{l.label}</a>)}
    </div>
    <div>
      <h2>{t.footerContact}</h2>
      <a href="https://www.instagram.com/tw.tsunagu.jp/" rel="me noopener" target="_blank">Instagram @tw.tsunagu.jp <span aria-hidden="true">↗</span></a>
      <a href="https://www.threads.com/@tw.tsunagu.jp" rel="me noopener" target="_blank">Threads @tw.tsunagu.jp <span aria-hidden="true">↗</span></a>
    </div>
  </div>

  <!-- 上線前必須在此加回許可資訊段落：依《私立就業服務機構許可及管理辦法》第 35 條，
       就業服務業務廣告應載明「機構名稱、許可證字號、機構地址及電話」（填持照機構資料）。
       佔位版本見 git 歷史此檔案的 .pending 段落。 -->
  <div class="wrap legal">
    <p class="small">
      {t.organizer}
    </p>
  </div>
</footer>

<style>
  footer{background:var(--paper);border-top:1px solid var(--line);padding:56px 0 40px;margin-top:40px}
  .grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:32px}
  footer :global(.wm){width:170px;height:auto;margin-bottom:14px}
  h2{font-size:var(--fs-xs);letter-spacing:.06em;color:var(--ink-600);margin-bottom:10px;font-weight:700}
  footer a{display:block;font-size:var(--fs-sm);color:var(--ink-600);text-decoration:none;padding:4px 0}
  footer a:hover{color:var(--pink-700)}
  .legal{margin-top:40px;padding-top:24px;border-top:1px solid var(--line)}
  @media (max-width:720px){
    footer{padding:32px 0 24px;margin-top:32px;border-top-color:var(--mobile-line)}
    .grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px 16px}
    .grid>div:first-child{grid-column:1/-1}
    footer :global(.wm){width:140px;margin-bottom:12px}
    footer p.small{font-size:var(--fs-xs);line-height:1.7;margin-bottom:10px}
    h2{font-size:var(--fs-2xs);margin-bottom:7px}
    footer a{display:flex;align-items:center;min-height:44px;padding:7px 0;font-size:var(--fs-xs);line-height:1.5}
    .legal{margin-top:24px;padding-top:20px;border-top-color:var(--mobile-line)}
  }
</style>
