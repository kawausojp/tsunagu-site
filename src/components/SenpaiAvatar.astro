---
// 學長姐可愛頭像：原創 SVG 插圖，以名字為種子決定髮型／髮色／衣色，每位固定不變。
// 真人照片需本人同意（README：照片一律未使用），插圖不碰肖像權；日後取得同意可逐位換照片。
interface Props { name: string; size?: number; }
const { name, size = 56 } = Astro.props;
const seed = [...name].reduce((a, c) => a + c.codePointAt(0)!, 0);
const S = 'var(--ink-900)';   // 線稿吃 token（inline SVG 的 fill/stroke 支援 var()）
// 膚色與髮色是刻意的插畫獨立值，不屬 token 系統——不要改成 var()
const SKIN = '#FBEFE6';
const BLUSH = 'var(--pink-300)';
const HAIRS = ['#8A7364', '#5F5049', '#A98F73', '#74604F', '#93705D'];
// 衣色／底色對齊粉彩 token；最後一個衣色原為 --greige-100，token 已併入 --line
const SHIRTS = ['var(--pink-200)', 'var(--sky-200)', 'var(--pink-100)', 'var(--sky-100)', 'var(--line)'];
const BGS = ['var(--pink-50)', 'var(--sky-50)', 'var(--greige-50)', 'var(--note-bg)'];
const hair = HAIRS[seed % HAIRS.length];
const shirt = SHIRTS[(seed >> 2) % SHIRTS.length];
const bg = BGS[(seed >> 4) % BGS.length];
const style = seed % 4;   // 0 長髮 1 短髮 2 丸子頭 3 瀏海雙側髮
---
<svg width={size} height={size} viewBox="0 0 56 56" fill="none" aria-hidden="true"
  stroke={S} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  <circle cx="28" cy="28" r="27" fill={bg} stroke="none"/>
  {style === 0 && <path d="M13 50c0-12-1-20 2-26 3-5 8-8 13-8s10 3 13 8c3 6 2 14 2 26z" fill={hair}/>}
  {style === 2 && <circle cx="28" cy="12" r="6" fill={hair}/>}
  <!-- 臉 -->
  <circle cx="28" cy="26" r="12.5" fill={SKIN}/>
  <!-- 髮 -->
  {style === 0 && <path d="M15.5 26c0-8 5.5-13 12.5-13s12.5 5 12.5 13c-2-5-5-7-12.5-7s-10.5 2-12.5 7z" fill={hair}/>}
  {style === 1 && <path d="M15.5 27c-1-9 5.5-14 12.5-14s13.5 5 12.5 14c-1.5-4-2-6-4-8-1 1.5-2 2.5-4.5 3-4 1-9.5.5-12-3-2 2-3.5 4-4.5 8z" fill={hair}/>}
  {style === 2 && <path d="M15.5 26c0-8 5.5-13 12.5-13s12.5 5 12.5 13c-2-5-6-7-12.5-7s-10.5 2-12.5 7z" fill={hair}/>}
  {style === 3 && <>
    <path d="M15.5 26c0-8 5.5-13 12.5-13s12.5 5 12.5 13c-1-4.5-3-6.5-5-7l-1.5 3-2.5-3.5-3 3.5-2.5-3.5-2 3c-2.5 1-5 2.5-6 5z" fill={hair}/>
    <path d="M14 30c-2 3-2 7 0 9M42 30c2 3 2 7 0 9" fill="none" stroke={hair} stroke-width="4"/>
  </>}
  <!-- 表情：黑點眼、微笑、腮紅（角色同款） -->
  <circle cx="23.5" cy="27" r="1.3" fill={S} stroke="none"/>
  <circle cx="32.5" cy="27" r="1.3" fill={S} stroke="none"/>
  <path d="M26 31c1 1.2 3 1.2 4 0" fill="none"/>
  <circle cx="20.5" cy="30" r="2" fill={BLUSH} stroke="none" opacity=".7"/>
  <circle cx="35.5" cy="30" r="2" fill={BLUSH} stroke="none" opacity=".7"/>
  <!-- 上衣 -->
  <path d="M13 52c1-8 7-12 15-12s14 4 15 12z" fill={shirt}/>
</svg>
