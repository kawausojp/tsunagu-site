---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import '../../../styles/page-companies.css';
import CompanyCard from '../../../components/CompanyCard.astro';

import { href } from '../../../i18n/ui';
import { CAT_LABEL } from '../../../lib/site';
const l = (p: string) => href('en', p);
const companies = (await getCollection('companies'))
  .sort((a, b) => b.data.placements - a.data.placements || a.data.name.localeCompare(b.data.name));

const AREA: Record<string,string> = { tokyo:'Tokyo', osaka:'Osaka', kyoto:'Kyoto', fukuoka:'Fukuoka', kobe:'Kobe', hokkaido:'Hokkaido' };
const areaKeys = Object.keys(AREA).filter(k => companies.some(c => c.data.areas.includes(k as any)));
const cats = [...new Map(companies.map(c => [c.data.category, CAT_LABEL.en[c.data.category] ?? c.data.categoryLabel])).entries()];
const jlpts = ['N2','N3'].filter(j => companies.some(c => c.data.jlpt === j));
const totalPlacements = companies.reduce((s,c)=>s+c.data.placements,0);
---
<Base title="Partner Brands" lang="en" altPaths={{ zh: '/companies/', ja: '/ja/companies/', en: '/en/companies/' }} description="All Japanese brands partnering with Tsunagu — filter by area, role and Japanese level.">
  <section class="page-head">
    <div class="wrap">
      <h1 class="d1">Partner brands</h1>
      <p class="lead">
        {companies.length} brands across 39 contracted companies.
        Most never post jobs on Chinese-language job boards — which is exactly why they’re hard to find on your own.
      </p>
    </div>
  </section>

  <div class="wrap tools" data-filter-root
    data-status-tpl="Showing {n} of 35 brands"
    data-summary-label="Filters"
    data-summary-picked="Filters ({n} selected)">
    <div class="filters">
      <label class="search">
        <span>Search brands</span>
        <input type="search" inputmode="search" autocomplete="off" placeholder="Type a brand name"
          aria-controls="company-grid" data-search-input />
      </label>
      <details class="filter-options" data-filter-options open>
        <summary data-filter-summary>Filters</summary>
        <div class="filter-groups">
          <div class="grp" role="group" aria-labelledby="filter-area-label">
            <span class="lbl" id="filter-area-label">Area</span>
            {areaKeys.map(k => <button type="button" class="tag area f" data-f="area" data-v={k}
              aria-pressed="false" aria-controls="company-grid">{AREA[k]}</button>)}
          </div>
          <div class="grp" role="group" aria-labelledby="filter-cat-label">
            <span class="lbl" id="filter-cat-label">Role</span>
            {cats.map(([k,l]) => <button type="button" class="tag job f" data-f="cat" data-v={k}
              aria-pressed="false" aria-controls="company-grid">{l}</button>)}
          </div>
          <div class="grp" role="group" aria-labelledby="filter-jlpt-label">
            <span class="lbl" id="filter-jlpt-label">Japanese</span>
            {jlpts.map(j => <button type="button" class="tag jlpt f" data-f="jlpt" data-v={j}
              aria-pressed="false" aria-controls="company-grid">{j}+</button>)}
            <button type="button" class="tag f" data-f="jlpt" data-v="none"
              aria-pressed="false" aria-controls="company-grid">No requirement</button>
          </div>
          <div class="grp" role="group" aria-labelledby="filter-flag-label">
            <span class="lbl" id="filter-flag-label">More</span>
            <button type="button" class="tag f" data-f="flag" data-v="online"
              aria-pressed="false" aria-controls="company-grid">Online interview OK</button>
            <button type="button" class="tag f" data-f="flag" data-v="fulltime"
              aria-pressed="false" aria-controls="company-grid">Full-time conversions</button>
          </div>
        </div>
      </details>
      <button type="button" class="reset" data-reset data-reset-toggle hidden>Clear search & filters</button>
    </div>
    <p class="count small"><span role="status" aria-live="polite" aria-atomic="true"
      data-status>Showing {companies.length} of {companies.length} brands</span><span> / {totalPlacements} total placements across the {companies.length} brands listed here</span></p>
  </div>

  <div class="wrap">
    <div class="notice">
      <strong>About openings:</strong> these are brand profiles and past placement records, not live job listings. For current openings and conditions, ask at a <a href={l('/events')}>meetup</a> or in an individual consultation.
    </div>
  </div>

  <section class="wrap list">
    <h2 class="sr-only">Search results</h2>
    <div class="grid" id="company-grid" data-grid>
      {companies.map(c => <CompanyCard c={c} href={l(`/companies/${c.id}`)} lang="en" />)}
    </div>
    <div class="empty" data-empty hidden>
      <p class="small">No brands match these filters.</p>
      <button type="button" class="btn btn-secondary" data-reset>Clear all filters and see every brand</button>
    </div>
  </section>

  <section class="wrap page-section closing">
    <h2 class="d2">Found a brand you like?</h2>
    <p class="lead">The fastest way to learn what they’re hiring for is to ask at a meetup.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href={l('/events')}>Join a meetup →</a>
      <a class="action-link" href={l('/stories')}>Read alumni stories →</a>
    </div>
  </section>
</Base>


<script>
  import { initCompanyFilter } from '../../../scripts/company-filter';
  initCompanyFilter();
</script>
