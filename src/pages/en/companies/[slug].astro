---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import '../../../styles/page-company.css';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  return companies.map(c => ({ params: { slug: c.id }, props: { c } }));
}
const { c } = Astro.props;
const d = c.data;
const { Content } = await render(c);
// 在這個品牌工作過的學長姐（company 名寬鬆比對；資料本來就在庫裡，接上而已）
const allStories = await getCollection('stories');
const norm = (x: string) => x.normalize('NFKC').toLowerCase().replace(/[^a-z0-9\u3040-\u30ff\u4e00-\u9fff]/g, '');
const dn = norm(d.name);
const relatedStories = allStories.filter(st => {
  const sn = norm(st.data.company);
  if (sn.length < 2) return false;
  // 前綴比對而非子字串：避免 "ete" 誤配 "agete"；另取空格前第一段處理 "MUK ムカイ" → MUKAI
  const snFirst = norm(st.data.company.split(/[\s/]/)[0]);
  return sn === dn || dn.startsWith(sn) || sn.startsWith(dn) || (snFirst.length > 2 && dn.startsWith(snFirst));
}).sort((a, b) => a.data.order - b.data.order);
import { href } from '../../../i18n/ui';
import { CAT_LABEL, VISA_LABEL } from '../../../lib/site';
const l = (p: string) => href('en', p);
const catLabel = CAT_LABEL.en[d.category] ?? d.categoryLabel;
const tagline = d.taglineEn ?? d.tagline;
const AREA: Record<string,string> = { tokyo:'Tokyo', osaka:'Osaka', kyoto:'Kyoto', fukuoka:'Fukuoka', kobe:'Kobe', hokkaido:'Hokkaido' };
---
<Base title={`${d.name} — Work in Japan`} lang="en"
  altPaths={{ zh: `/companies/${c.id}/`, ja: `/ja/companies/${c.id}/`, en: `/en/companies/${c.id}/` }}
  description={`${d.name} (${catLabel}) brand profile and Taiwanese staff placement record${d.placements > 0 ? `: ${d.placements} placed via Tsunagu` : ''}.`}>
  <article>
    <div class="hero">
      <div class="wrap wrap--prose">
        <a class="back" href={l('/companies')}>← All partner brands</a>
        <h1 class="d1">{d.name}</h1>
        {d.corporateName && <p class="corp" lang="ja">{d.corporateName}</p>}
        <p class="lead">{tagline}</p>
        <div class="tags">
          {d.areas.map((a:string) => <span class="tag area">{AREA[a]}</span>)}
          <span class="tag job">{catLabel}</span>
          {d.jlpt && <span class="tag jlpt">{d.jlpt}+</span>}
          {d.onlineInterview && <span class="tag">Online interview OK</span>}
        </div>
      </div>
    </div>

    <div class="wrap wrap--prose body">
      <div class="prose"><Content /></div>

      {d.highlights.length > 0 && (
        <div class="hl">
          <h2 class="d3">Highlights (original text)</h2>
          <ul>{d.highlights.map((h:string) => <li>{h}</li>)}</ul>
        </div>
      )}

      {(d.placements > 0 || d.fullTimeConverted > 0) && (
        <div class="numbers">
          {d.placements > 0 && <div><div class="n">{d.placements}</div><div class="t">Taiwanese staff placed</div></div>}
          {d.fullTimeConverted > 0 && <div><div class="n">{d.fullTimeConverted}</div><div class="t">became full-time</div></div>}
        </div>
      )}

      <div class="note">
        <strong>Source:</strong> Taipei meetup deck 2026.4.18{d.sourceSlide && `, p.${d.sourceSlide}`}. Openings and conditions change — confirm at a meetup or consultation. * Body text is shown in its original language (Chinese).
      </div>

      {relatedStories.length > 0 && (
        <div class="related">
          <h2 class="d3">Alumni who worked here</h2>
          {relatedStories.map(st => (
            <a class="rel-link" href={l(`/stories#${st.id}`)}><span lang="ja">{st.data.name}</span> ({VISA_LABEL.en[st.data.visa] ?? st.data.visa}) — read their story →</a>
          ))}
        </div>
      )}
      <div class="cta">
        <a class="btn btn-primary" href={l('/events')}>Ask about it at a meetup →</a>
        <a class="action-link" href={l('/companies')}>See all 35 partner brands →</a>
      </div>
    </div>
  </article>
</Base>

