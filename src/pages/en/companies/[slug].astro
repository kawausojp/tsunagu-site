---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import CategoryIcon from '../../../components/CategoryIcon.astro';
import '../../../styles/page-company.css';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  return companies.map(c => ({ params: { slug: c.id }, props: { c } }));
}
const { c } = Astro.props;
const d = c.data;
const name = companyName(d, 'en');
const { Content } = await render(c);
// 在這個品牌工作過的學長姐（company 名寬鬆比對；資料本來就在庫裡，接上而已）
const allStories = await getCollection('stories');
const companiesCount = (await getCollection('companies')).length;
const relatedStories = relatedStoriesFor(d.name, allStories);
import { href, ui } from '../../../i18n/ui';
import { CAT_LABEL, VISA_LABEL, dedupHighlights, fmtSourceDeck, companyName, relatedStoriesFor, signupCta, nameLang, SKY_CATEGORIES } from '../../../lib/site';
const l = (p: string) => href('en', p);
const catLabel = CAT_LABEL.en[d.category] ?? d.categoryLabel;
const tagline = d.taglineEn ?? d.tagline;
const AREA = ui['en'].area;
const hl = dedupHighlights(d.highlights, d.placements);
---
<Base title={`${name} — Work in Japan`} lang="en"
  altPaths={{ zh: `/companies/${c.id}/`, ja: `/ja/companies/${c.id}/`, en: `/en/companies/${c.id}/` }}
  description={`${name} (${catLabel}) brand profile and Taiwanese staff placement record${d.placements > 0 ? `: ${d.placements} placed via Tsunagu` : ''}.`}>
  <article>
    <div class="page-head hero">
      <div class="wrap wrap--page">
        <a class="back" data-back-list href={l('/companies')}><span aria-hidden="true">←</span> All partner brands</a>
        <!-- 頁首兩欄（2026-10-04）：左＝品類圖標＋品牌名＋登記名、tagline、標籤；右＝實績數字（原本在內文最下方的磁磚）。
             圖標與品牌名跟企業卡同名（view-transition-name），從列表點進來會連續變形到這裡 -->
        <div class="b-head">
          <div class="b-id">
            <div class="b-name">
              <span class="b-ico" data-tone={SKY_CATEGORIES.has(d.category) ? 'sky' : 'pink'} style={`view-transition-name:ico-${c.id}`}><CategoryIcon cat={d.category} size={36} /></span>
              <div class="b-ttl">
                <h1 class="d1" data-vt style={`view-transition-name:nm-${c.id}`} lang={nameLang(name, 'en')}>{name}</h1>
                {d.corporateName && <p class="corp" lang="ja">{d.corporateName}</p>}
              </div>
            </div>
            <p class="lead">{tagline}</p>
            <div class="tags">
              {d.areas.map((a:string) => <span class="tag area">{AREA[a]}</span>)}
              <span class="tag job">{catLabel}</span>
              {d.jlpt && <span class="tag jlpt">{d.jlpt}+</span>}
              {d.onlineInterview && <span class="tag">Online interview OK</span>}
            </div>
          </div>
          {(d.placements > 0 || d.fullTimeConverted > 0) && (
            <dl class="b-figs">
              {d.placements > 0 && <div><dt>Taiwanese staff placed</dt><dd class="n">{d.placements}</dd></div>}
              {d.fullTimeConverted > 0 && <div><dt>became full-time</dt><dd class="n">{d.fullTimeConverted}</dd></div>}
            </dl>
          )}
        </div>
      </div>
    </div>

    <div class="wrap wrap--page page-section body">
      <div class="prose" lang="zh-Hant"><Content /></div>

      {hl.length > 0 && (
        <div class="card hl">
          <h2 class="d3">Highlights (original text)</h2>
          <ul lang="zh-Hant">{hl.map((h:string) => <li>{h}</li>)}</ul>
        </div>
      )}

      <div class="note">
        <span class="sent"><strong>Source:</strong> {fmtSourceDeck('en', d.sourceSlide)}.</span><span class="sent">Openings and conditions change — confirm at a meetup or consultation.</span><span class="sent">* Body text is shown in its original language (Chinese).</span>
      </div>

      {relatedStories.length > 0 && (
        <div class="related">
          <h2 class="d3">Alumni who worked here</h2>
          {relatedStories.map(st => (
            <a class="rel-link" href={l(`/stories#${st.id}`)}><span lang="ja">{st.data.name}</span> ({VISA_LABEL.en[st.data.visa] ?? st.data.visa}) — read their story</a>
          ))}
        </div>
      )}
      <div class="cta-row cta">
        <a class="btn btn-primary" href={l('/events')}>{signupCta('en')}</a>
        <a class="action-link" href={l('/companies')}>See all {companiesCount} partner brands</a>
      </div>
    </div>
  </article>
</Base>
<script>import '../../../scripts/back-to-list.ts';</script>
