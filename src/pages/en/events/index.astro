---
// English: meetup schedule. Structure shared with zh version (page-events.css). Update all three languages together.
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import '../../../styles/page-events.css';
import { href } from '../../../i18n/ui';
import { todayTaipei, fmtEventDateFull, fmtEventNo, fmtSince, CITY, eventLd, totalHeld, eventsMeta, JOIN_STEPS, gcalUrl, companyName } from '../../../lib/site';

const l = (p: string) => href('en', p);
const today = todayTaipei();
const sorted = [...eventsMeta.events].sort((a, b) => b.date.localeCompare(a.date));
const upcoming = sorted.filter(e => e.date >= today).reverse();
const past = sorted.filter(e => e.date < today);
const fmt = (d: string) => fmtEventDateFull(d, 'en');
const city = (c: string) => CITY.en[c] ?? c;

// Event 結構化資料：site.ts eventLd()（三語共用）
const eventsLd = upcoming.filter(e => e.venue && e.address).map(eventLd);

const flow = JOIN_STEPS.en;   // 三語共用，文字在 site.ts（品牌頁的「想在這裡工作？」也用同一份）
// 「你收藏的品牌」提示框要的品牌名與網址（收藏本身在訪客瀏覽器，save.js 依這份清單畫出來）
const savedNames = Object.fromEntries((await getCollection('companies')).map(c => [c.id, { name: companyName(c.data, 'en'), href: l(`/companies/${c.id}`) }]));
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
---
<Base title="Join a meetup" lang="en"
  altPaths={{ zh: '/events/', ja: '/ja/events/', en: '/en/events/' }}
  description="Free matching meetups in Taipei, Taichung, Kaohsiung, Tokyo and Osaka, connecting Taiwanese talent with Japanese companies.">
  {eventsLd.map(ld => <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  <section class="page-head"><div class="wrap wrap--page">
    <h1 class="d1">Join a meetup</h1>
    <p class="lead"><span class="sent">Hear directly from Japanese companies about who they’re hiring — and from alumni about what the work is really like.</span></p>
    <p class="small since"><strong>{totalHeld}</strong> meetups held since {fmtSince(eventsMeta.since, 'en')},
      across {eventsMeta.cities.map(c => city(c)).map((c, i, a) => i === a.length - 1 && a.length > 1 ? `and ${c}` : c).join(', ').replace(', and ', ' and ')}.</p>
  </div></section>

  <section class="wrap wrap--page page-section" id="signup">
    <h2 class="d2">Next meetup</h2>
    {upcoming.length > 0
      ? <div class="upcoming-list">
          {upcoming.map(e => (
            <div class="card next">
              <div class="when">
                <span class="no">#{fmtEventNo(e.no, 'en')}</span>
                <span class="date">{fmt(e.date)}</span>
                <span class="tag area">{city(e.city)}</span>
              </div>
              <dl class="ev-meta">
                {e.sessions && <><dt>Sessions</dt><dd>{e.sessions.join(' / ')}</dd></>}
                {e.venue && <><dt>Venue</dt><dd lang="zh-Hant">{e.venue}{e.address && <span class="addr">({e.address})</span>}{e.address && <a class="map-link" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${e.venue} ${e.address}`)}`} target="_blank" rel="noopener">Open in Google Maps <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new window)</span></a>}</dd></>}
                <dt>Cost</dt><dd>Free</dd>
              </dl>
              {e.signupUrl
                ? <>
                    <a class="btn btn-primary" href={e.signupUrl} target="_blank" rel="noopener">Sign up via Google Form <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new window)</span></a>
                    <p class="small hint">Each meetup has its own form — please use this one.</p>
                    {e.sessions && e.sessions.length > 0 && (
                      <p class="small cal"><span>Add to Google Calendar:</span>{e.sessions.map(s => {
                        const u = gcalUrl(e, s, 'en', pageUrl);
                        return u && <a href={u} target="_blank" rel="noopener">{s.split(/[–-]/)[0].trim()} session <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new window)</span></a>;
                      })}</p>
                    )}
                  </>
                : <p class="small">Sign-up link coming soon.</p>}
            </div>
          ))}
        </div>
      : <div class="card next empty">
          <p><strong>Next date not announced yet.</strong></p>
          <p class="small">Dates are posted on Instagram 2–4 weeks ahead. The most recent meetup was #{fmtEventNo(past[0]?.no ?? '', 'en')} ({fmt(past[0]?.date)} · {city(past[0]?.city)}).</p>
          <a class="action-link ext" href="https://www.instagram.com/tw.tsunagu.jp/" target="_blank" rel="noopener">Follow us on Instagram <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new window)</span></a>
        </div>}
    <!-- 收藏的品牌（2026-10-11）：逛企業時按的愛心，在這裡提醒「交流會現場可以直接問」。沒有收藏就不出現 -->
    <div class="saved-box" data-saved-box data-saved-names={JSON.stringify(savedNames)} hidden>
      <p class="saved-ttl"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 20.3s-7.6-4.6-7.6-10.2A4.3 4.3 0 0 1 12 7.4a4.3 4.3 0 0 1 7.6 2.7c0 5.6-7.6 10.2-7.6 10.2z"/></svg>Your saved brands — ask about them at the meetup</p>
      <ul class="saved-list" data-saved-list></ul>
      <a class="action-link" href={l('/companies') + '?saved=1'}>View saved brands</a>
    </div>
  </section>

  <section class="wrap wrap--page page-section">
    <h2 class="d2">What happens at a meetup</h2>
    <ol class="flow">
      {flow.map((f, i) => (
        <li class="card step"><div class="no-badge" aria-hidden="true">{i + 1}</div><div><h3 class="d3">{f.t}</h3><p class="small">{f.d}</p></div></li>
      ))}
    </ol>
    <p class="small flow-more"><a href={l('/companies')}>See our partner brands</a> · <a href={l('/apply#photo')}>Resume photo tips</a> · <a href={l('/support')}>Full support details</a></p>
    <div class="note"><span class="sent"><strong>Everything is free.</strong> No participation or placement fees, ever, for participants from Taiwan.</span></div>
  </section>

  <section class="wrap wrap--page page-section">
    <h2 class="d2">Past meetups</h2>
    <p class="lead">The {past.length} most recent. Earlier ones are on <a href="https://www.instagram.com/tw.tsunagu.jp/" target="_blank" rel="noopener">Instagram <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new window)</span></a>.</p>
    <ul class="hist rows">
      {past.map(e => (
        <li class="row h">
          <span class="d">#{fmtEventNo(e.no, 'en')}</span>
          <span class="date">{fmt(e.date)}</span>
          <span class="tag area">{city(e.city)}</span>
          {e.ig && <a class="small ig" href={`https://www.instagram.com/p/${e.ig}/`} target="_blank" rel="noopener"><span class="sr-only">#{fmtEventNo(e.no, 'en')} </span>Recap <span lang="ja">(開催報告)</span> <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new window)</span></a>}
        </li>
      ))}
    </ul>
    <p class="small backtop"><a href="#signup"><span aria-hidden="true">↑</span> Back to sign-up</a></p>
  </section>
</Base>
