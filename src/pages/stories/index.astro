---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const stories = (await getCollection('stories')).sort((a,b)=>a.data.order-b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const brands = [...new Set(stories.map(s=>s.data.company))];
---
<Base title="學長姐經驗" description="透過 Tsunagu 到日本工作的台灣前輩，他們在哪裡、做什麼、學到什麼。">
  <section class="head"><div class="wrap">
    <p class="eyebrow">Stories</p>
    <h1 class="d1">學長姐現在在日本</h1>
    <p class="lead">
      他們也曾經只是「想去日本看看」。以下是 {stories.length} 位前輩的分享，
      涵蓋 {brands.length} 個品牌，從打工度假、留學到交換學生都有。
    </p>
    <div class="note">
      內容摘自 Tsunagu Instagram 上前輩們的原文分享，每篇都附原文連結。
      <span class="pending">【待確認】以本人名義轉載到官網，是否需要另外取得同意。</span>
    </div>
  </div></section>

  <section class="wrap list">
    {stories.map(s => (
      <article class="card item" id={s.id} tabindex="-1" aria-labelledby={`${s.id}-title`}>
        <header class="top">
          <div class="avatar" aria-hidden="true">{s.data.name.slice(0,1)}</div>
          <div>
            <h2 class="d3" id={`${s.id}-title`} lang="ja">{s.data.name}</h2>
            <p class="meta small">
              <span class="tag">{s.data.visa}</span>
              <span>{s.data.started} 起</span>
              <span class="sep">·</span>
              <strong>{s.data.company}</strong>
              <span class="sep">·</span>
              <span>{s.data.location}</span>
            </p>
          </div>
        </header>

        <p class="lead-q">{s.data.lead}</p>

        {s.data.messages.length > 0 && (
          <ul class="msgs">{s.data.messages.map(m => <li>{m}</li>)}</ul>
        )}

        {s.data.advice.length > 0 && (
          <div class="advice">
            <h3>給後輩的建議</h3>
            <ol>{s.data.advice.map(a => <li>{a}</li>)}</ol>
          </div>
        )}

        <a class="src small" href={`https://www.instagram.com/p/${s.data.igCode}/`} target="_blank" rel="noopener">
          讀 Instagram 原文（{s.data.igPosted}）↗
        </a>
      </article>
    ))}
  </section>

  <section class="wrap cta">
    <div class="band">
      <h2 class="d2">下一個換你</h2>
      <p class="lead">他們每個人都是從一場交流會開始的。</p>
      <a class="btn btn-primary" href={`${base}/events`}>報名交流會</a>
    </div>
  </section>
</Base>
<style>
  .head{background:linear-gradient(165deg,var(--sky-50),var(--cream));padding:64px 0 48px;border-bottom:1px solid var(--line)}
  .head .wrap{max-width:868px}
  .head .note{margin-top:22px}
  .pending{background:var(--note-bg);padding:2px 8px;border-radius:4px;color:var(--ink-900)}
  .list{margin-top:36px;display:flex;flex-direction:column;gap:18px;max-width:868px}
  .item{padding:26px 28px;scroll-margin-top:92px}
  .item:target{border-color:var(--pink-300);box-shadow:var(--sh-3)}
  .top{display:flex;gap:16px;align-items:center;margin-bottom:16px}
  .avatar{width:56px;height:56px;flex:0 0 56px;border-radius:var(--r-full);
    border:2.5px solid transparent;
    background:linear-gradient(140deg,var(--pink-100),var(--sky-100)) padding-box,
      linear-gradient(135deg,var(--pink-400),var(--sky-300)) border-box;display:flex;
    align-items:center;justify-content:center;color:var(--ink-900);font-weight:700;font-family:var(--f-latin);font-size:22px}
  .meta{margin:5px 0 0;display:flex;flex-wrap:wrap;gap:6px 9px;align-items:center;color:var(--ink-600)}
  .meta .sep{color:var(--ink-400)}
  .lead-q{font-family:var(--f-display);font-size:17px;font-weight:700;line-height:1.7;
    margin:0 0 16px;padding-left:16px;border-left:3px solid var(--pink-200)} /* impeccable-disable-line side-tab -- 引文標記，非卡片邊框 */
  .msgs{list-style:none;padding:0;margin:0 0 4px}
  .msgs li{position:relative;padding-left:20px;margin-bottom:9px;font-size:15px;line-height:1.9;color:var(--ink-600)}
  .msgs li::before{content:'';position:absolute;left:4px;top:12px;width:6px;height:6px;
    border-radius:50%;background:var(--sky-200)}
  .advice{margin-top:18px;background:var(--pink-50);border-radius:var(--r-md);padding:16px 20px}
  .advice h3{font-size:12px;letter-spacing:.1em;color:var(--pink-700);margin-bottom:10px}
  .advice ol{margin:0;padding-left:1.3em}
  .advice li{font-size:14.5px;line-height:1.85;margin-bottom:6px;color:var(--ink-900)}
  .src{display:inline-block;margin-top:16px;color:var(--sky-700);text-decoration:none;font-weight:500}
  .src:hover{text-decoration:underline}
  .cta{max-width:868px;margin-top:36px}
  .band{background:linear-gradient(120deg,var(--pink-50),var(--sky-50));border-radius:var(--r-xl);
    padding:40px 36px;text-align:center}
  .band .lead{margin:8px auto 20px}
  @media (max-width:720px){
    .head{background:#fff;padding:24px 0;border-bottom-color:var(--mobile-line)}
    .head .d1{font-size:24px;line-height:1.4;letter-spacing:.035em}
    .head .lead{margin-top:12px}
    .head .note{margin-top:16px}
    .list{margin-top:24px;gap:12px}
    .item{padding:18px 16px;scroll-margin-top:calc(var(--header-height) + 16px)}
    .item:target{border-color:var(--pink-300);box-shadow:none;outline:2px solid var(--pink-200);outline-offset:2px}
    .top{gap:12px;align-items:flex-start}
    .avatar{width:48px;height:48px;flex-basis:48px;font-size:19px}
    .lead-q{font-size:16px;padding-left:12px;margin-bottom:14px}
    .msgs li{font-size:14px;line-height:1.8;margin-bottom:8px}
    .advice{margin-top:16px;padding:14px 16px}
    .advice li{font-size:14px;line-height:1.8}
    .cta{margin-top:var(--content-section-gap)}
    .band{background:#FAFAFA;border:1px solid var(--mobile-line);border-radius:12px;padding:24px 18px}
    .band .btn{width:auto}
  }
</style>
<script>
  const focusStoryTarget = () => {
    let id = '';
    try {
      id = decodeURIComponent(window.location.hash.slice(1));
    } catch {
      return;
    }
    const target = id ? document.getElementById(id) : null;
    if (!(target instanceof HTMLElement) || !target.classList.contains('item')) return;
    requestAnimationFrame(() => {
      target.scrollIntoView({ block:'start' });
      target.focus({ preventScroll:true });
    });
  };
  focusStoryTarget();
  window.addEventListener('hashchange', focusStoryTarget);
</script>
