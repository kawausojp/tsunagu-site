---
// 前輩分享列表（2026-10-25 網誌化改版）：一人一篇文章頁，這裡是目錄（第一篇放大＋一列一篇）。
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import NextEvent from '../../components/NextEvent.astro';
import { buildFeed } from '../../lib/site';
import '../../styles/page-stories.css';
const stories = await getCollection('stories');
const items = buildFeed(stories, 'zh').filter(i => i.kind === 'story');
const brands = new Set(stories.map(s => s.data.company)).size;
---
<Base title="前輩分享" altPaths={{ zh: '/stories/', ja: '/ja/stories/' }} description="透過 Tsunagu 到日本工作的台灣前輩，他們在哪裡、做什麼、學到什麼。全文刊載 Instagram 原文。">
  <section class="page-head"><div class="wrap wrap--page">
    <h1 class="d1">前輩分享</h1>
    <p class="lead"><span class="sent">他們也曾經只是「想去日本看看」。</span><span class="sent">{stories.length} 位前輩、{brands} 個品牌，從打工度假、留學到交換留學都有。</span></p>
    <div class="note"><span class="sent">每一篇都是 Tsunagu Instagram 上的前輩原文，一字未改，並附原文連結。</span>
      {/* 內部待辦（勿放回畫面）：轉載是否需另取得本人同意，見 CLAUDE.md */}
    </div>
  </div></section>
  <section class="wrap wrap--page page-section st-list" aria-label="前輩分享列表">
    <PostList items={items} lang="zh" tabs={false} />
  </section>
  <section class="wrap wrap--page page-section"><NextEvent lang="zh" variant="mini" /></section>
  <!-- 舊網址 /stories/#an（改版前同一頁的錨點）→ 轉到該篇文章頁 -->
  <script is:inline>
    (() => { const id = decodeURIComponent(location.hash.slice(1)); if (/^[\w-]+$/.test(id) && document.querySelector(`[data-story="${id}"]`)) location.replace(`./${id}/`); })();
  </script>
</Base>
