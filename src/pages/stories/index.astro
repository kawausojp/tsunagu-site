---
import { getCollection } from 'astro:content';
import SenpaiAvatar from '../../components/SenpaiAvatar.astro';
import { matchCompanyId, signupCta, fmtDate } from '../../lib/site';
import Base from '../../layouts/Base.astro';
import '../../styles/page-stories.css';
const stories = (await getCollection('stories')).sort((a,b)=>a.data.order-b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const brands = [...new Set(stories.map(s=>s.data.company))];
const companiesAll = (await getCollection('companies')).map(c => ({ id: c.id, name: c.data.name }));
const companyHref = new Map(stories.map(s => {
  const id = matchCompanyId(s.data.company, companiesAll);
  return [s.id, id ? `${base}/companies/${id}` : null];
}));
---
<Base title="學長姐經驗" altPaths={{ zh: '/stories/', ja: '/ja/stories/', en: '/en/stories/' }} description="透過 Tsunagu 到日本工作的台灣學長姐，他們在哪裡、做什麼、學到什麼。">
  <section class="page-head"><div class="wrap wrap--reading">
    <h1 class="d1">學長姐現在在日本</h1>
    <p class="lead"><span class="sent">他們也曾經只是「想去日本看看」。</span><span class="sent">以下是 {stories.length} 位學長姐的分享，涵蓋 {brands.length} 個品牌，從打工度假、留學到交換留學都有。</span></p>
    <div class="note"><span class="sent">內容摘自 Tsunagu Instagram 上學長姐的原文分享，每篇都附原文連結。</span>
      {/* 內部待辦（勿放回畫面）：轉載是否需另取得本人同意，見 CLAUDE.md */}
    </div>
  </div></section>

  <nav class="wrap wrap--reading jump" id="stories-jump" aria-label="直接跳到某位學長姐">
    {stories.map(s => (
      <a class="jump-chip" href={`#${s.id}`}>
        <span class="jump-ava"><SenpaiAvatar name={s.data.name} size={26} /></span>
        <span class="jump-txt"><span lang="ja">{s.data.name}</span><span class="jump-sub">{s.data.company}</span></span>
      </a>
    ))}
  </nav>

  <section class="wrap wrap--reading list">
    {stories.map(s => (
      <article class="card item" id={s.id} tabindex="-1" aria-labelledby={`${s.id}-title`}>
        <header class="top">
          <div class="avatar"><SenpaiAvatar name={s.data.name} size={56} /></div>
          <div>
            <h2 class="d3" id={`${s.id}-title`}><span lang="ja">{s.data.name}</span><span class="sr-only">｜{s.data.company}（{s.data.visa}）</span></h2>
            <p class="meta small">
              <span class="tag">{s.data.visa}</span>
              <span>{s.data.started} 起</span>
              <span class="pair"><span class="sep">·</span>{companyHref.get(s.id)
                ? <a class="co-link" href={companyHref.get(s.id)}><strong>{s.data.company}</strong></a>
                : <strong>{s.data.company}</strong>}</span>
              <span class="pair"><span class="sep">·</span><span>{s.data.location}</span></span>
            </p>
          </div>
        </header>

        <p class="lead-q quote">{s.data.lead}</p>

        {s.data.messages.length > 0 && (
          <h3 class="sr-only">分享內容</h3>
          <ul class="msgs">{s.data.messages.map(m => <li>{m}</li>)}</ul>
        )}

        {s.data.advice.length > 0 && (
          <div class="advice">
            <h3>給後輩的建議</h3>
            <ol>{s.data.advice.map(a => <li>{a}</li>)}</ol>
          </div>
        )}

        <div class="item-foot">
          <a class="src small" href={`https://www.instagram.com/p/${s.data.igCode}/`} target="_blank" rel="noopener">
            <span>讀 Instagram 原文<span class="nowrap">（{fmtDate(s.data.igPosted)}）<span aria-hidden="true">↗</span></span><span class="sr-only">（另開新視窗）</span></span>
          </a>
          <a class="backlist small" href="#stories-jump"><span aria-hidden="true">↑</span> 看其他學長姐</a>
        </div>
      </article>
    ))}
  </section>

  <section class="wrap wrap--reading cta">
    <div class="cta-band cta-box">
      <h2 class="d2">下一個換你</h2>
      <p class="lead">他們每個人都是從一場交流會開始的。</p>
      <a class="btn btn-primary" href={`${base}/events`}>{signupCta('zh')}</a>
    </div>
  </section>
</Base>
<script>
  const focusStoryTarget = () => {
    let id = '';
    try {
      id = decodeURIComponent(window.location.hash.slice(1));
    } catch {
      return;
    }
    const target = id ? document.getElementById(id) : null;
    if (!(target instanceof HTMLElement) || !target.classList.contains('item')) return;
    requestAnimationFrame(() => {
      target.scrollIntoView({ block:'start' });
      target.focus({ preventScroll:true });
    });
  };
  focusStoryTarget();
  window.addEventListener('hashchange', focusStoryTarget);
</script>

<script>import '../../scripts/jump-focus.ts';</script>
