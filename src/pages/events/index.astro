---
import Base from '../../layouts/Base.astro';
import '../../styles/page-events.css';
import { todayTaipei, fmtEventDate, fmtEventNo, fmtSince, eventLd, totalHeld, eventsMeta } from '../../lib/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const today = todayTaipei();
const sorted = [...eventsMeta.events].sort((a, b) => b.date.localeCompare(a.date));
const upcoming = sorted.filter(e => e.date >= today).reverse();
const past = sorted.filter(e => e.date < today);

// Event 結構化資料：site.ts eventLd()（三語共用）
const eventsLd = upcoming.filter(e => e.venue && e.address).map(eventLd);
const fmt = (d: string) => `${d.slice(0, 4)}/${fmtEventDate(d, 'zh')}`;

const flow = [
  { t:'當天現場', d:'日本企業介紹他們在找什麼樣的人，學長姐分享在日本工作的實際情況。' },
  { t:'個別面談', d:'聊聊你的日語程度、想做什麼、什麼時候去。' },
  { t:'之後的每一步', d:'履歷、面試練習、簽證、抵日後追蹤——我們陪你走到底。' },
];
---
<Base title="交流會場次與報名" altPaths={{ zh: '/events/', ja: '/ja/events/', en: '/en/events/' }} description="Tsunagu 交流會，台北・台中・高雄・東京・大阪輪流舉辦，參加免費。">
  {eventsLd.map(ld => <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  <section class="page-head"><div class="wrap wrap--reading">
    <h1 class="d1">來交流會看看</h1>
    <p class="lead">聽日本企業說他們在找什麼樣的人，也聽已經在日本的學長姐分享第一手經驗。</p>
    <p class="small since">自 {fmtSince(eventsMeta.since, 'zh')}起累計舉辦 <strong>{totalHeld}</strong> 場，
      地點涵蓋{eventsMeta.cities.map((c: string, i: number) => (<span>{c}{i < eventsMeta.cities.length - 1 ? '、' : ''}</span>))}。</p>
  </div></section>

  <section class="wrap wrap--reading page-section" id="signup">
    <h2 class="d2">下一場</h2>
    {upcoming.length > 0
      ? <div class="upcoming-list">
          {upcoming.map(e => (
            <div class="card next">
              <div class="when">
                <span class="no">第 {fmtEventNo(e.no, 'zh')} 回</span>
                <span class="date">{fmt(e.date)}</span>
                <span class="tag area">{e.city}</span>
              </div>
              <dl class="ev-meta">
                {e.sessions && <><dt>場次</dt><dd>{e.sessions.join('　／　')}</dd></>}
                {e.venue && <><dt>地點</dt><dd>{e.venue}{e.address && <span class="addr">（{e.address}）</span>}{e.address && <a class="map-link" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${e.venue} ${e.address}`)}`} target="_blank" rel="noopener">在 Google 地圖開啟 <span aria-hidden="true">↗</span><span class="sr-only">（另開新視窗）</span></a>}</dd></>}
                <dt>費用</dt><dd>免費</dd>
              </dl>
              {e.signupUrl
                ? <>
                    <a class="btn btn-primary" href={e.signupUrl} target="_blank" rel="noopener">前往 Google 表單報名 <span aria-hidden="true">↗</span><span class="sr-only">（另開新視窗）</span></a>
                    <p class="small hint">每場表單不同，請用本場專用表單。</p>
                  </>
                : <p class="small">報名連結待公布。</p>}
            </div>
          ))}
        </div>
      : <div class="card next empty">
          <p><strong>下一場尚未公布。</strong></p>
          <p class="small">場次通常提前 2–4 週在 Instagram 公告。最近一場是第 {fmtEventNo(past[0]?.no ?? '', 'zh')} 回（{fmt(past[0]?.date)}・{past[0]?.city}）。</p>
          <a class="action-link ext" href="https://www.instagram.com/tw.tsunagu.jp/" target="_blank" rel="noopener">追蹤 IG 接收場次通知 <span aria-hidden="true">↗</span><span class="sr-only">（另開新視窗）</span></a>
        </div>}
  </section>

  <section class="wrap wrap--reading page-section">
    <h2 class="d2">交流會當天會發生什麼</h2>
    <ol class="flow">
      {flow.map((f,i) => (
        <li class="card step"><div class="no-badge" aria-hidden="true">{i+1}</div><div><h3 class="d3">{f.t}</h3><p class="small">{f.d}</p></div></li>
      ))}
    </ol>
    <p class="small flow-more"><a href={`${base}/companies`}>先看看有哪些合作企業</a>・<a href={`${base}/apply#photo`}>履歷照片怎麼拍</a>・<a href={`${base}/support`}>完整的支援內容</a></p>
    <div class="note"><strong>全部免費。</strong>參加與媒合都不收費，細節見「我們怎麼幫你」。</div>
  </section>

  <section class="wrap wrap--reading page-section">
    <h2 class="d2">舉辦紀錄</h2>
    <p class="lead">最近 {past.length} 場的舉辦紀錄。更早的在 <a href="https://www.instagram.com/tw.tsunagu.jp/" target="_blank" rel="noopener">Instagram <span aria-hidden="true">↗</span><span class="sr-only">（另開新視窗）</span></a>。</p>
    <ul class="hist rows">
      {past.map(e => (
        <li class="row h">
          <span class="d">第 {fmtEventNo(e.no, 'zh')} 回</span>
          <span class="date">{fmt(e.date)}</span>
          <span class="tag area">{e.city}</span>
          {e.ig && <a class="small ig" href={`https://www.instagram.com/p/${e.ig}/`} target="_blank" rel="noopener"><span class="sr-only">第 {fmtEventNo(e.no, 'zh')} 回</span><span lang="ja">開催報告</span> <span aria-hidden="true">↗</span><span class="sr-only">（另開新視窗）</span></a>}
        </li>
      ))}
    </ul>
    <p class="small backtop"><a href="#signup"><span aria-hidden="true">↑</span> 回到本頁報名下一場</a></p>
  </section>
</Base>
