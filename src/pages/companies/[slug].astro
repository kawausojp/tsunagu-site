---
import { getCollection, render } from 'astro:content';
import { dedupHighlights, fmtSourceDeck, relatedStoriesFor, signupCta, nameLang, SKY_CATEGORIES, JOIN_STEPS, sentences, relatedBrands } from '../../lib/site';
import { ui } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import CompanyCard from '../../components/CompanyCard.astro';
import SenpaiAvatar from '../../components/SenpaiAvatar.astro';
import '../../styles/page-company.css';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  return companies.map(c => ({ params: { slug: c.id }, props: { c } }));
}
const { c } = Astro.props;
const d = c.data;
const { Content } = await render(c);
// 在這個品牌工作過的學長姐（company 名寬鬆比對；資料本來就在庫裡，接上而已）
const allStories = await getCollection('stories');
const allCompanies = await getCollection('companies');
const companiesCount = allCompanies.length;
const moreBrands = relatedBrands(c, allCompanies);
const relatedStories = relatedStoriesFor(d.name, allStories);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const AREA = ui['zh'].area;
const hl = dedupHighlights(d.highlights, d.placements);
---
<Base title={`${d.name} 赴日工作介紹`}
  altPaths={{ zh: `/companies/${c.id}/`, ja: `/ja/companies/${c.id}/`, en: `/en/companies/${c.id}/` }}
  description={`${d.name}（${d.categoryLabel}）的品牌介紹與台灣人任職實績${d.placements > 0 ? `：累計 ${d.placements} 人透過 Tsunagu 任職` : ''}。詳情請參加免費交流會。`}>
  <article>
    <div class="page-head hero">
      <div class="wrap wrap--page">
        <a class="back" data-back-list href={`${base}/companies`}><span aria-hidden="true">←</span> 回合作企業</a>
        <!-- 頁首兩欄（2026-10-04）：左＝品類圖標＋品牌名＋登記名、tagline、標籤；右＝實績數字（原本在內文最下方的磁磚）。
             圖標與品牌名跟企業卡同名（view-transition-name），從列表點進來會連續變形到這裡 -->
        <div class="b-head">
          <div class="b-id">
            <div class="b-name">
              <span class="b-ico" data-tone={SKY_CATEGORIES.has(d.category) ? 'sky' : 'pink'} style={`view-transition-name:ico-${c.id}`}><CategoryIcon cat={d.category} size={36} /></span>
              <div class="b-ttl">
                <h1 class="d1" data-vt style={`view-transition-name:nm-${c.id}`} lang={nameLang(d.name, 'zh')}>{d.name}</h1>
                {d.corporateName && <p class="corp" lang="ja">{d.corporateName}</p>}
              </div>
            </div>
            <p class="lead">{d.tagline}</p>
            <div class="tags">
              {d.areas.map((a:string) => <span class="tag area">{AREA[a as keyof typeof AREA]}</span>)}
              <span class="tag job">{d.categoryLabel}</span>
              {d.jlpt && <span class="tag jlpt">{d.jlpt} 以上</span>}
              {d.onlineInterview && <span class="tag">可線上面試</span>}
            </div>
            <!-- 收藏與分享（2026-10-11）：收藏存在訪客瀏覽器（save.js）；分享在手機叫出系統分享，桌機複製連結 -->
            <div class="b-actions">
              <button type="button" class="b-act" data-save={c.id} aria-pressed="false"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 20.3s-7.6-4.6-7.6-10.2A4.3 4.3 0 0 1 12 7.4a4.3 4.3 0 0 1 7.6 2.7c0 5.6-7.6 10.2-7.6 10.2z"/></svg><span class="off">收藏</span><span class="on">已收藏</span></button>
              <button type="button" class="b-act" data-share data-copied="已複製連結"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 15V4M7.5 8.5 12 4l4.5 4.5M5 13.5V19h14v-5.5"/></svg><span data-share-label>分享</span></button>
            </div>
          </div>
          {(d.placements > 0 || d.fullTimeConverted > 0) && (
            <dl class="b-figs">
              {d.placements > 0 && <div><dt>累計台灣夥伴任職</dt><dd class="n">{d.placements}<small>人</small></dd></div>}
              {d.fullTimeConverted > 0 && <div><dt>其中轉為正職</dt><dd class="n">{d.fullTimeConverted}<small>人</small></dd></div>}
            </dl>
          )}
        </div>
      </div>
    </div>

    <div class="wrap wrap--page page-section body">
      <div class="prose"><Content /></div>

      {hl.length > 0 && (
        <div class="card hl">
          <h2 class="d3">重點</h2>
          <ul>{hl.map((h:string) => <li>{h}</li>)}</ul>
        </div>
      )}

      <div class="note">
        <span class="sent"><strong>資料來源：</strong>{fmtSourceDeck('zh', d.sourceSlide)}。</span><span class="sent">招募條件與職缺狀態會變動，請以交流會現場或個別諮詢的說明為準。</span>
      </div>

      <!-- 學長姐卡片（2026-10-11，參考 Wantedly 成員、WTTJ「Meet ○○」）：頭像＋IG 原文引言，原文不改 -->
      {relatedStories.length > 0 && (
        <section class="voices">
          <h2 class="d3">在這裡工作過的學長姐</h2>
          <div class="voice-cards">
            {relatedStories.map(st => (
              <a class="card v-card" href={`${base}/stories#${st.id}`}>
                <span class="v-ava"><SenpaiAvatar name={st.data.name} size={56} /></span>
                <span class="v-body">
                  <span class="v-who"><span class="v-name" lang="ja">{st.data.name}</span><span class="v-meta small">{st.data.visa}・{st.data.location}</span></span>
                  <span class="quote v-lead" lang="zh-Hant">{sentences(st.data.lead).map((t, i) => <>{i > 0 && <br />}{t}</>)}</span>
                  <span class="action-link">看完整分享</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      )}
      <!-- 想在這裡工作？（2026-10-11，參考 Cake 的 Step 1→3）：文字與 /events 同一份（site.ts JOIN_STEPS） -->
      <section class="join">
        <h2 class="d2">想在 {d.name} 工作？</h2>
        <ol class="join-steps">
          {JOIN_STEPS.zh.map((st, i) => (
            <li><span class="no-badge" aria-hidden="true">{i + 1}</span><span><span class="j-t">{st.t}</span><span class="small">{st.d}</span></span></li>
          ))}
        </ol>
      <div class="cta-row cta">
        <a class="btn btn-primary" href={`${base}/events`}>{signupCta('zh')}，現場問清楚</a>
        <a class="action-link" href={`${base}/companies`}>看全部 {companiesCount} 個合作品牌</a>
      </div>
      </section>
    </div>
  </article>
  <!-- 也看看這些品牌（2026-10-11，參考 104「這些工作也很適合你」）：淺藍底＝企業卡區（同 /companies） -->
  {moreBrands.length > 0 && (
    <section class="more-brands">
      <div class="wrap wrap--page">
        <h2 class="d3">也看看這些品牌</h2>
        <div class="more-grid">
          {moreBrands.map(r => <CompanyCard c={r} href={`${base}/companies/${r.id}`} lang="zh" />)}
        </div>
      </div>
    </section>
  )}
</Base>
<script>import '../../scripts/back-to-list.ts';</script>
