---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  return companies.map(c => ({ params: { slug: c.id }, props: { c } }));
}
const { c } = Astro.props;
const d = c.data;
const { Content } = await render(c);
// 在這個品牌工作過的學長姐（company 名寬鬆比對；資料本來就在庫裡，接上而已）
const allStories = await getCollection('stories');
const norm = (x: string) => x.normalize('NFKC').toLowerCase().replace(/[^a-z0-9\u3040-\u30ff\u4e00-\u9fff]/g, '');
const dn = norm(d.name);
const relatedStories = allStories.filter(st => {
  const sn = norm(st.data.company);
  if (sn.length < 2) return false;
  // 前綴比對而非子字串：避免 "ete" 誤配 "agete"；另取空格前第一段處理 "MUK ムカイ" → MUKAI
  const snFirst = norm(st.data.company.split(/[\s/]/)[0]);
  return sn === dn || dn.startsWith(sn) || sn.startsWith(dn) || (snFirst.length > 2 && dn.startsWith(snFirst));
}).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const AREA = { tokyo:'東京', osaka:'大阪', kyoto:'京都', fukuoka:'福岡', kobe:'神戶', hokkaido:'北海道' };
---
<Base title={`${d.name} 赴日工作介紹`}
  description={`${d.name}（${d.categoryLabel}）的品牌介紹與台灣人任職實績${d.placements > 0 ? `：累計 ${d.placements} 人透過 Tsunagu 任職` : ''}。詳情請參加免費交流會。`}>
  <article>
    <div class="hero">
      <div class="wrap">
        <a class="back" href={`${base}/companies`}>← 回合作企業</a>
        <h1 class="d1">{d.name}</h1>
        {d.corporateName && <p class="corp" lang="ja">{d.corporateName}</p>}
        <p class="lead">{d.tagline}</p>
        <div class="tags">
          {d.areas.map((a:string) => <span class="tag area">{AREA[a as keyof typeof AREA]}</span>)}
          <span class="tag job">{d.categoryLabel}</span>
          {d.jlpt && <span class="tag jlpt">{d.jlpt} 以上</span>}
          {d.onlineInterview && <span class="tag">可線上面試</span>}
        </div>
      </div>
    </div>

    <div class="wrap body">
      <div class="prose"><Content /></div>

      {d.highlights.length > 0 && (
        <div class="hl">
          <h2 class="d3">重點</h2>
          <ul>{d.highlights.map((h:string) => <li>{h}</li>)}</ul>
        </div>
      )}

      {(d.placements > 0 || d.fullTimeConverted > 0) && (
        <div class="numbers">
          {d.placements > 0 && <div><div class="n">{d.placements}</div><div class="t">累計台灣夥伴任職</div></div>}
          {d.fullTimeConverted > 0 && <div><div class="n">{d.fullTimeConverted}</div><div class="t">其中轉為正社員</div></div>}
        </div>
      )}

      <div class="note">
        <strong>資料來源：</strong>《第76,77回 台北交流会スライド 2026.4.18》{d.sourceSlide && `第 ${d.sourceSlide} 頁`}。
        招募條件與職缺狀態會變動，請以交流會現場或個別諮詢的說明為準。
      </div>

            {relatedStories.length > 0 && (
        <div class="related">
          <h2 class="d3">在這裡工作過的學長姐</h2>
          {relatedStories.map(st => (
            <a class="rel-link" href={`${base}/stories#${st.id}`}><span lang="ja">{st.data.name}</span>（{st.data.visa}）的分享 →</a>
          ))}
        </div>
      )}
<div class="cta">
        <a class="btn btn-primary" href={`${base}/events`}>報名交流會，現場問清楚</a>
        <a class="btn btn-ghost text-action" href={`${base}/companies`}>看全部 35 家合作品牌 →</a>
      </div>
    </div>
  </article>
</Base>

<style>
  .hero{background:var(--cream);padding:40px 0 44px;border-bottom:1px solid var(--line)}
  .hero .wrap{max-width:808px}
  .back{display:inline-block;font-size:13.5px;color:var(--ink-600);text-decoration:none;margin-bottom:18px}
  .back:hover{color:var(--pink-700)}
  .corp{font-size:14px;color:var(--ink-600);margin:6px 0 12px}
  .hero .tags{margin-top:18px}
  .body{max-width:808px;padding-top:44px;padding-bottom:20px}
  .prose{font-size:17px;line-height:1.95}
  .hl{margin-top:32px;background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:22px 26px}
  .hl ul{margin:12px 0 0;padding-left:1.25em}
  .hl li{margin-bottom:6px;font-size:15px}
  .numbers{display:flex;gap:16px;flex-wrap:wrap;margin-top:24px}
  .numbers > div{flex:1 1 180px;background:linear-gradient(120deg,var(--pink-50),var(--sky-50));
    border-radius:var(--r-lg);padding:22px;text-align:center}
  .numbers .n{font-family:var(--f-latin);font-weight:700;font-size:38px;color:var(--pink-700);line-height:1.1}
  .numbers .t{font-size:13px;color:var(--ink-600);margin-top:4px}
  .note{margin-top:28px}
  .cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:36px}
  @media (max-width:720px){
    .hero{background:#fff;padding:20px 0 24px;border-bottom-color:var(--mobile-line)}
    .back{margin-bottom:14px}
    .hero h1{font-size:clamp(25px,8vw,30px);line-height:1.4;letter-spacing:.025em;overflow-wrap:anywhere}
    .corp{margin:5px 0 10px}
    .hero .lead{margin-top:8px}
    .hero .tags{margin-top:14px;gap:6px}
    .body{padding-top:32px;padding-bottom:8px}
    .prose{font-size:15.5px;line-height:1.85}
    .hl{margin-top:26px;border-color:var(--mobile-line);border-radius:12px;padding:18px 16px}
    .hl ul{margin-top:10px}
    .hl li{font-size:14px;line-height:1.8}
    .numbers{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-top:20px}
    .numbers>div{padding:16px 10px;background:#fff;border:1px solid var(--mobile-line);border-radius:12px}
    .numbers .n{font-size:32px}
    .note{margin-top:22px}
    .cta{flex-direction:column;align-items:flex-start;gap:6px;margin-top:28px}
  }
  .related{margin:26px 0 6px}
  .related :global(.d3){margin-bottom:8px}
  .rel-link{display:block;padding:6px 0;color:var(--sky-700);text-decoration:none}
  .rel-link:hover{text-decoration:underline}
</style>
