---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import characters from '../assets/tsunagu-characters.png';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="找不到這一頁">
  <section class="nf"><div class="wrap">
    <Image src={characters} alt="" widths={[260, 520]} sizes="260px" class="nf-chars" />
    <h1 class="d1">走丟了</h1>
    <p class="lead">這一頁不在。要不要回首頁看看？</p>
    <a class="btn btn-primary" href={`${base}/`}>回首頁</a>
  </div></section>
</Base>
<style>
  .nf{text-align:center;padding:120px 0}
  .nf :global(.nf-chars){width:min(260px,70vw);height:auto;margin:0 auto 28px;display:block}
  .nf .lead{margin:0 auto 24px}
</style>
