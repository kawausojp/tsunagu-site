---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import '../../../styles/page-companies.css';
import CompanyCard from '../../../components/CompanyCard.astro';

import { href } from '../../../i18n/ui';
import { CAT_LABEL, CITY } from '../../../lib/site';
const l = (p: string) => href('ja', p);
const companies = (await getCollection('companies'))
  .sort((a, b) => b.data.placements - a.data.placements || a.data.name.localeCompare(b.data.name));

const AREA: Record<string,string> = { tokyo:'東京', osaka:'大阪', kyoto:'京都', fukuoka:'福岡', kobe:'神戸', hokkaido:'北海道' };
const areaKeys = Object.keys(AREA).filter(k => companies.some(c => c.data.areas.includes(k as any)));
const cats = [...new Map(companies.map(c => [c.data.category, CAT_LABEL.ja[c.data.category] ?? c.data.categoryLabel])).entries()];
const jlpts = ['N2','N3'].filter(j => companies.some(c => c.data.jlpt === j));
const totalPlacements = companies.reduce((s,c)=>s+c.data.placements,0);
---
<Base title="提携企業" lang="ja" altPaths={{ zh: '/companies/', ja: '/ja/companies/', en: '/en/companies/' }} description="ツナグ提携の日本企業・ブランド一覧。エリア・職種・日本語レベルで絞り込めます。">
  <section class="page-head">
    <div class="wrap wrap--page">
      <h1 class="d1">提携企業</h1>
      <p class="lead">
        公開中の {companies.length} ブランド（契約企業 39 社）。
        いずれも中国語の求人サイトには掲載されない店舗ばかりです。
      </p>
      <div class="notice">
        <strong>募集状況について：</strong>掲載しているのはブランド紹介と勤務実績であり、リアルタイムの求人情報ではありません。募集内容・条件は交流会または個別相談でご確認ください。
      </div>
    </div>
  </section>

  <div class="wrap tools">
    <div class="filters">
      <label class="search">
        <span>ブランド検索</span>
        <input type="search" inputmode="search" autocomplete="off" placeholder="ブランド名を入力"
          aria-controls="company-grid" data-search-input />
      </label>
      <details class="filter-options" data-filter-options open>
        <summary>絞り込み</summary>
        <div class="filter-groups">
          <div class="grp" role="group" aria-labelledby="filter-area-label">
            <span class="lbl" id="filter-area-label">エリア</span>
            {areaKeys.map(k => <button type="button" class="tag area f" data-f="area" data-v={k}
              aria-pressed="false" aria-controls="company-grid">{AREA[k]}</button>)}
          </div>
          <div class="grp" role="group" aria-labelledby="filter-cat-label">
            <span class="lbl" id="filter-cat-label">職種</span>
            {cats.map(([k,l]) => <button type="button" class="tag job f" data-f="cat" data-v={k}
              aria-pressed="false" aria-controls="company-grid">{l}</button>)}
          </div>
          <div class="grp" role="group" aria-labelledby="filter-jlpt-label">
            <span class="lbl" id="filter-jlpt-label">日本語</span>
            {jlpts.map(j => <button type="button" class="tag jlpt f" data-f="jlpt" data-v={j}
              aria-pressed="false" aria-controls="company-grid">{j} 以上</button>)}
            <button type="button" class="tag f" data-f="jlpt" data-v="none"
              aria-pressed="false" aria-controls="company-grid">特に不問</button>
          </div>
        </div>
      </details>
      <button type="button" class="reset" data-reset hidden>検索・絞り込みをクリア</button>
    </div>
    <p class="count small"><span role="status" aria-live="polite" aria-atomic="true"
      data-status>{companies.length} ブランドを表示中</span><span aria-hidden="true">／掲載ブランド合計 {totalPlacements} 名の勤務実績</span></p>
  </div>

  <section class="wrap list">
    <h2 class="sr-only">検索結果</h2>
    <div class="grid" id="company-grid" data-grid>
      {companies.map(c => <CompanyCard c={c} href={l(`/companies/${c.id}`)} lang="ja" />)}
    </div>
    <p class="empty small" data-empty hidden>条件に合うブランドがありません。絞り込みを緩めてみてください。</p>
  </section>
</Base>


<script>
  const active = { area:new Set<string>(), cat:new Set<string>(), jlpt:new Set<string>() };
  const grid = document.querySelector('[data-grid]') as HTMLElement;
  const cards = Array.from(grid.querySelectorAll('.co')) as HTMLElement[];
  const searchEl = document.querySelector<HTMLInputElement>('[data-search-input]')!;
  const statusEl = document.querySelector<HTMLElement>('[data-status]')!;
  const emptyEl = document.querySelector('[data-empty]') as HTMLElement;
  const resetEl = document.querySelector<HTMLButtonElement>('[data-reset]')!;
  const filterOptions = document.querySelector<HTMLDetailsElement>('[data-filter-options]');
  const normalise = (value: string) => value.normalize('NFKC').toLocaleLowerCase().trim();

  function apply(){
    let n = 0;
    const query = normalise(searchEl.value);
    cards.forEach(c => {
      const areas = (c.dataset.areas || '').split(' ');
      const okSearch = !query || (c.dataset.search || '').includes(query);
      const okArea = !active.area.size || areas.some(a => active.area.has(a));
      const okCat  = !active.cat.size  || active.cat.has(c.dataset.cat || '');
      const okJl   = !active.jlpt.size || active.jlpt.has(c.dataset.jlpt || 'none');
      const show = okSearch && okArea && okCat && okJl;
      c.style.display = show ? '' : 'none';
      if (show) n++;
    });
    statusEl.textContent = `顯示 ${n} 個品牌`;
    emptyEl.hidden = n > 0;
    const any = searchEl.value.length > 0 || active.area.size || active.cat.size || active.jlpt.size;
    resetEl.hidden = !any;
  }

  searchEl.addEventListener('input', apply);
  document.querySelectorAll('button.f').forEach(b => {
    const el = b as HTMLElement;
    el.addEventListener('click', () => {
      const f = el.dataset.f as keyof typeof active;
      const v = el.dataset.v!;
      if (active[f].has(v)) { active[f].delete(v); el.setAttribute('aria-pressed','false'); }
      else { active[f].add(v); el.setAttribute('aria-pressed','true'); }
      apply();
    });
  });
  resetEl.addEventListener('click', () => {
    searchEl.value = '';
    (Object.keys(active) as (keyof typeof active)[]).forEach(k => active[k].clear());
    document.querySelectorAll('button.f').forEach(b => b.setAttribute('aria-pressed','false'));
    searchEl.focus();
    apply();
  });

  const mobileFilters = window.matchMedia('(max-width: 720px)');
  if (filterOptions && mobileFilters.matches) filterOptions.open = false;
  if (filterOptions) filterOptions.dataset.ready = '';
  mobileFilters.addEventListener('change', event => {
    if (filterOptions) filterOptions.open = !event.matches;
  });
</script>
