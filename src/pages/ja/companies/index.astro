---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import '../../../styles/page-companies.css';
import CompanyCard from '../../../components/CompanyCard.astro';

import { href } from '../../../i18n/ui';
import { CAT_LABEL } from '../../../lib/site';
const l = (p: string) => href('ja', p);
const companies = (await getCollection('companies'))
  .sort((a, b) => b.data.placements - a.data.placements || a.data.name.localeCompare(b.data.name));

const AREA: Record<string,string> = { tokyo:'東京', osaka:'大阪', kyoto:'京都', fukuoka:'福岡', kobe:'神戸', hokkaido:'北海道' };
const areaKeys = Object.keys(AREA).filter(k => companies.some(c => c.data.areas.includes(k as any)));
const cats = [...new Map(companies.map(c => [c.data.category, CAT_LABEL.ja[c.data.category] ?? c.data.categoryLabel])).entries()];
const jlpts = ['N2','N3'].filter(j => companies.some(c => c.data.jlpt === j));
const totalPlacements = companies.reduce((s,c)=>s+c.data.placements,0);
---
<Base title="提携企業" lang="ja" altPaths={{ zh: '/companies/', ja: '/ja/companies/', en: '/en/companies/' }} description="ツナグ提携の日本企業・ブランド一覧。エリア・職種・日本語レベルで絞り込めます。">
  <section class="page-head">
    <div class="wrap wrap--page">
      <h1 class="d1">提携企業</h1>
      <p class="lead">
        公開中の {companies.length} ブランド（契約企業 39 社）。
        その多くは中国語の求人サイトには出てきません。だからこそ、個人で探すのは難しいのです。
      </p>
    </div>
  </section>

  <div class="wrap tools" data-filter-root
    data-status-tpl="{n} ブランドを表示中"
    data-summary-label="絞り込み"
    data-summary-picked="絞り込み（{n} 件選択中）">
    <div class="filters">
      <label class="search">
        <span>ブランド検索</span>
        <input type="search" inputmode="search" autocomplete="off" placeholder="ブランド名を入力"
          aria-controls="company-grid" data-search-input />
      </label>
      <details class="filter-options" data-filter-options open>
        <summary data-filter-summary>絞り込み</summary>
        <div class="filter-groups">
          <div class="grp" role="group" aria-labelledby="filter-area-label">
            <span class="lbl" id="filter-area-label">エリア</span>
            {areaKeys.map(k => <button type="button" class="tag area f" data-f="area" data-v={k}
              aria-pressed="false" aria-controls="company-grid">{AREA[k]}</button>)}
          </div>
          <div class="grp" role="group" aria-labelledby="filter-cat-label">
            <span class="lbl" id="filter-cat-label">職種</span>
            {cats.map(([k,l]) => <button type="button" class="tag job f" data-f="cat" data-v={k}
              aria-pressed="false" aria-controls="company-grid">{l}</button>)}
          </div>
          <div class="grp" role="group" aria-labelledby="filter-jlpt-label">
            <span class="lbl" id="filter-jlpt-label">日本語</span>
            {jlpts.map(j => <button type="button" class="tag jlpt f" data-f="jlpt" data-v={j}
              aria-pressed="false" aria-controls="company-grid">{j} 以上</button>)}
            <button type="button" class="tag f" data-f="jlpt" data-v="none"
              aria-pressed="false" aria-controls="company-grid">不問</button>
          </div>
          <div class="grp" role="group" aria-labelledby="filter-flag-label">
            <span class="lbl" id="filter-flag-label">その他</span>
            <button type="button" class="tag f" data-f="flag" data-v="online"
              aria-pressed="false" aria-controls="company-grid">オンライン面接可</button>
            <button type="button" class="tag f" data-f="flag" data-v="fulltime"
              aria-pressed="false" aria-controls="company-grid">正社員登用の実績あり</button>
          </div>
        </div>
      </details>
      <button type="button" class="reset" data-reset data-reset-toggle hidden>検索・絞り込みをクリア</button>
    </div>
    <p class="count small"><span role="status" aria-live="polite" aria-atomic="true"
      data-status>{companies.length} ブランドを表示中</span><span>／全 {companies.length} ブランド合計で延べ {totalPlacements} 名の勤務実績</span></p>
  </div>

  <div class="wrap">
    <div class="notice">
      <strong>募集状況について：</strong>掲載しているのはブランド紹介と勤務実績であり、リアルタイムの求人情報ではありません。募集内容・条件は<a href={l('/events')}>交流会</a>または個別相談でご確認ください。
    </div>
  </div>

  <section class="wrap list">
    <h2 class="sr-only">検索結果</h2>
    <div class="grid" id="company-grid" data-grid>
      {companies.map(c => <CompanyCard c={c} href={l(`/companies/${c.id}`)} lang="ja" />)}
    </div>
    <div class="empty" data-empty hidden>
      <p class="small">条件に合うブランドがありません。</p>
      <button type="button" class="btn btn-secondary" data-reset>条件をクリアして全ブランドを見る</button>
    </div>
  </section>

  <section class="wrap page-section closing">
    <h2 class="d2">気になるブランドはありましたか？</h2>
    <p class="lead">実際の募集内容は、交流会で直接ご確認いただけます。</p>
    <div class="cta-row">
      <a class="btn btn-primary" href={l('/events')}>交流会に申し込む →</a>
      <a class="action-link" href={l('/stories')}>先輩の体験談を見る →</a>
    </div>
  </section>
</Base>


<script>
  import { initCompanyFilter } from '../../../scripts/company-filter';
  initCompanyFilter();
</script>
