---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import '../../../styles/page-company.css';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  return companies.map(c => ({ params: { slug: c.id }, props: { c } }));
}
const { c } = Astro.props;
const d = c.data;
const { Content } = await render(c);
// 在這個品牌工作過的學長姐（company 名寬鬆比對；資料本來就在庫裡，接上而已）
const allStories = await getCollection('stories');
const norm = (x: string) => x.normalize('NFKC').toLowerCase().replace(/[^a-z0-9\u3040-\u30ff\u4e00-\u9fff]/g, '');
const dn = norm(d.name);
const relatedStories = allStories.filter(st => {
  const sn = norm(st.data.company);
  if (sn.length < 2) return false;
  // 前綴比對而非子字串：避免 "ete" 誤配 "agete"；另取空格前第一段處理 "MUK ムカイ" → MUKAI
  const snFirst = norm(st.data.company.split(/[\s/]/)[0]);
  return sn === dn || dn.startsWith(sn) || sn.startsWith(dn) || (snFirst.length > 2 && dn.startsWith(snFirst));
}).sort((a, b) => a.data.order - b.data.order);
import { href } from '../../../i18n/ui';
import { CAT_LABEL, VISA_LABEL, dedupHighlights, fmtSourceDeck } from '../../../lib/site';
const l = (p: string) => href('ja', p);
const companiesCount = (await getCollection('companies')).length;
const catLabel = CAT_LABEL.ja[d.category] ?? d.categoryLabel;
const tagline = d.taglineJa ?? d.tagline;
const AREA = { tokyo:'東京', osaka:'大阪', kyoto:'京都', fukuoka:'福岡', kobe:'神戸', hokkaido:'北海道' };
const hl = dedupHighlights(d.highlights, d.placements);
---
<Base title={`${d.name}｜提携ブランド`} lang="ja"
  altPaths={{ zh: `/companies/${c.id}/`, ja: `/ja/companies/${c.id}/`, en: `/en/companies/${c.id}/` }}
  description={`${d.name}（${catLabel}）のブランド紹介と台湾人スタッフの勤務実績${d.placements > 0 ? `：累計 ${d.placements} 名がツナグ経由で就業` : ''}。詳しくは無料の交流会で。`}>
  <article>
    <div class="hero">
      <div class="wrap wrap--prose">
        <a class="back" href={l('/companies')}>← 提携企業一覧へ</a>
        <h1 class="d1">{d.name}</h1>
        {d.corporateName && <p class="corp" lang="ja">{d.corporateName}</p>}
        <p class="lead">{tagline}</p>
        <div class="tags">
          {d.areas.map((a:string) => <span class="tag area">{AREA[a as keyof typeof AREA]}</span>)}
          <span class="tag job">{catLabel}</span>
          {d.jlpt && <span class="tag jlpt">{d.jlpt} 以上</span>}
          {d.onlineInterview && <span class="tag">オンライン面接可</span>}
        </div>
      </div>
    </div>

    <div class="wrap wrap--prose body">
      <div class="prose" lang="zh-Hant"><Content /></div>

      {hl.length > 0 && (
        <div class="hl">
          <h2 class="d3">ポイント（原文）</h2>
          <ul lang="zh-Hant">{hl.map((h:string) => <li>{h}</li>)}</ul>
        </div>
      )}

      {(d.placements > 0 || d.fullTimeConverted > 0) && (
        <div class="numbers">
          {d.placements > 0 && <div><div class="n">{d.placements}</div><div class="t">台湾人スタッフ勤務実績（名）</div></div>}
          {d.fullTimeConverted > 0 && <div><div class="n">{d.fullTimeConverted}</div><div class="t">うち正社員登用（名）</div></div>}
        </div>
      )}

      <div class="note">
        <strong>出典：</strong>{fmtSourceDeck('ja', d.sourceSlide)}。募集条件・状況は変動します。最新情報は交流会または個別相談でご確認ください。※ 本文は原文（中国語）のまま掲載しています。
      </div>

      {relatedStories.length > 0 && (
        <div class="related">
          <h2 class="d3">このブランドで働いていた先輩</h2>
          {relatedStories.map(st => (
            <a class="rel-link" href={l(`/stories#${st.id}`)}><span lang="ja">{st.data.name}</span> さん（{VISA_LABEL.ja[st.data.visa] ?? st.data.visa}）の体験談 →</a>
          ))}
        </div>
      )}
      <div class="cta">
        <a class="btn btn-primary" href={l('/events')}>交流会で詳しく聞く →</a>
        <a class="action-link" href={l('/companies')}>{companiesCount} ブランドをすべて見る →</a>
      </div>
    </div>
  </article>
</Base>

