---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import CategoryIcon from '../../../components/CategoryIcon.astro';
import '../../../styles/page-company.css';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  return companies.map(c => ({ params: { slug: c.id }, props: { c } }));
}
const { c } = Astro.props;
const d = c.data;
const name = companyName(d, 'ja');
const { Content } = await render(c);
// 在這個品牌工作過的學長姐（company 名寬鬆比對；資料本來就在庫裡，接上而已）
const allStories = await getCollection('stories');
const relatedStories = relatedStoriesFor(d.name, allStories);
import { href, ui } from '../../../i18n/ui';
import { CAT_LABEL, VISA_LABEL, dedupHighlights, fmtSourceDeck, companyName, relatedStoriesFor, signupCta, SKY_CATEGORIES } from '../../../lib/site';
const l = (p: string) => href('ja', p);
const companiesCount = (await getCollection('companies')).length;
const catLabel = CAT_LABEL.ja[d.category] ?? d.categoryLabel;
const tagline = d.taglineJa ?? d.tagline;
const AREA = ui['ja'].area;
const hl = dedupHighlights(d.highlights, d.placements);
---
<Base title={`${name}｜提携ブランド`} lang="ja"
  altPaths={{ zh: `/companies/${c.id}/`, ja: `/ja/companies/${c.id}/`, en: `/en/companies/${c.id}/` }}
  description={`${name}（${catLabel}）のブランド紹介と台湾人スタッフの勤務実績${d.placements > 0 ? `：累計 ${d.placements} 名がツナグ経由で就業` : ''}。詳しくは無料の交流会で。`}>
  <article>
    <div class="page-head hero">
      <div class="wrap wrap--page">
        <a class="back" data-back-list href={l('/companies')}><span aria-hidden="true">←</span> 提携企業一覧へ</a>
        <!-- 頁首兩欄（2026-10-04）：左＝品類圖標＋品牌名＋登記名、tagline、標籤；右＝實績數字（原本在內文最下方的磁磚）。
             圖標與品牌名跟企業卡同名（view-transition-name），從列表點進來會連續變形到這裡 -->
        <div class="b-head">
          <div class="b-id">
            <div class="b-name">
              <span class="b-ico" data-tone={SKY_CATEGORIES.has(d.category) ? 'sky' : 'pink'} style={`view-transition-name:ico-${c.id}`}><CategoryIcon cat={d.category} size={36} /></span>
              <div class="b-ttl">
                <h1 class="d1" data-vt style={`view-transition-name:nm-${c.id}`}>{name}</h1>
                {d.corporateName && <p class="corp" lang="ja">{d.corporateName}</p>}
              </div>
            </div>
            <p class="lead">{tagline}</p>
            <div class="tags">
              {d.areas.map((a:string) => <span class="tag area">{AREA[a as keyof typeof AREA]}</span>)}
              <span class="tag job">{catLabel}</span>
              {d.jlpt && <span class="tag jlpt">{d.jlpt} 以上</span>}
              {d.onlineInterview && <span class="tag">オンライン面接可</span>}
            </div>
          </div>
          {(d.placements > 0 || d.fullTimeConverted > 0) && (
            <dl class="b-figs">
              {d.placements > 0 && <div><dt>台湾人スタッフ勤務実績</dt><dd class="n">{d.placements}<small>名</small></dd></div>}
              {d.fullTimeConverted > 0 && <div><dt>うち正社員登用</dt><dd class="n">{d.fullTimeConverted}<small>名</small></dd></div>}
            </dl>
          )}
        </div>
      </div>
    </div>

    <div class="wrap wrap--page page-section body">
      <div class="prose" lang="zh-Hant"><Content /></div>

      {hl.length > 0 && (
        <div class="card hl">
          <h2 class="d3">ポイント（原文）</h2>
          <ul lang="zh-Hant">{hl.map((h:string) => <li>{h}</li>)}</ul>
        </div>
      )}

      <div class="note">
        <span class="sent"><strong>出典：</strong>{fmtSourceDeck('ja', d.sourceSlide)}。</span><span class="sent">募集条件・状況は変動します。最新情報は交流会または個別相談でご確認ください。</span><span class="sent">※ 本文は原文（中国語）のまま掲載しています。</span>
      </div>

      {relatedStories.length > 0 && (
        <div class="related">
          <h2 class="d3">このブランドで働いていた先輩</h2>
          {relatedStories.map(st => (
            <a class="rel-link" href={l(`/stories#${st.id}`)}><span lang="ja">{st.data.name}</span> さん（{VISA_LABEL.ja[st.data.visa] ?? st.data.visa}）の体験談</a>
          ))}
        </div>
      )}
      <div class="cta-row cta">
        <a class="btn btn-primary" href={l('/events')}>{signupCta('ja')}</a>
        <a class="action-link" href={l('/companies')}>{companiesCount} ブランドをすべて見る</a>
      </div>
    </div>
  </article>
</Base>
<script>import '../../../scripts/back-to-list.ts';</script>
