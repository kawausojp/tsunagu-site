---
// 日本語版トップ。構成・スタイルは繁中版（/src/pages/index.astro）と共通（home.css）。
// 2026-10-25 網誌化改版：hero → 統計 → 交流会のご案内 → 記事一覧 → ニュース映像。提携企業セクションは削除（主催者の意向）。
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/home.css';
import StatIcon from '../../components/StatIcon.astro';
import Heart from '../../components/Heart.astro';
import NextEvent from '../../components/NextEvent.astro';
import PostList from '../../components/PostList.astro';
import { Image } from 'astro:assets';
import characters from '../../assets/tsunagu-characters.png';
import { href } from '../../i18n/ui';
import { VIDEO_ID, VIDEO_START, signupCta, HOME_STATS, CONTRACTED_COMPANIES, buildFeed } from '../../lib/site';

const l = (p: string) => href('ja', p);
const feed = buildFeed(await getCollection('stories'), 'ja');
const heroCta = signupCta('ja');
const stats = [
  { icon: 'job', n: HOME_STATS.active, u: '名', t: '日本で活躍中' },
  { icon: 'rise', n: HOME_STATS.fulltime, u: '名', t: '正社員に' },
  { icon: 'people', n: HOME_STATS.attendees, u: '名', t: '交流会参加者' },
  { icon: 'brand', n: String(CONTRACTED_COMPANIES), u: '社', t: '契約企業' },
];
---
<Base title="台湾の優秀な人材を、日本へ" lang="ja"
  description="日本で働きたい台湾人と日本企業をつなぐマッチング交流会。履歴書・面接サポートから来日後のフォローまで、台湾の皆さまは、すべて無料でご利用いただけます。"
  altPaths={{ zh: '/', ja: '/ja/' }}>

  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="ja-sub" lang="ja">台湾人と日本企業をツナグ</p>
      <h1 class="d1"><span class="headline-part">台湾の優秀な人材を</span><span class="headline-comma">、</span><span class="headline-part">日本へ</span></h1>
      <!-- 招牌時刻「ツナグ」（2026-10-04）：同一張圖切成左右兩半（狗／貓），進場時從兩側靠近、碰拳，愛心彈出。
           兩個 <Image> 的 srcset 相同，瀏覽器只下載一次；整組以 role="img" 對讀屏報讀一次 -->
      <div class="chars" role="img" aria-label="ツナグのキャラクター：JPと書かれた青い服の犬と、TWと書かれたピンクの服の猫が手をつないで座っている">
        <Image src={characters} alt="" widths={[240, 480]} sizes="(max-width: 720px) 168px, 240px" loading="eager" fetchpriority="high" class="chars-half chars-l" />
        <Image src={characters} alt="" widths={[240, 480]} sizes="(max-width: 720px) 168px, 240px" loading="eager" class="chars-half chars-r" />
        <Heart size={20} class="chars-heart" />
        <Heart size={20} class="chars-heart chars-heart--cta" />
      </div>
      <p class="lead">
        <span class="sent">留学やワーキングホリデーで来日する台湾の若者と、台湾出身のスタッフを迎えたい日本企業をマッチングしています。</span>
        <strong class="sent">履歴書の作成から面接、来日後のフォローまで、台湾の皆さまは、すべて無料。</strong>
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={l('/events')}>{heroCta}</a>
        <a class="action-link" href={l('/stories')}>先輩の声を読む</a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <!-- 統計：四個泡泡（使用者 2026-09-13 定案） -->
  <div class="wrap"><div class="band">
    {stats.map(s => (
      <div class="stat"><div class="bubble"><div class="t"><StatIcon k={s.icon} size={20} /><span class="lbl">{s.t}</span></div><div class="n" data-count={s.n} aria-hidden="true">{s.n}<small>{s.u}</small></div></div><span class="sr-only">{s.n}{s.u}</span></div>
    ))}
  </div>
  </div>


  <!-- 交流会のご案内（次回の日程・会場。未定のときは Instagram へ） -->
  <section class="section nx-sec"><div class="wrap wrap--page"><NextEvent lang="ja" /></div></section>

  <!-- 記事一覧：先輩の声＋交流会レポート＋メディア掲載（新しい順） -->
  <section class="section feed-sec" aria-labelledby="feed-h">
    <div class="wrap wrap--page">
      <h2 class="d2" id="feed-h">新着記事</h2>
      <PostList items={feed} lang="ja" initial={12} defaultCat="story" />
    </div>
  </section>

  <!-- VIDEO -->
  <section class="section vid-sec t-center">
    <div class="wrap">
      <h2 class="d2">ニュースで紹介されました</h2>
      <p class="lead"><span class="sent">台湾の公共放送・公視のニュース：ツナグを通じて日本でワーキングホリデーをした体験談（ツナグの場面から再生されます）。</span></p>
      <!-- 直接嵌入（2026-08-28 使用者指定：不做點擊門面，從 VIDEO_START 秒開始）。 -->
      <div class="video">
        <iframe src={`https://www.youtube-nocookie.com/embed/${VIDEO_ID}?start=${VIDEO_START}`}
          title="台湾の公共放送・公視：台湾向けワーキングホリデー枠・年間 1 万人のニュース（ツナグへのインタビューを含む）"
          loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture"
          allowfullscreen></iframe>
      </div>
      <p class="small vid-more"><a href={`https://www.youtube.com/watch?v=${VIDEO_ID}`} target="_blank" rel="noopener">YouTube で見る <span aria-hidden="true">↗</span><span class="sr-only">（新しいウィンドウで開きます）</span></a></p>
      <a class="action-link" href={l('/about') + '#media'}>そのほかのメディア掲載</a>
    </div>
  </section>

</Base>

<script>
  import "../../scripts/motion";
</script>
