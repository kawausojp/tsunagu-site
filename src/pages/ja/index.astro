---
// 日本語版トップ。構造・スタイルは繁中版（/src/pages/index.astro）と共通（home.css）。
// 三言語のページ構造を変更する際は zh/ja/en を同時に更新すること（CLAUDE.md 参照）。
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/home.css';
import CompanyCard from '../../components/CompanyCard.astro';
import SenpaiAvatar from '../../components/SenpaiAvatar.astro';
import { Image } from 'astro:assets';
import characters from '../../assets/tsunagu-characters.png';
import { href } from '../../i18n/ui';
import { VIDEO_ID, nextEvent, fmtEventDate, fmtEventNo, totalHeld, CITY, VISA_LABEL } from '../../lib/site';

const l = (p: string) => href('ja', p);
const companies = (await getCollection('companies'))
  .sort((a, b) => b.data.placements - a.data.placements);
const featured = companies.slice(0, 6);
const stories = (await getCollection('stories')).sort((a, b) => a.data.order - b.data.order);
const firstStory = stories[0];

const nextEv = nextEvent();
const nextEvDate = nextEv ? fmtEventDate(nextEv.date, 'ja') : '';
const heroCta = nextEv
  ? `${nextEvDate}・${CITY.ja[nextEv.city] ?? nextEv.city}の交流会に申し込む →`
  : '次回の交流会に申し込む →';
const stats = [
  { n: '2,874', u: '名', t: '交流会参加者数' },
  { n: '163', u: '名', t: '日本での就業を実現' },
  { n: String(totalHeld), u: '回', t: '交流会開催実績' },
  { n: String(companies.length), u: '', t: '提携ブランド' },
];
---
<Base title="台湾の優秀な人材を、日本へ" lang="ja"
  description="日本で働きたい台湾人と日本企業をつなぐマッチング交流会。履歴書・面接サポートから来日後のフォローまで、台湾の皆さまは、すべて無料でご利用いただけます。"
  altPaths={{ zh: '/', ja: '/ja/', en: '/en/' }}>

  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="ja-sub" lang="ja">台湾人と日本企業をツナグ</p>
      <h1 class="d1"><span class="headline-part">台湾の優秀な人材を</span><span class="headline-comma">、</span><span class="headline-part">日本へ</span></h1>
      <Image src={characters}
        alt="ツナグのキャラクター：JPと書かれた青い服の犬と、TWと書かれたピンクの服の猫が手をつないで座っている"
        widths={[240, 480]} sizes="(max-width: 720px) 152px, 200px" loading="eager" class="chars" />
      <p class="lead">
        留学やワーキングホリデーで来日する台湾の若者と、
        台湾出身のスタッフを迎えたい日本企業をマッチングしています。
        <strong>履歴書の作成から面接、来日後のフォローまで、台湾の皆さまは、すべて無料。</strong>
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={l('/events')}>{heroCta}</a>
        <a class="action-link" href={l('/companies')}>提携企業を見る →</a>
      </div>
    </div>
  </section>

  <!-- NEWS -->
  <div class="wrap">
    {nextEv && (
      <a class="news" href={l('/events')}>
        <span class="news-tag" lang="ja">お知らせ</span>
        <span class="news-txt">第 {fmtEventNo(nextEv.no, 'ja')} 回交流会　{nextEvDate}{CITY.ja[nextEv.city] ?? nextEv.city}・申込受付中 <span aria-hidden="true">→</span></span>
      </a>
    )}
  </div>

  <!-- STATS -->
  <div class="wrap"><div class="band">
    {stats.map(s => (
      <div><div class="n">{s.n}<small>{s.u}</small></div><div class="t">{s.t}</div></div>
    ))}
  </div>
  </div>

  <!-- VIDEO -->
  <section class="section vid-sec">
    <div class="wrap">
      <h2 class="d2">交流会の様子</h2>
      <p class="lead">台湾の公共放送・公視のニュースで紹介されました（ツナグへのインタビューを含む）。</p>
      <div class="video">
        <iframe src={`https://www.youtube-nocookie.com/embed/${VIDEO_ID}`}
          title="台湾の公共放送・公視：台湾向けワーキングホリデー枠・年間 1 万人のニュース（ツナグへのインタビューを含む）"
          loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture"
          allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <!-- COMPANIES -->
  <section class="section alt">
    <div class="wrap co-split">
      <div class="co-side">
        <h2 class="d2">提携している日本企業</h2>
        <p class="lead">中国語の求人サイトには出てこない店舗と皆さまを、私たちが直接おつなぎします。以下は勤務実績の多い 6 ブランドです。</p>
        <a class="action-link" href={l('/companies')}>{companies.length} ブランドをすべて見る →</a>
      </div>
      <div class="grid3 grid-co">
        {featured.map(c => <CompanyCard c={c} href={l(`/companies/${c.id}`)} lang="ja" />)}
      </div>
    </div>
  </section>

  <!-- STORIES -->
  <section class="section">
    <div class="wrap">
      <h2 class="d2">先輩の声</h2>
      <div class="voice">
        <div class="v-avatar"><SenpaiAvatar name={firstStory.data.name} size={96} /></div>
        <div>
          <blockquote class="v-quote" lang="zh-Hant">{firstStory.data.lead}</blockquote>
          <p class="small v-meta">
            <span lang="ja">{firstStory.data.name}</span>　{VISA_LABEL.ja[firstStory.data.visa] ?? firstStory.data.visa}・{firstStory.data.company}（{firstStory.data.location}）
            <br/>※ 体験談は原文（中国語）のまま掲載しています。
          </p>
        </div>
      </div>
      <div class="more"><a class="action-link" href={l('/stories')}>{stories.length} 名の先輩の体験談を見る →</a></div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section final">
    <div class="wrap final-split">
      <div>
        <h2 class="d2">まずは交流会へ</h2>
        <p class="lead">何かを決めてから来る必要はありません。準備も不要です。日本企業がどんな人材を求めているか、まず聞きに来てください。</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={l('/events')}>次回の交流会を見る →</a>
          <a class="action-link" href={l('/apply')}>日本行きを決めた方はこちら →</a>
        </div>
      </div>
      <Image src={characters} alt="" aria-hidden="true" widths={[200, 400]} sizes="200px" loading="lazy" class="final-chars" />
    </div>
  </section>

</Base>
