---
// 日本語版：交流会日程。構造は zh 版と共通（page-events.css）。三言語同時更新のこと。
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import '../../../styles/page-events.css';
import { href } from '../../../i18n/ui';
import { todayTaipei, fmtEventDateFull, fmtEventNo, fmtSince, CITY, eventLd, totalHeld, eventsMeta, JOIN_STEPS, gcalUrl, companyName } from '../../../lib/site';

const l = (p: string) => href('ja', p);
const today = todayTaipei();
const sorted = [...eventsMeta.events].sort((a, b) => b.date.localeCompare(a.date));
const upcoming = sorted.filter(e => e.date >= today).reverse();
const past = sorted.filter(e => e.date < today);
const fmt = (d: string) => fmtEventDateFull(d, 'ja');
const city = (c: string) => CITY.ja[c] ?? c;

// Event 結構化資料：site.ts eventLd()（三語共用）
const eventsLd = upcoming.filter(e => e.venue && e.address).map(eventLd);

const flow = JOIN_STEPS.ja;   // 三語共用，文字在 site.ts（品牌頁的「想在這裡工作？」也用同一份）
// 「你收藏的品牌」提示框要的品牌名與網址（收藏本身在訪客瀏覽器，save.js 依這份清單畫出來）
const savedNames = Object.fromEntries((await getCollection('companies')).map(c => [c.id, { name: companyName(c.data, 'ja'), href: l(`/companies/${c.id}`) }]));
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
---
<Base title="交流会に申し込む" lang="ja"
  altPaths={{ zh: '/events/', ja: '/ja/events/', en: '/en/events/' }}
  description="台北・台中・高雄・東京・大阪で開催する台湾人と日本企業のマッチング交流会。参加無料。">
  {eventsLd.map(ld => <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  <section class="page-head"><div class="wrap wrap--page">
    <h1 class="d1">交流会に申し込む</h1>
    <p class="lead"><span class="sent">日本企業がどんな人材を求めているか、先輩の<span class="nowrap">生の声</span>とあわせて聞ける場です。</span></p>
    <p class="small since">{fmtSince(eventsMeta.since, 'ja')}から累計 <strong>{totalHeld}</strong> 回開催。
      {eventsMeta.cities.map(c => city(c)).join('・')}で実施しています。</p>
  </div></section>

  <section class="wrap wrap--page page-section" id="signup">
    <h2 class="d2">次回開催</h2>
    {upcoming.length > 0
      ? <div class="upcoming-list">
          {upcoming.map(e => (
            <div class="card next">
              <div class="when">
                <span class="no">第 {fmtEventNo(e.no, 'ja')} 回</span>
                <span class="date">{fmt(e.date)}</span>
                <span class="tag area">{city(e.city)}</span>
              </div>
              <dl class="ev-meta">
                {e.sessions && <><dt>時間</dt><dd>{e.sessions.join('　／　')}</dd></>}
                {e.venue && <><dt>会場</dt><dd lang="zh-Hant">{e.venue}{e.address && <span class="addr">（{e.address}）</span>}{e.address && <a class="map-link" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${e.venue} ${e.address}`)}`} target="_blank" rel="noopener">Google マップで開く <span aria-hidden="true">↗</span><span class="sr-only">（新しいウィンドウで開きます）</span></a>}</dd></>}
                <dt>参加費</dt><dd>無料</dd>
              </dl>
              {e.signupUrl
                ? <>
                    <a class="btn btn-primary" href={e.signupUrl} target="_blank" rel="noopener">Google フォームで申し込む <span aria-hidden="true">↗</span><span class="sr-only">（新しいウィンドウで開きます）</span></a>
                    <p class="small hint">回によって申込フォームが異なります。必ず本回専用のフォームをご利用ください。</p>
                    {e.sessions && e.sessions.length > 0 && (
                      <p class="small cal"><span>Google カレンダーに追加：</span>{e.sessions.map(s => {
                        const u = gcalUrl(e, s, 'ja', pageUrl);
                        return u && <a href={u} target="_blank" rel="noopener">{s.split(/[–-]/)[0].trim()}の回 <span aria-hidden="true">↗</span><span class="sr-only">（新しいウィンドウで開きます）</span></a>;
                      })}</p>
                    )}
                  </>
                : <p class="small">申込リンクは近日公開予定です。</p>}
            </div>
          ))}
        </div>
      : <div class="card next empty">
          <p><strong>次回日程は未定です。</strong></p>
          <p class="small">開催の 2〜4 週間前に Instagram でお知らせします。直近の開催は第 {fmtEventNo(past[0]?.no ?? '', 'ja')} 回（{fmt(past[0]?.date)}・{city(past[0]?.city)}）でした。</p>
          <a class="action-link ext" href="https://www.instagram.com/tw.tsunagu.jp/" target="_blank" rel="noopener">Instagram をフォロー <span aria-hidden="true">↗</span><span class="sr-only">（新しいウィンドウで開きます）</span></a>
        </div>}
    <!-- 收藏的品牌（2026-10-11）：逛企業時按的愛心，在這裡提醒「交流會現場可以直接問」。沒有收藏就不出現 -->
    <div class="saved-box" data-saved-box data-saved-names={JSON.stringify(savedNames)} hidden>
      <p class="saved-ttl"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 20.3s-7.6-4.6-7.6-10.2A4.3 4.3 0 0 1 12 7.4a4.3 4.3 0 0 1 7.6 2.7c0 5.6-7.6 10.2-7.6 10.2z"/></svg>お気に入りのブランド——交流会で直接聞いてみましょう</p>
      <ul class="saved-list" data-saved-list></ul>
      <a class="action-link" href={l('/companies') + '?saved=1'}>お気に入りを見る</a>
    </div>
  </section>

  <section class="wrap wrap--page page-section">
    <h2 class="d2">交流会当日の流れ</h2>
    <ol class="flow">
      {flow.map((f, i) => (
        <li class="card step"><div class="no-badge" aria-hidden="true">{i + 1}</div><div><h3 class="d3">{f.t}</h3><p class="small">{f.d}</p></div></li>
      ))}
    </ol>
    <p class="small flow-more"><a href={l('/companies')}>提携企業を見る</a>・<a href={l('/apply#photo')}>履歴書写真の撮り方</a>・<a href={l('/support')}>サポート内容の詳細</a></p>
    <div class="note"><span class="sent"><strong>すべて無料。</strong>参加費・紹介料は、台湾の皆さまからは一切いただきません。詳しくは「サポート内容」をご覧ください。</span></div>
  </section>

  <section class="wrap wrap--page page-section">
    <h2 class="d2">開催実績</h2>
    <p class="lead">直近 {past.length} 回の開催記録です。それ以前は
      <a href="https://www.instagram.com/tw.tsunagu.jp/" target="_blank" rel="noopener">Instagram&nbsp;<span aria-hidden="true">↗</span><span class="sr-only">（新しいウィンドウで開きます）</span></a> をご覧ください。</p>
    <ul class="hist rows">
      {past.map(e => (
        <li class="row h">
          <span class="d">第 {fmtEventNo(e.no, 'ja')} 回</span>
          <span class="date">{fmt(e.date)}</span>
          <span class="tag area">{city(e.city)}</span>
          {e.ig && <a class="small ig" href={`https://www.instagram.com/p/${e.ig}/`} target="_blank" rel="noopener"><span class="sr-only">第 {fmtEventNo(e.no, 'ja')} 回の</span>開催報告 <span aria-hidden="true">↗</span><span class="sr-only">（新しいウィンドウで開きます）</span></a>}
        </li>
      ))}
    </ul>
    <p class="small backtop"><a href="#signup"><span aria-hidden="true">↑</span> 次回の申込に戻る</a></p>
  </section>
</Base>
