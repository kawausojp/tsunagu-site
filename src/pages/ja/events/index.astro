---
// 日本語版：交流会日程。構造は zh 版と共通（page-events.css）。三言語同時更新のこと。
import Base from '../../../layouts/Base.astro';
import '../../../styles/page-events.css';
import { href } from '../../../i18n/ui';
import { todayTaipei, fmtEventDate, fmtEventNo, fmtSince, CITY, eventLd, totalHeld, eventsMeta } from '../../../lib/site';

const l = (p: string) => href('ja', p);
const today = todayTaipei();
const sorted = [...eventsMeta.events].sort((a, b) => b.date.localeCompare(a.date));
const upcoming = sorted.filter(e => e.date >= today).reverse();
const past = sorted.filter(e => e.date < today);
const fmt = (d: string) => `${d.slice(0, 4)}/${fmtEventDate(d, 'ja')}`;
const city = (c: string) => CITY.ja[c] ?? c;

// Event 結構化資料：site.ts eventLd()（三語共用）
const eventsLd = upcoming.filter(e => e.venue && e.address).map(eventLd);

const flow = [
  { t: '当日のプログラム', d: '日本企業が求める人材像を紹介し、先輩が、日本で働く実際の姿を語ります。' },
  { t: '個別相談', d: '日本語レベル・希望職種・渡航時期についてお聞かせください。' },
  { t: 'その後のステップ', d: '履歴書の作成から面接練習、在留資格の手続き、来日後のフォローまで、最後まで伴走します。' },
];
---
<Base title="交流会日程・申込" lang="ja"
  altPaths={{ zh: '/events/', ja: '/ja/events/', en: '/en/events/' }}
  description="台北・台中・高雄・東京・大阪で開催する台湾人と日本企業のマッチング交流会。参加無料。">
  {eventsLd.map(ld => <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  <section class="page-head"><div class="wrap wrap--reading">
    <h1 class="d1">交流会に来てみませんか</h1>
    <p class="lead">日本企業がどんな人材を求めているか、先輩の生の声とあわせて聞ける場です。</p>
    <p class="small since">{fmtSince(eventsMeta.since, 'ja')}から累計 <strong>{totalHeld}</strong> 回開催。
      {eventsMeta.cities.map(c => city(c)).join('・')}で実施しています。</p>
  </div></section>

  <section class="wrap wrap--reading page-section" id="signup">
    <h2 class="d2">次回開催</h2>
    {upcoming.length > 0
      ? <div class="upcoming-list">
          {upcoming.map(e => (
            <div class="card next">
              <div class="when">
                <span class="no">第 {fmtEventNo(e.no, 'ja')} 回</span>
                <span class="date">{fmt(e.date)}</span>
                <span class="tag area">{city(e.city)}</span>
              </div>
              <dl class="ev-meta">
                {e.sessions && <><dt>時間</dt><dd>{e.sessions.join('　／　')}</dd></>}
                {e.venue && <><dt>会場</dt><dd lang="zh-Hant">{e.venue}{e.address && <span class="addr">（{e.address}）</span>}{e.address && <a class="map-link" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${e.venue} ${e.address}`)}`} target="_blank" rel="noopener">Google マップで開く <span aria-hidden="true">↗</span><span class="sr-only">（新しいウィンドウで開きます）</span></a>}</dd></>}
                <dt>参加費</dt><dd>無料</dd>
              </dl>
              {e.signupUrl
                ? <>
                    <a class="btn btn-primary" href={e.signupUrl} target="_blank" rel="noopener">Google フォームで申し込む <span aria-hidden="true">↗</span><span class="sr-only">（新しいウィンドウで開きます）</span></a>
                    <p class="small hint">回によって申込フォームが異なります。必ず本回専用のフォームをご利用ください。</p>
                  </>
                : <p class="small">申込リンクは近日公開予定です。</p>}
            </div>
          ))}
        </div>
      : <div class="card next empty">
          <p><strong>次回日程は未定です。</strong></p>
          <p class="small">開催の 2〜4 週間前に Instagram でお知らせします。直近の開催は第 {fmtEventNo(past[0]?.no ?? '', 'ja')} 回（{fmt(past[0]?.date)}・{city(past[0]?.city)}）でした。</p>
          <a class="action-link ext" href="https://www.instagram.com/tw.tsunagu.jp/" target="_blank" rel="noopener">Instagram をフォロー <span aria-hidden="true">↗</span><span class="sr-only">（新しいウィンドウで開きます）</span></a>
        </div>}
  </section>

  <section class="wrap wrap--reading page-section">
    <h2 class="d2">交流会当日の流れ</h2>
    <ol class="flow">
      {flow.map((f, i) => (
        <li class="card step"><div class="no-badge" aria-hidden="true">{i + 1}</div><div><h3 class="d3">{f.t}</h3><p class="small">{f.d}</p></div></li>
      ))}
    </ol>
    <p class="small flow-more"><a href={l('/companies')}>提携企業を見る</a>・<a href={l('/apply#photo')}>履歴書写真の撮り方</a>・<a href={l('/support')}>サポート内容の詳細</a></p>
    <div class="note"><strong>すべて無料。</strong>参加費・紹介料は、台湾の皆さまからは一切いただきません。詳しくは「サポート内容」をご覧ください。</div>
  </section>

  <section class="wrap wrap--reading page-section">
    <h2 class="d2">開催実績</h2>
    <p class="lead">直近 {past.length} 回の開催記録です。それ以前は
      <a href="https://www.instagram.com/tw.tsunagu.jp/" target="_blank" rel="noopener">Instagram</a> をご覧ください。</p>
    <ul class="hist rows">
      {past.map(e => (
        <li class="row h">
          <span class="d">第 {fmtEventNo(e.no, 'ja')} 回</span>
          <span class="date">{fmt(e.date)}</span>
          <span class="tag area">{city(e.city)}</span>
          {e.ig && <a class="small ig" href={`https://www.instagram.com/p/${e.ig}/`} target="_blank" rel="noopener">開催報告 <span aria-hidden="true">↗</span><span class="sr-only">（新しいウィンドウで開きます）</span></a>}
        </li>
      ))}
    </ul>
    <p class="small backtop"><a href="#signup"><span aria-hidden="true">↑</span> 次回の申込に戻る</a></p>
  </section>
</Base>
