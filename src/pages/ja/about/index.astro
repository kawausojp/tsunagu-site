---
import Base from '../../../layouts/Base.astro';
import '../../../styles/page-about.css';
import { href } from '../../../i18n/ui';
const l = (p: string) => href('ja', p);
// 連結原則（CLAUDE.md 紅線 #3）：只外連報社原文，不貼報紙掃描圖。
// 繊研 2025 兩篇與日經 2024.10.07 經查無線上版（senken.co.jp 404 實測），標紙面刊載。
const media = [
  { name:'日本経済新聞 朝刊', date:'2024.10.07', note:'きものやまと勤務の Haru さんを紹介', print:true },
  { name:'繊研新聞', date:'2026.01.28', url:'https://senken.co.jp/posts/bp-260128' },
  { name:'繊研新聞', date:'2025.07.17', print:true },
  { name:'繊研新聞', date:'2025.02.12', print:true },
  { name:'Yahoo! ニュース', date:'2024.08.07' },
  { name:'台北経済新聞', date:'2023.06.06', url:'https://taipei.keizai.biz/headline/418/' },
];
---
<Base title="ツナグについて" lang="ja" altPaths={{ zh: '/about/', ja: '/ja/about/', en: '/en/about/' }} description="ツナグの運営会社と、この事業を始めた理由。">
  <section class="page-head"><div class="wrap wrap--reading">
    <h1 class="d1">なぜこの事業を始めたのか</h1>
  </div></section>

  <section class="wrap wrap--reading page-section">
    <div class="prose">
      <p>私たちは「日本の良い商品・ブランド・文化を台湾のお客様へ届ける」仕事を 8 年続けてきました。</p>
      <p>その中で、日本で学びたい・働きたい台湾人が非常に多いことを実感しました。観光だけでも毎月 55〜62 万人、2025 年は延べ 676 万人の台湾人が日本を訪れています。</p>
      <p>一方、日本は深刻な人手不足です。インバウンドの回復と円安で訪日客が急増する一方、接客できる人が足りていません。アパレルと飲食は特に深刻です。</p>
      <p><strong>だから私たちは、台湾の優秀な人材を日本へつなぎます。</strong>単なる職探しではなく、台湾人と本気で一緒に働きたい日本企業との出会いを目指しています。</p>
    </div>
  </section>

  <section class="wrap wrap--reading page-section">
    <h2 class="d2">運営会社</h2>
    <div class="grid">
      <div class="card b">
        <h3 class="d3" lang="ja">株式会社ブレーンアンドパートナー</h3>
        <p class="small">1980 年創業の商業施設コンサルティング会社。1,000 社が加盟する日本ショッピングセンター協会の運営に参画。</p>
      </div>
      <div class="card b">
        <h3 class="d3">智囊和夥伴有限公司</h3>
        <p class="small">Brain &amp; Partner Taiwan Inc.（2018 年設立）。2019 年に台北・微風南山 atre の開業コンサルティングを担当し、10 店舗以上を企画・運営。</p>
      </div>
    </div>
    <p class="small">手がけた案件：BLUE BOTTLE COFFEE、JAPAN RAIL CAFE、MAISON DE REEFUR、ささら屋、きものやまと、「世界一濃い抹茶ジェラート」で知られる「ななや」など。直営店 bpt ROOM（台北・微風南山 2F、2019〜2025.9／営業終了）、紫苑花屋（桃園・馬祖新村眷村文創園区）。</p>
  </section>

  <section class="wrap wrap--reading page-section">
    <h2 class="d2">メディア掲載</h2>
    <ul class="media">
      {media.map(m => (
        <li class="card m">
          <span class="d">{m.date}</span>
          {m.url
            ? <a class="n m-link" href={m.url} target="_blank" rel="noopener">{m.name} ↗</a>
            : <span class="n">{m.name}</span>}
          {m.note && <span class="small note-t">{m.note}</span>}
          {m.print && <span class="small note-t">紙面掲載</span>}
        </li>
      ))}
    </ul>
    {/* 內部待辦（勿放回畫面）：各則報導的原文連結（標題＋日期＋外連，不貼截圖），見 CLAUDE.md */}
  </section>

  <section class="wrap wrap--reading page-section">
    <div class="cta-row">
      <a class="btn btn-primary" href={l('/events')}>交流会の日程を見る →</a>
      <a class="action-link" href={l('/stories')}>先輩の声を見る →</a>
    </div>
  </section>
</Base>
