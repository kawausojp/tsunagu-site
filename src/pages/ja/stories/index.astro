---
import { getCollection } from 'astro:content';
import SenpaiAvatar from '../../../components/SenpaiAvatar.astro';
import Base from '../../../layouts/Base.astro';
import '../../../styles/page-stories.css';
const stories = (await getCollection('stories')).sort((a,b)=>a.data.order-b.data.order);
import { href } from '../../../i18n/ui';
import { VISA_LABEL, matchCompanyId } from '../../../lib/site';
const l = (p: string) => href('ja', p);
const brands = [...new Set(stories.map(s=>s.data.company))];
const companiesAll = (await getCollection('companies')).map(c => ({ id: c.id, name: c.data.name }));
const companyHref = new Map(stories.map(s => {
  const id = matchCompanyId(s.data.company, companiesAll);
  return [s.id, id ? l(`/companies/${id}`) : null];
}));
---
<Base title="先輩の声" lang="ja" altPaths={{ zh: '/stories/', ja: '/ja/stories/', en: '/en/stories/' }} description="ツナグを通じて日本で働く台湾人の先輩たち。どこで、何をして、何を学んだか。">
  <section class="page-head"><div class="wrap wrap--reading">
    <h1 class="d1">先輩たちは、いま日本に</h1>
    <p class="lead">
      先輩たちも、はじめは「日本に行ってみたい」という気持ちだけでした。{brands.length} ブランド、{stories.length} 名の体験談を掲載しています。ワーキングホリデー・留学・交換留学など、在留資格もさまざまです。
    </p>
    <div class="note">
      体験談はツナグの Instagram の投稿原文（中国語）のまま掲載し、各記事に原文リンクを付けています。
      {/* 內部待辦（勿放回畫面）：轉載是否需另取得本人同意，見 CLAUDE.md */}
    </div>
  </div></section>

  <nav class="wrap wrap--reading jump" aria-label="先輩の記事へジャンプ">
    {stories.map(s => (
      <a class="jump-chip" href={`#${s.id}`}>
        <span class="jump-ava"><SenpaiAvatar name={s.data.name} size={26} /></span>
        <span lang="ja">{s.data.name}</span>
      </a>
    ))}
  </nav>

  <section class="wrap wrap--reading list">
    {stories.map(s => (
      <article class="card item" id={s.id} tabindex="-1" aria-labelledby={`${s.id}-title`}>
        <header class="top">
          <div class="avatar"><SenpaiAvatar name={s.data.name} size={56} /></div>
          <div>
            <h2 class="d3" id={`${s.id}-title`} lang="ja">{s.data.name}</h2>
            <p class="meta small">
              <span class="tag">{VISA_LABEL.ja[s.data.visa] ?? s.data.visa}</span>
              <span>{s.data.started} 〜</span>
              <span class="pair"><span class="sep">·</span>{companyHref.get(s.id)
                ? <a class="co-link" href={companyHref.get(s.id)}><strong>{s.data.company}</strong></a>
                : <strong>{s.data.company}</strong>}</span>
              <span class="pair"><span class="sep">·</span><span>{s.data.location}</span></span>
            </p>
          </div>
        </header>

        <p class="lead-q" lang="zh-Hant">{s.data.lead}</p>

        {s.data.messages.length > 0 && (
          <ul class="msgs" lang="zh-Hant">{s.data.messages.map(m => <li>{m}</li>)}</ul>
        )}

        {s.data.advice.length > 0 && (
          <div class="advice">
            <h3>後輩へのアドバイス（原文）</h3>
            <ol lang="zh-Hant">{s.data.advice.map(a => <li>{a}</li>)}</ol>
          </div>
        )}

        <a class="src small" href={`https://www.instagram.com/p/${s.data.igCode}/`} target="_blank" rel="noopener">
          Instagram の原文を読む（{s.data.igPosted}）↗
        </a>
      </article>
    ))}
  </section>

  <section class="wrap wrap--reading cta">
    <div class="cta-band">
      <h2 class="d2">次はあなたの番</h2>
      <p class="lead">誰もが、一度の交流会から始まりました。</p>
      <a class="btn btn-primary" href={l('/events')}>交流会に申し込む</a>
    </div>
  </section>
</Base>
<script>
  const focusStoryTarget = () => {
    let id = '';
    try {
      id = decodeURIComponent(window.location.hash.slice(1));
    } catch {
      return;
    }
    const target = id ? document.getElementById(id) : null;
    if (!(target instanceof HTMLElement) || !target.classList.contains('item')) return;
    requestAnimationFrame(() => {
      target.scrollIntoView({ block:'start' });
      target.focus({ preventScroll:true });
    });
  };
  focusStoryTarget();
  window.addEventListener('hashchange', focusStoryTarget);
</script>
