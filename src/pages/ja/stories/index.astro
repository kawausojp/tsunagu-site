---
// 先輩の声（日本語版）。構成は繁中版と同じ（2026-10-25 網誌化改版）
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import NextEvent from '../../../components/NextEvent.astro';
import { buildFeed } from '../../../lib/site';
import '../../../styles/page-stories.css';
const stories = await getCollection('stories');
const items = buildFeed(stories, 'ja').filter(i => i.kind === 'story');
const brands = new Set(stories.map(s => s.data.company)).size;
---
<Base title="先輩の声" lang="ja" altPaths={{ zh: '/stories/', ja: '/ja/stories/' }} description="ツナグを通じて日本で働く台湾人の先輩たち。どこで、何をして、何を学んだか。Instagram の投稿を原文のまま掲載しています。">
  <section class="page-head"><div class="wrap wrap--page">
    <h1 class="d1">先輩の声</h1>
    <p class="lead"><span class="sent">先輩たちも、はじめは「日本に行ってみたい」という気持ちだけでした。</span><span class="sent">{stories.length}&nbsp;名・{brands}&nbsp;ブランドの体験談を掲載しています。</span></p>
    <div class="note"><span class="sent">ツナグ公式 Instagram の投稿を原文のまま掲載しています。日本語のメッセージは各投稿に添えられたものです。</span>
      {/* 內部待辦（勿放回畫面）：轉載是否需另取得本人同意，見 CLAUDE.md */}
    </div>
  </div></section>
  <section class="wrap wrap--page page-section st-list" aria-label="先輩の声の一覧">
    <PostList items={items} lang="ja" tabs={false} />
  </section>
  <section class="wrap wrap--page page-section"><NextEvent lang="ja" variant="mini" /></section>
  <script is:inline>
    (() => { const id = decodeURIComponent(location.hash.slice(1)); if (/^[\w-]+$/.test(id) && document.querySelector(`[data-story="${id}"]`)) location.replace(`./${id}/`); })();
  </script>
</Base>
