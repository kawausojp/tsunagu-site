---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CompanyCard from '../components/CompanyCard.astro';
import SenpaiAvatar from '../components/SenpaiAvatar.astro';
import { Image } from 'astro:assets';
import characters from '../assets/tsunagu-characters.png';
import videoThumb from '../assets/video-thumb.jpg';
import events from '../data/events.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const companies = (await getCollection('companies'))
  .sort((a, b) => b.data.placements - a.data.placements);
const featured = companies.slice(0, 6);
const stories = (await getCollection('stories')).sort((a,b)=>a.data.order-b.data.order).slice(0,3);

const VIDEO_ID = 'UmWq6sPcrJs'; // 內含 Tsunagu 訪談
const today = new Date().toISOString().slice(0, 10);
const nextEv = [...events.events].filter(e => e.date >= today).sort((a,b)=>a.date.localeCompare(b.date))[0];
const WD = ['日','一','二','三','四','五','六'];
const heroCta = nextEv
  ? `報名 ${Number(nextEv.date.slice(5,7))}/${Number(nextEv.date.slice(8,10))}（${WD[new Date(nextEv.date+'T00:00:00+08:00').getDay()]}）${nextEv.city}交流會 →`
  : '報名下一場交流會 →';
const nextEvDate = nextEv
  ? `${Number(nextEv.date.slice(5,7))}/${Number(nextEv.date.slice(8,10))}（${WD[new Date(nextEv.date+'T00:00:00+08:00').getDay()]}）`
  : '';
const stats = [
  { n: '2,874', u: '人', t: '參加過交流會' },
  { n: '149',   u: '人', t: '正在日本工作' },
  { n: String(events.totalHeld), u: '場', t: '已舉辦的交流會' },
  { n: '0',     u: '元', t: '參加者全程免費' },
];
---
<Base title="把台灣的好人才，牽到日本">

  <!-- HERO -->
  <section class="hero">
    <div class="wrap inner">
      <div class="copy">
        <p class="eyebrow">台湾人と日本企業をツナグ</p>
        <h1 class="d1">把台灣的好人才<br/>牽到日本</h1>
        <p class="lead">
          想去日本留學或打工度假，卻不知道能找到什麼樣的工作？
          我們把想跟台灣人一起工作的日本企業，直接帶到你面前。
          <strong>從履歷、面試到抵達日本之後，全程免費。</strong>
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={`${base}/events`}>{heroCta}</a>
          <a class="btn btn-secondary text-action" href={`${base}/companies`}>先看看有哪些企業 →</a>
        </div>
      </div>
      <div class="art" data-carousel>
        <div class="slide on">
          <Image src={characters} alt="Tsunagu 的兩隻角色：穿著 JP 藍色上衣的狗，和穿著 TW 粉色上衣的貓，牽著手坐在一起"
                 widths={[380, 560, 699]} sizes="(max-width: 860px) 60vw, 380px" loading="eager" class="chars" />
        </div>
        {nextEv && (
          <a class="slide bcard pink" href={`${base}/events`}>
            <span class="b-eyebrow">Next Event</span>
            <strong class="b-title">第 {nextEv.no} 回交流會</strong>
            <span class="b-big">{nextEvDate}</span>
            <span class="b-sub">{nextEv.city}・報名受付中 →</span>
          </a>
        )}
        <a class="slide bcard sky" href={`${base}/stories`}>
          <span class="b-eyebrow">Senpai</span>
          <strong class="b-title">149 位前輩</strong>
          <span class="b-big">在日本工作中</span>
          <span class="b-sub">看他們的第一手分享 →</span>
        </a>
        <div class="dots" role="tablist" aria-label="輪播切換"></div>
      </div>
    </div>
  </section>

  <!-- NEWS（お知らせ式公告列）＋ 快速入口 -->
  <div class="wrap">
    {nextEv && (
      <a class="news" href={`${base}/events`}>
        <span class="news-tag">お知らせ</span>
        <span class="news-txt">第 {nextEv.no} 回交流會　{nextEvDate}{nextEv.city}・報名受付中</span>
        <span class="news-arrow" aria-hidden="true">→</span>
      </a>
    )}
    <nav class="quick" aria-label="快速入口">
      <a class="q q-pink" href={`${base}/events`}><span class="q-dot"></span>報名交流會</a>
      <a class="q q-sky" href={`${base}/companies`}><span class="q-dot"></span>合作企業</a>
      <a class="q q-note" href={`${base}/stories`}><span class="q-dot"></span>學長姐經驗</a>
      <a class="q q-greige" href={`${base}/support`}><span class="q-dot"></span>我們怎麼幫你</a>
    </nav>
  </div>

  <!-- STATS -->
  <div class="wrap"><div class="band">
    {stats.map(s => (
      <div><div class="n">{s.n}<small>{s.u}</small></div><div class="t">{s.t}</div></div>
    ))}
  </div>
  </div>

  <!-- VIDEO -->
  <section class="section vid-sec">
    <div class="wrap">
      <p class="eyebrow">Watch</p>
      <h2 class="d2">先看看交流會現場</h2>
      <p class="lead">影片中有 Tsunagu 的訪談段落。</p>
      <div class="video" data-video={VIDEO_ID}>
        <button class="play" type="button" aria-label="播放 Tsunagu 交流會影片">
          <span class="tri"></span>
        </button>
        <Image src={videoThumb} alt="影片縮圖：新聞報導赴日打工度假的畫面" widths={[640, 1024, 1280]}
          sizes="(max-width: 900px) 100vw, 1024px" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- COMPANIES -->
  <section class="section alt">
    <div class="wrap">
      <p class="eyebrow">Companies</p>
      <h2 class="d2">等你來的日本企業</h2>
      <p class="lead">UNITED ARROWS、BEAMS、SHIPS、SAZABY LEAGUE、きものやまと⋯⋯這些不會在中文求職網站上出現的店，我們直接幫你牽線。</p>
      <div class="grid3 grid-co">
        {featured.map(c => <CompanyCard c={c} href={`${base}/companies/${c.id}`} />)}
      </div>
      <div class="more"><a class="btn btn-secondary text-action" href={`${base}/companies`}>看全部 {companies.length} 個品牌 →</a></div>
    </div>
  </section>

  <!-- STORIES -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Stories</p>
      <h2 class="d2">學長姐現在在日本做什麼</h2>
      <p class="lead">14 位前輩的第一手分享，涵蓋 DIANA、agete、VASIC、ANAYI、Manhattan Portage 等品牌。</p>
      <div class="grid3 rail">
        {stories.map(s => (
          <a class="card card-link senpai" href={`${base}/stories#${s.id}`}>
            <div class="row">
              <div class="avatar"><SenpaiAvatar name={s.data.name} size={56} /></div>
              <div>
                <h3 class="d3" lang="ja">{s.data.name}</h3>
                <p class="small meta">{s.data.visa}　{s.data.company}<br/>{s.data.location}</p>
              </div>
            </div>
            <p class="quote">{s.data.lead}</p>
          </a>
        ))}
      </div>
      <div class="more"><a class="btn btn-secondary text-action" href={`${base}/stories`}>看更多經驗分享 →</a></div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section final">
    <div class="wrap">
      <h2 class="d2">下一步，先來交流會看看</h2>
      <p class="lead">不用先決定什麼，也不用準備履歷。先來聽日本企業說他們在找什麼樣的人。</p>
      <div class="cta-row">
        <a class="btn btn-primary text-action text-action-primary" href={`${base}/events`}>查看下一場交流會 →</a>
        <a class="btn btn-ghost text-action" href={`${base}/apply`}>已經決定要去日本了 →</a>
      </div>
    </div>
  </section>

</Base>

<style>
  .hero{background:linear-gradient(165deg,var(--pink-50) 0%,var(--cream) 46%,var(--sky-50) 100%);
    padding:80px 0 72px;border-bottom:1px solid var(--line)}
  .inner{display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center}
  @media (max-width:860px){ .inner{grid-template-columns:1fr;gap:20px} .art :global(.chars){width:min(300px,70%)} }
  .copy h1{margin-bottom:20px}
  /* 進場：copy 內依序上浮、角色與標題同拍淡入。backwards 讓 reduced-motion 下直接顯示成品 */
  .copy>*{animation:hero-rise .28s var(--ease) backwards}
  .copy>*:nth-child(2){animation-delay:90ms}
  .copy>*:nth-child(3){animation-delay:180ms}
  .copy>*:nth-child(4){animation-delay:270ms}
  .art{animation:hero-rise .28s var(--ease) 120ms backwards}
  @keyframes hero-rise{from{opacity:0;transform:translateY(14px)}}
  .cta-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
  .art{display:flex;align-items:center;justify-content:center;position:relative}
  /* hero 輪播：淡入淡出，桌面限定；手機只顯示角色（第一張） */
  .art .slide{opacity:0;transition:opacity .28s var(--ease);pointer-events:none}
  .art .slide.on{opacity:1;pointer-events:auto}
  .art .slide:not(:first-child){position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
  .bcard{flex-direction:column;gap:8px;text-decoration:none;text-align:center;
    width:min(340px,80%);aspect-ratio:4/3;border-radius:var(--r-xl);margin:auto;
    box-shadow:var(--sh-2)}
  .bcard.pink{background:linear-gradient(150deg,var(--pink-50),var(--pink-100))}
  .bcard.sky{background:linear-gradient(150deg,var(--sky-50),var(--sky-100))}
  .b-eyebrow{font-family:var(--f-latin);font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--pink-700)}
  .bcard.sky .b-eyebrow{color:var(--sky-700)}
  .b-title{font-family:var(--f-display);font-size:20px;color:var(--ink-900);letter-spacing:.05em}
  .b-big{font-family:var(--f-latin);font-weight:700;font-size:34px;color:var(--ink-900);line-height:1.2}
  .b-sub{font-size:13.5px;color:var(--ink-600)}
  .dots{position:absolute;bottom:-6px;left:0;right:0;display:flex;justify-content:center;gap:8px}
  .dots button{width:8px;height:8px;border-radius:var(--r-full);border:0;padding:0;cursor:pointer;
    background:var(--pink-200);transition:.2s var(--ease)}
  .dots button[aria-selected="true"]{background:var(--pink-700);transform:scale(1.25)}
  /* お知らせ公告列 */
  .news{display:flex;align-items:center;gap:12px;margin-top:26px;padding:12px 18px;
    background:var(--paper);border:1px solid var(--line);border-radius:var(--r-full);
    text-decoration:none;color:var(--ink-900);box-shadow:var(--sh-1);transition:box-shadow .28s var(--ease)}
  .news:hover{box-shadow:var(--sh-2)}
  .news-tag{flex:0 0 auto;font-size:12px;font-weight:700;letter-spacing:.08em;color:var(--pink-700);
    background:var(--pink-50);padding:5px 13px;border-radius:var(--r-full)}
  .news-txt{font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .news-arrow{margin-left:auto;color:var(--pink-700);font-weight:700}
  /* 彩色膠囊快速入口（JPTIP 式圓球＋膠囊） */
  .quick{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:14px}
  .q{display:flex;align-items:center;gap:10px;padding:12px 18px;border-radius:var(--r-full);
    border:1.5px solid var(--line);background:var(--paper);text-decoration:none;
    font-weight:700;font-size:14.5px;color:var(--ink-900);letter-spacing:.04em;
    transition:transform .2s var(--ease),box-shadow .2s var(--ease)}
  .q:hover{transform:translateY(-2px);box-shadow:var(--sh-2)}
  .q-dot{width:22px;height:22px;flex:0 0 22px;border-radius:var(--r-full)}
  .q-pink .q-dot{background:var(--pink-200)}   .q-pink{border-color:var(--pink-200)}
  .q-sky .q-dot{background:var(--sky-200)}     .q-sky{border-color:var(--sky-200)}
  .q-note .q-dot{background:var(--note-line)}  .q-note{border-color:var(--note-line)}
  .q-greige .q-dot{background:var(--greige-100)} .q-greige{border-color:var(--greige-100)}
  .art :global(.chars){width:min(380px,86%);height:auto;
    animation:float 4s ease-in-out infinite}
  @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}

  .band{background:linear-gradient(120deg,var(--pink-50),var(--sky-50));border-radius:var(--r-xl);
    padding:34px 28px;display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
    gap:22px;text-align:center;margin-top:40px}
  .band .n{font-family:var(--f-latin);font-weight:700;font-size:40px;line-height:1.1;color:var(--pink-700)}
  .band .n small{font-size:17px;margin-left:3px}
  .band .t{font-size:13px;color:var(--ink-600);margin-top:4px}

  .grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(258px,1fr));gap:18px;margin-top:28px}
  .more{margin-top:28px}
  .alt{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}

  .senpai{display:flex;flex-direction:column;gap:12px;padding:20px;text-decoration:none;color:inherit}
  .senpai .row{display:flex;gap:14px;align-items:center}
  .senpai .quote{font-size:13.5px;line-height:1.85;color:var(--ink-600);margin:0;
    padding-left:12px;border-left:2px solid var(--pink-200); /* impeccable-disable-next-line side-tab -- 引文標記，非卡片邊框 */
    display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .avatar{width:56px;height:56px;flex:0 0 56px;border-radius:var(--r-full);
    border:2.5px solid transparent;overflow:hidden;
    background:var(--paper) padding-box,
      linear-gradient(135deg,var(--pink-400),var(--sky-300)) border-box;
    display:flex;align-items:center;justify-content:center}
  .avatar :global(svg){width:100%;height:100%;display:block}
  .meta{margin:4px 0 0}

  .vid-sec .lead{margin-bottom:22px}
  .video{position:relative;aspect-ratio:16/9;border-radius:var(--r-lg);overflow:hidden;
    background:linear-gradient(135deg,var(--pink-100),var(--sky-100));box-shadow:var(--sh-3);margin-bottom:12px}
  .video:focus-within{box-shadow:0 0 0 3px var(--cream),0 0 0 6px var(--focus-ring),var(--sh-3)}
  /* iframe 由 JS 在執行時插入，不會帶上 Astro 的 scope 屬性，必須用 :global */
  .video img{width:100%;height:100%;object-fit:cover;display:block}
  /* iframe 由 JS 在執行時插入，不會帶上 Astro 的 scope 屬性，必須用 :global */
  .video :global(iframe){position:absolute;inset:0;width:100%;height:100%;border:0}
  .play{position:absolute;inset:0;margin:auto;width:78px;height:78px;border-radius:var(--r-full);
    border:0;background:var(--pink-700);cursor:pointer;z-index:2;display:flex;
    align-items:center;justify-content:center;box-shadow:var(--sh-2);transition:.22s var(--ease)}
  .play:hover{transform:scale(1.07);background:var(--pink-700)}
  .tri{width:0;height:0;border-left:20px solid #fff;border-top:13px solid transparent;
    border-bottom:13px solid transparent;margin-left:5px}

  .final{background:linear-gradient(120deg,var(--sky-50),var(--pink-50));text-align:center}
  .final .lead{margin:0 auto}
  .final .cta-row{justify-content:center}

  @media (max-width:720px){
    .hero{background:#fff;padding:28px 0 30px;border-bottom:1px solid var(--mobile-line)}
    .inner{gap:12px}
    .copy h1{margin-bottom:16px}
    .cta-row{gap:10px;margin-top:20px}
    .hero .cta-row .btn-primary{width:100%}
    .hero .cta-row .text-action{align-self:flex-start}
    .art{margin-top:2px}
    .art :global(.chars){width:176px;animation:none}
    .band{grid-template-columns:repeat(2,minmax(0,1fr));gap:0;background:#fff;
      padding:0;margin-top:20px;border:1px solid var(--mobile-line);border-radius:12px;overflow:hidden}
    .band>div{display:flex;min-height:88px;flex-direction:column;align-items:center;justify-content:center;
      padding:14px 8px}
    .band>div:nth-child(odd){border-right:1px solid var(--mobile-line)}
    .band>div:nth-child(-n+2){border-bottom:1px solid var(--mobile-line)}
    .band .n{font-size:clamp(27px,8vw,31px)}
    .band .n small{font-size:14px}
    .band .t{font-size:12px;margin-top:5px}
    .grid3{gap:12px;margin-top:20px}
    .art .slide:not(:first-child),.dots{display:none}
    .news{margin-top:18px;padding:10px 14px}
    .news-txt{font-size:13px}
    .quick{grid-template-columns:repeat(2,1fr);gap:8px;margin-top:12px}
    .q{padding:11px 14px;font-size:13.5px}
    /* 企業卡兩格一列：IG 探索頁式的密度，滑動高度減半 */
    .grid-co{grid-template-columns:repeat(2,1fr);gap:10px}
    /* 學長姐改橫滑列：一次一排，佔位從三張卡縮成一張高 */
    .rail{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;
      -webkit-overflow-scrolling:touch;scrollbar-width:none;
      margin-inline:calc(-1*var(--layout-gutter));padding-inline:var(--layout-gutter);padding-bottom:6px}
    .rail::-webkit-scrollbar{display:none}
    .rail>*{flex:0 0 76%;scroll-snap-align:center}
    .more{margin-top:20px}
    .more .text-action{margin-left:2px}
    .alt{background:#FAFAFA;border-color:var(--mobile-line)}
    .senpai{gap:10px;padding:16px}
    .avatar{width:48px;height:48px;flex-basis:48px;font-size:18px}
    .video{border:1px solid var(--mobile-line);border-radius:12px;box-shadow:none}
    .play{width:56px;height:56px;box-shadow:none}
    .tri{border-left-width:16px;border-top-width:10px;border-bottom-width:10px} /* impeccable-disable-line side-tab -- 播放鈕三角形的 border 技法，非卡片邊框 */
    .final{background:var(--sky-50);border-top:1px solid var(--mobile-line)}
    .final .cta-row{flex-direction:column;align-items:center}
  }
</style>

<script>
  // hero 輪播：5s 自動輪替；reduced-motion 不自動播；hover/focus 暫停；手機（slide 隱藏時）不啟動
  const car = document.querySelector('[data-carousel]');
  if (car) {
    const slides = [...car.querySelectorAll('.slide')];
    const dotsBox = car.querySelector('.dots');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobile = () => getComputedStyle(slides[1] ?? slides[0]).display === 'none';
    if (slides.length > 1 && !mobile()) {
      let cur = 0, timer: ReturnType<typeof setInterval> | null = null;
      const dots = slides.map((_, i) => {
        const b = document.createElement('button');
        b.setAttribute('role','tab');
        b.setAttribute('aria-label',`第 ${i+1} 張`);
        b.addEventListener('click', () => { go(i); stop(); });
        dotsBox?.appendChild(b);
        return b;
      });
      const go = (i: number) => {
        slides[cur].classList.remove('on'); dots[cur].setAttribute('aria-selected','false');
        cur = i;
        slides[cur].classList.add('on'); dots[cur].setAttribute('aria-selected','true');
      };
      const stop = () => { if (timer) { clearInterval(timer); timer = null; } };
      go(0);
      if (!reduced) {
        timer = setInterval(() => go((cur+1)%slides.length), 5000);
        car.addEventListener('mouseenter', stop);
        car.addEventListener('focusin', stop);
      }
    }
  }
  document.querySelectorAll('.video').forEach(v => {
    v.querySelector('.play')?.addEventListener('click', () => {
      const id = (v as HTMLElement).dataset.video;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = 'Tsunagu 交流會影片';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.tabIndex = 0;
      v.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
