---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import CompanyCard from '../components/CompanyCard.astro';
import SenpaiAvatar from '../components/SenpaiAvatar.astro';
import { Image } from 'astro:assets';
import characters from '../assets/tsunagu-characters.png';
import { VIDEO_ID, nextEvent, fmtEventDate, totalHeld } from '../lib/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const companies = (await getCollection('companies'))
  .sort((a, b) => b.data.placements - a.data.placements);
const featured = companies.slice(0, 6);
const stories = (await getCollection('stories')).sort((a,b)=>a.data.order-b.data.order);
const firstStory = stories[0];

const nextEv = nextEvent();
const nextEvDate = nextEv ? fmtEventDate(nextEv.date, 'zh') : '';
const heroCta = nextEv
  ? `報名 ${nextEvDate}${nextEv.city}交流會 →`
  : '報名下一場交流會 →';
const stats = [
  { n: '2,874', u: '人', t: '參加過交流會' },
  { n: '163',   u: '人', t: '找到日本工作' },
  { n: String(totalHeld), u: '場', t: '已舉辦的交流會' },
  { n: String(companies.length), u: '個', t: '合作品牌' },
];
---
<Base title="把台灣的好人才，牽到日本" altPaths={{ zh: '/', ja: '/ja/', en: '/en/' }}
  description={`想去日本打工度假或留學？Tsunagu 免費媒合台灣人與日本企業：交流會、履歷面試輔導、抵日後追蹤，${companies.length} 個合作品牌。`}>

  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="ja-sub" lang="ja">台湾人と日本企業をツナグ</p>
      <h1 class="d1"><span class="headline-part">把台灣的好人才</span><span class="headline-comma">，</span><span class="headline-part">牽到日本</span></h1>
      <Image src={characters}
        alt="Tsunagu 的兩隻角色：穿著 JP 藍色上衣的狗，和穿著 TW 粉色上衣的貓，牽著手坐在一起"
        widths={[240, 480]} sizes="(max-width: 720px) 152px, 200px" loading="eager" class="chars" />
      <p class="lead">
        想去日本留學或打工度假，卻不知道能找到什麼樣的工作？
        我們介紹的是真心想跟台灣人一起工作的日本企業。
        <strong>從履歷、面試到抵達日本之後，全程免費。</strong>
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={`${base}/events`}>{heroCta}</a>
        <a class="action-link" href={`${base}/companies`}>先看看有哪些企業 →</a>
      </div>
    </div>
  </section>

  <!-- NEWS：有下一場時 hero CTA 已載明場次（公告列與其重複，2026-08-27 定案改為僅無場次時出現） -->
  {!nextEv && (
    <div class="wrap">
      <a class="news" href="https://www.instagram.com/tw.tsunagu.jp/" target="_blank" rel="noopener">
        <span class="news-tag" lang="ja">お知らせ</span>
        <span class="news-txt">下一場交流會尚未公布，追蹤 Instagram 接收場次通知 <span aria-hidden="true">↗</span></span>
      </a>
    </div>
  )}

  <!-- STATS -->
  <div class="wrap"><div class="band">
    {stats.map(s => (
      <div><div class="n">{s.n}<small>{s.u}</small></div><div class="t">{s.t}</div></div>
    ))}
  </div>
  </div>


  <!-- COMPANIES -->
  <section class="section alt">
    <div class="wrap co-split">
      <div class="co-side">
        <h2 class="d2">等你來的日本企業</h2>
        <p class="lead">這些不會在中文求職網站上出現的店，我們直接幫你牽線。以下是任職人數最多的六家。</p>
        <a class="action-link" href={`${base}/companies`}>看全部 {companies.length} 個合作品牌 →</a>
      </div>
      <div class="grid3 grid-co">
        {featured.map(c => <CompanyCard c={c} href={`${base}/companies/${c.id}`} />)}
      </div>
    </div>
  </section>

  <!-- STORIES -->
  <section class="section">
    <div class="wrap">
      <h2 class="d2">學長姐現在在日本做什麼</h2>
      <div class="voice">
        <div class="v-avatar"><SenpaiAvatar name={firstStory.data.name} size={96} /></div>
        <div>
          <blockquote class="v-quote" lang="zh-Hant">{firstStory.data.lead}</blockquote>
          <p class="small v-meta">
            <span lang="ja">{firstStory.data.name}</span>　{firstStory.data.visa}・{firstStory.data.company}（{firstStory.data.location}）
          </p>
        </div>
      </div>
      <div class="more"><a class="action-link" href={`${base}/stories`}>看 {stories.length} 位學長姐的第一手分享 →</a></div>
    </div>
  </section>

  <!-- VIDEO -->
  <section class="section vid-sec">
    <div class="wrap">
      <h2 class="d2">先看看交流會現場</h2>
      <p class="lead">影片中有 Tsunagu 的訪談段落。</p>
      <div class="video">
        <iframe src={`https://www.youtube-nocookie.com/embed/${VIDEO_ID}`}
          title="公視晚間新聞：每年開放台灣 1 萬打工度假名額（內含 Tsunagu 訪談）"
          loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture"
          allowfullscreen></iframe>
      </div>
      <p class="small vid-more"><a href={`https://www.youtube.com/watch?v=${VIDEO_ID}`} target="_blank" rel="noopener">在 YouTube 上觀看 ↗</a></p>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section final">
    <div class="wrap final-split">
      <div>
        <h2 class="d2">下一步，先來交流會看看</h2>
        <p class="lead">不用先決定什麼，也不用準備履歷。先來聽日本企業說他們在找什麼樣的人。</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={`${base}/events`}>查看下一場交流會 →</a>
          <a class="action-link" href={`${base}/apply`}>已經決定要去日本了 →</a>
        </div>
      </div>
      <Image src={characters} alt="" aria-hidden="true" widths={[200, 400]} sizes="200px" loading="lazy" class="final-chars" />
    </div>
  </section>

</Base>
