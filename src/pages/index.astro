---
// 首頁（2026-10-25 網誌化改版）：使用者指定維持線上版的角色 hero，順序 hero → 統計泡泡 → 報名資訊 → 文章列表 → 新聞影片。
// 拿掉：合作企業區（主辦方：品牌專區先不要做）、焦點引言（併入文章列表）、結尾報名區（與報名資訊重複）。
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import StatIcon from '../components/StatIcon.astro';
import Heart from '../components/Heart.astro';
import NextEvent from '../components/NextEvent.astro';
import PostList from '../components/PostList.astro';
import { Image } from 'astro:assets';
import characters from '../assets/tsunagu-characters.png';
import { VIDEO_ID, VIDEO_START, signupCta, HOME_STATS, CONTRACTED_COMPANIES, buildFeed } from '../lib/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const feed = buildFeed(await getCollection('stories'), 'zh');
const heroCta = signupCta('zh');
// 統計泡泡（2026.10.18 簡報 p185／p175）。177 寫「活躍中」不寫累計（使用者 2026-10-24）
const stats = [
  { icon: 'job', n: HOME_STATS.active, u: '人', t: '在日本活躍中' },
  { icon: 'rise', n: HOME_STATS.fulltime, u: '人', t: '轉為正職' },
  { icon: 'people', n: HOME_STATS.attendees, u: '人', t: '參加過交流會' },
  { icon: 'brand', n: String(CONTRACTED_COMPANIES), u: '家', t: '簽約企業' },
];
---
<Base title="把台灣的好人才，牽到日本" altPaths={{ zh: '/', ja: '/ja/' }}
  description="想去日本打工度假或留學？Tsunagu 免費媒合台灣人與日本企業：交流會、履歷面試輔導、抵日後追蹤。在日本工作的台灣前輩分享，全文刊載。">

  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="ja-sub" lang="ja">台湾人と日本企業をツナグ</p>
      <h1 class="d1"><span class="headline-part">把台灣的好人才</span><span class="headline-comma">，</span><span class="headline-part">牽到日本</span></h1>
      <!-- 招牌時刻「ツナグ」（2026-10-04）：同一張圖切成左右兩半（狗／貓），進場時從兩側靠近、碰拳，愛心彈出。
           兩個 <Image> 的 srcset 相同，瀏覽器只下載一次；整組以 role="img" 對讀屏報讀一次 -->
      <div class="chars" role="img" aria-label="Tsunagu 的兩隻角色：穿著 JP 藍色上衣的狗，和穿著 TW 粉色上衣的貓，牽著手坐在一起">
        <Image src={characters} alt="" widths={[240, 480]} sizes="(max-width: 720px) 168px, 240px" loading="eager" fetchpriority="high" class="chars-half chars-l" />
        <Image src={characters} alt="" widths={[240, 480]} sizes="(max-width: 720px) 168px, 240px" loading="eager" class="chars-half chars-r" />
        <Heart size={20} class="chars-heart" />
        <Heart size={20} class="chars-heart chars-heart--cta" />
      </div>
      <!-- 一句一行（使用者 2026-09-26）：句子在標點處斷行，不在句中被版寬切斷 -->
      <p class="lead">
        <span class="sent">想去日本留學或打工度假，卻不知道能找到什麼樣的工作？</span>
        <span class="sent">我們介紹的是真心想跟台灣人<wbr />一起工作的日本企業。</span>
        <strong class="sent">從履歷、面試到抵達日本之後，全程免費。</strong>
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={`${base}/events`}>{heroCta}</a>
        <a class="action-link" href={`${base}/stories`}>先看看前輩怎麼說</a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <!-- 統計：四個泡泡（使用者 2026-09-13 定案） -->
  <div class="wrap"><div class="band">
    {stats.map(s => (
      <div class="stat"><div class="bubble"><div class="t"><StatIcon k={s.icon} size={20} /><span class="lbl">{s.t}</span></div><div class="n" data-count={s.n} aria-hidden="true">{s.n}<small>{s.u}</small></div></div><span class="sr-only">{s.n}{s.u}</span></div>
    ))}
  </div>
  </div>


  <!-- 報名資訊（2026-10-25）：下一場的日期、場次、地點；沒有下一場時導向 IG -->
  <section class="section nx-sec"><div class="wrap wrap--page"><NextEvent lang="zh" /></div></section>

  <!-- 文章列表：前輩分享＋交流會紀錄＋媒體報導，日期新→舊 -->
  <section class="section feed-sec" aria-labelledby="feed-h">
    <div class="wrap wrap--page">
      <h2 class="d2" id="feed-h">最新文章</h2>
      <PostList items={feed} lang="zh" initial={12} defaultCat="story" />
    </div>
  </section>

  <!-- VIDEO -->
  <section class="section vid-sec t-center">
    <div class="wrap">
      <h2 class="d2">新聞裡的 Tsunagu</h2>
      <p class="lead"><span class="sent">公視晚間新聞：透過 Tsunagu 到日本打工度假的經驗分享（從 Tsunagu 的段落開始播放）。</span></p>
      <!-- 直接嵌入（2026-08-28 使用者指定：不做點擊門面，從 VIDEO_START 秒開始）。 -->
      <div class="video">
        <iframe src={`https://www.youtube-nocookie.com/embed/${VIDEO_ID}?start=${VIDEO_START}`}
          title="公視晚間新聞：每年開放台灣 1 萬打工度假名額（內含 Tsunagu 訪談）"
          loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture"
          allowfullscreen></iframe>
      </div>
      <p class="small vid-more"><a href={`https://www.youtube.com/watch?v=${VIDEO_ID}`} target="_blank" rel="noopener">在 YouTube 上觀看 <span aria-hidden="true">↗</span><span class="sr-only">（另開新視窗）</span></a></p>
      <a class="action-link" href={`${base}/about#media`}>更多媒體報導</a>
    </div>
  </section>

</Base>

<script>
  import "../scripts/motion";
</script>
