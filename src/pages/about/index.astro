---
import Base from '../../layouts/Base.astro';
import '../../styles/page-about.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// 連結原則（CLAUDE.md 紅線 #3）：只外連報社原文，不貼報紙掃描圖。
// 繊研 2025 兩篇與日經 2024.10.07 經查無線上版（senken.co.jp 404 實測），標紙面刊載。
const media = [
  { name:'日本經濟新聞 朝刊', date:'2024.10.07', note:'報導 kimono やまと 的 Haru', print:true },
  { name:'繊研新聞', date:'2026.01.28', url:'https://senken.co.jp/posts/bp-260128' },
  { name:'繊研新聞', date:'2025.07.17', print:true },
  { name:'繊研新聞', date:'2025.02.12', print:true },
  { name:'Yahoo! ニュース', date:'2024.08.07' },
  { name:'台北經濟新聞', date:'2023.06.06', url:'https://taipei.keizai.biz/headline/418/' },
];
---
<Base title="關於 Tsunagu" altPaths={{ zh: '/about/', ja: '/ja/about/', en: '/en/about/' }} description="Tsunagu 是誰、為什麼做這件事。">
  <section class="page-head"><div class="wrap wrap--reading">
    <h1 class="d1">為什麼做這件事</h1>
  </div></section>

  <section class="wrap wrap--reading page-section">
    <div class="prose">
      <p>我們做「把日本的好商品、品牌與文化帶給台灣客人」這件事，做了八年。</p>
      <p>過程中發現，台灣有非常多人喜歡日本，想去日本學習、想在日本工作。光是觀光，
        每個月就有 55～62 萬台灣人去日本，2025 年一整年是 676 萬人次。</p>
      <p>另一邊，日本正處在嚴重的人才不足。疫情結束加上日圓貶值，外國觀光客大量湧入，
        卻沒有足夠能接待他們的人。服飾業與餐飲業尤其嚴重。</p>
      <p><strong>所以我們想做的是：把台灣的好人才，牽到日本。</strong>
        不只是找到工作，而是找到真心想跟台灣人一起工作的日本企業。</p>
    </div>
  </section>

  <section class="wrap wrap--reading page-section">
    <h2 class="d2">我們是誰</h2>
    <div class="grid">
      <div class="card b">
        <h3 class="d3" lang="ja">株式会社ブレーンアンドパートナー</h3>
        <p class="small">1980 年創業於日本，商業設施顧問公司。參與營運擁有 1,000 家日本企業的「日本購物中心協會」。</p>
      </div>
      <div class="card b">
        <h3 class="d3">智囊和夥伴有限公司</h3>
        <p class="small">Brain &amp; Partner Taiwan Inc.，2018 年創立，連結日本與台灣。
          2019 年擔任台北微風南山 atre 開業顧問，營運與策劃超過 10 個店舖。</p>
      </div>
    </div>
    <p class="small">曾操盤：BLUE BOTTLE COFFEE、JAPAN RAIL CAFE、MAISON DE REEFUR、ささら屋、きものやまと、
      世界最濃抹茶冰淇淋「ななや」等。自營店舖 bpt ROOM（台北微風南山 2F，2019–2025.9）、
      紫苑花屋（桃園馬祖新村眷村文創園區）。</p>
  </section>

  <section class="wrap wrap--reading page-section">
    <h2 class="d2">媒體報導</h2>
    <ul class="media">
      {media.map(m => (
        <li class="card m">
          <span class="d">{m.date}</span>
          {m.url
            ? <a class="n m-link" href={m.url} target="_blank" rel="noopener">{m.name} ↗</a>
            : <span class="n">{m.name}</span>}
          {m.note && <span class="small note-t">{m.note}</span>}
          {m.print && <span class="small note-t">紙面刊載</span>}
        </li>
      ))}
    </ul>
    {/* 內部待辦（勿放回畫面）：各則報導的原文連結（標題＋日期＋外連，不貼截圖），見 CLAUDE.md */}
  </section>

  <section class="wrap wrap--reading page-section">
    <div class="cta-row">
      <a class="btn btn-primary" href={`${base}/events`}>來交流會見見我們 →</a>
      <a class="action-link" href={`${base}/stories`}>看學長姐的經驗 →</a>
    </div>
  </section>
</Base>
