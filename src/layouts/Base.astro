---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import { LANG_META, ui, type Lang } from '../i18n/ui';
interface Props { title: string; description?: string; noindex?: boolean; lang?: Lang; altPaths?: Partial<Record<Lang, string>>; }
const { title, description = '把台灣的好人才牽到日本。免費的日本留學・打工度假就職媒合交流會，台北、台中、高雄、東京、大阪舉辦。', noindex = false, lang = 'zh', altPaths } = Astro.props;
const OG_LOCALE: Record<Lang, string> = { zh: 'zh_TW', ja: 'ja_JP', en: 'en_US' };
const pageTitle = `${title}｜ツナグ Tsunagu`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}/img/og-default.png`, Astro.site);
---
<!DOCTYPE html>
<html lang={LANG_META[lang].htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="ツナグ Tsunagu" />
  <meta property="og:locale" content={OG_LOCALE[lang]} />
  {!noindex && <meta property="og:url" content={canonicalUrl} />}
  <meta name="theme-color" content="#FFF6F9" />
  <link rel="icon" href={`${base}/img/favicon-32.png`} sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/img/icon-180.png`} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Tsunagu－把台灣的好人才，牽到日本" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  {!noindex && <link rel="canonical" href={canonicalUrl} />}
  {!noindex && !altPaths && <link rel="alternate" hreflang={LANG_META[lang].htmlLang} href={canonicalUrl} />}
  {!noindex && altPaths && Object.entries(altPaths).map(([l, p]) => (
    <link rel="alternate" hreflang={LANG_META[l as Lang].htmlLang} href={new URL(`${base}${p}`, Astro.site)} />
  ))}
  {!noindex && altPaths?.zh && <link rel="alternate" hreflang="x-default" href={new URL(`${base}${altPaths.zh}`, Astro.site)} />}
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ツナグ Tsunagu',
    alternateName: '台湾人と日本企業をツナグ',
    legalName: '智囊和夥伴有限公司（Brain & Partner Taiwan Inc.）',
    url: Astro.site?.toString(),
    logo: new URL(`${base}/img/icon-512.png`, Astro.site).toString(),
    sameAs: [
      'https://www.instagram.com/tw.tsunagu.jp/',
      'https://www.threads.com/@tw.tsunagu.jp',
    ],
  })} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=BIZ+UDPGothic:wght@400;700&family=Jost:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <a href="#main" class="skip">{ui[lang].skip}</a>
  <Header lang={lang} />
  <main id="main" tabindex="-1"><slot /></main>
  <Footer lang={lang} />
  <style>
    .skip{position:absolute;left:-9999px;top:0;background:var(--pink-700);color:#fff;
      padding:10px 18px;border-radius:0 0 var(--r-sm) 0;z-index:100;font-weight:700}
    .skip:focus{left:0}
  </style>
</body>
</html>
