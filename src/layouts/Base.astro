---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title: string; description?: string; }
const { title, description = '台灣人與日本企業をツナグ — 免費的日本留學・打工度假就職媒合交流會。' } = Astro.props;
const pageTitle = `${title}｜ツナグ Tsunagu`;
---
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#FF6699" />
  <link rel="icon" href={`${import.meta.env.BASE_URL}img/favicon-32.png`} sizes="32x32" />
  <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}img/icon-180.png`} />
  <meta property="og:image" content={new URL(`${import.meta.env.BASE_URL}img/og-default.png`, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="alternate" hreflang="zh-Hant" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=BIZ+UDPGothic:wght@400;700&family=Jost:wght@400;500;600&family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <a href="#main" class="skip">跳到主要內容</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <style>
    .skip{position:absolute;left:-9999px;top:0;background:var(--pink-700);color:#fff;
      padding:10px 18px;border-radius:0 0 var(--r-sm) 0;z-index:100;font-weight:700}
    .skip:focus{left:0}
  </style>
</body>
</html>
